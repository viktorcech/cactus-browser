   129 				; ----------------------------------------------------------------------------
   130 				; vbxe_emit - Write X chars from print_buf at the cursor (attr zp_cur_attr),
   131 				; advancing and wrapping the cursor exactly like X calls of vbxe_putchar,
   132 				; but inside one MEMAC B session. X = 1..128. MEMAC B must be on.
   133 				; ----------------------------------------------------------------------------
   134 332B			.proc vbxe_emit
   135 332B 8E 89 33		        stx ?cnt
   136 332E A5 84		        lda zp_cur_attr
   137 3330 8D 46 33		        sta ?attr+1
   138 3333 A2 00		        ldx #0
   139 3335 A9 50		?run    lda #SCR_COLS
   140 3337 38			        sec
   141 3338 E5 83		        sbc zp_cursor_col      ; cells left on this row (1..80)
   142 333A 8D 8A 33		        sta ?room
   143 333D A0 00		        ldy #0
   144 333F BD 00 82		?lp     lda print_buf,x
   145 3342 91 85		        sta (zp_scr_ptr),y
   146 3344 C8			        iny
   147 3345 A9 00		?attr   lda #0
   148 3347 91 85		        sta (zp_scr_ptr),y
   149 3349 C8			        iny
   150 334A E8			        inx
   151 334B CE 8A 33		        dec ?room
   152 334E F0 16		        beq ?eol
   153 3350 EC 89 33		        cpx ?cnt
   154 3353 D0 EA		        bne ?lp
   155 				        ert >?lp <> >*         ; hot loop: keep it in one page
   156 				        ; fall into ?adv, then return
   157
   158 3355 98			?adv    tya                    ; ptr += Y, col += Y/2 (Y <= 160)
   159 3356 18			        clc
   160 3357 65 85		        adc zp_scr_ptr
   161 3359 85 85		        sta zp_scr_ptr
   162 335B 90 02		        bcc ?n
   163 335D E6 86		        inc zp_scr_ptr+1
   164 335F 98			?n      tya
   165 3360 4A			        lsr
   166 3361 65 83		        adc zp_cursor_col      ; C = 0 (Y even)
   167 3363 85 83		        sta zp_cursor_col
   168 3365 60			        rts
   169
   170 3366 20 55 33		?eol    jsr ?adv               ; row filled: wrap like putchar
   171 3369 A9 00		        lda #0
   172 336B 85 83		        sta zp_cursor_col
   173 336D E6 82		        inc zp_cursor_row
   174 336F A5 82		        lda zp_cursor_row
   175 3371 C9 1D		        cmp #SCR_ROWS
   176 3373 90 05		        bcc ?rc
   177 3375 C6 82		        dec zp_cursor_row
   178 3377 20 AF 34		        jsr vbxe_scroll_up
   179 337A 8E 8B 33		?rc     stx ?x
   180 337D 20 D1 32		        jsr calc_scr_ptr
   181 3380 AE 8B 33		        ldx ?x
   182 3383 EC 89 33		        cpx ?cnt
   183 3386 D0 AD		        bne ?run
   184 3388 60			        rts
   185
   186 3389 00			?cnt    dta 0
   187 338A 00			?room   dta 0
   188 338B 00			?x      dta 0
   189 				.endp
