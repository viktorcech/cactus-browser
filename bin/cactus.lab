   303
   304 66E0 A9 28		        lda #IMG_MAX_RETRIES
   305 66E2 8D 17 65		        sta img_timeout
   306 66E5 AD 2E 67		        lda img_left           ; left -= chunk
   307 66E8 38			        sec
