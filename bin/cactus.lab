    28 				; ----------------------------------------------------------------------------
    29 				; kbd_init - Open K: device on IOCB #1 for raw keyboard input
    30 				; Must be called once during init
    31 				; ----------------------------------------------------------------------------
    32 5FAF			.proc kbd_init
    33 5FAF-7904> A2 10		        ldx #KIOCB
    34 5FB1 A9 03		        lda #CIO_OPEN
    35 5FB3 9D 42 03		        sta ICCOM,x
    36 5FB6 A9 04		        lda #4                 ; Read mode
    37 5FB8 9D 4A 03		        sta ICAX1,x
    38 5FBB A9 00		        lda #0
    39 5FBD 9D 4B 03		        sta ICAX2,x
    40 5FC0 A9 CD		        lda #<kdev_name
    41 5FC2 9D 44 03		        sta ICBAL,x
    42 5FC5 A9 5F		        lda #>kdev_name
    43 5FC7 9D 45 03		        sta ICBAH,x
    44 5FCA 4C 56 E4		        jmp CIOV
    45
    46 5FCD 4B 3A 9B		kdev_name dta c'K:',$9B
    47 				.endp
    48
    49 				; ----------------------------------------------------------------------------
    50 				; kbd_get - Get one character from keyboard (blocking)
    51 				; Output: A = ATASCII character code
    52 				; Uses CIO K: device - proper OS translation of all keys
    53 				; ----------------------------------------------------------------------------
    54 5FD0			.proc kbd_get
    55 5FD0 A2 10		        ldx #KIOCB
    56 5FD2 A9 07		        lda #CIO_GET
    57 5FD4 9D 42 03		        sta ICCOM,x
    58 5FD7 A9 00		        lda #0
    59 5FD9 9D 48 03		        sta ICBLL,x
    60 5FDC 9D 49 03		        sta ICBLH,x
    61 5FDF 4C 56 E4		        jmp CIOV
    62 				        ; A = ATASCII character
    63 				.endp
