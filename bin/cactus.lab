   614 5600			.proc process_attr
   615 				        ; Check "href" attribute (for <a> tags)
   616 5600 AD AD 51		        lda attr_name_buf
   617 5603 C9 68		        cmp #'h'
   618 5605 D0 18		        bne ?chk_src
   619 5607 AD AE 51		        lda attr_name_buf+1
   620 560A C9 72		        cmp #'r'
   621 560C D0 11		        bne ?chk_src
   622 560E AD AF 51		        lda attr_name_buf+2
   623 5611 C9 65		        cmp #'e'
   624 5613 D0 0A		        bne ?chk_src
   625 5615 AD B0 51		        lda attr_name_buf+3
   626 5618 C9 66		        cmp #'f'
   627 561A D0 03 4C A1 56	        jeq store_link_url
   628
   629 561F			?chk_src
   630 561F			chk_src
   631 				        ; Check "src" attribute (for <img> tags)
   632 				        ; Must match exactly "src" (not "srcset" etc.)
   633 561F AD AD 51		        lda attr_name_buf
   634 5622 C9 73		        cmp #'s'
   635 5624 D0 16		        bne ?chk_id
   636 5626 AD AE 51		        lda attr_name_buf+1
   637 5629 C9 72		        cmp #'r'
   638 562B D0 0F		        bne ?chk_id
   639 562D AD AF 51		        lda attr_name_buf+2
   640 5630 C9 63		        cmp #'c'
   641 5632 D0 08		        bne ?chk_id
   642 5634 AD B0 51		        lda attr_name_buf+3
   643 5637 D0 03 4C BD 56	        jeq store_img_src      ; must be null (reject "srcset")
   644
   645 563C			?chk_id ; Check "id" attribute (for fragment anchors)
   646 563C AD 0B 50		        lda skip_to_frag
   647 563F F0 34		        beq ?done              ; not looking for fragment
   648 5641 AD AD 51		        lda attr_name_buf
   649 5644 C9 69		        cmp #'i'
   650 5646 D0 0C		        bne ?chk_name
   651 5648 AD AE 51		        lda attr_name_buf+1
   652 564B C9 64		        cmp #'d'
   653 564D D0 05		        bne ?chk_name
   654 564F AD AF 51		        lda attr_name_buf+2
   655 5652 F0 22		        jeq check_frag_match   ; must be exactly "id"
   656
   657 5654			?chk_name
   658 				        ; Check "name" attribute (for fragment anchors)
   659 5654 AD AD 51		        lda attr_name_buf
   660 5657 C9 6E		        cmp #'n'
   661 5659 D0 1A		        bne ?done
   662 565B AD AE 51		        lda attr_name_buf+1
   663 565E C9 61		        cmp #'a'
   664 5660 D0 13		        bne ?done
   665 5662 AD AF 51		        lda attr_name_buf+2
   666 5665 C9 6D		        cmp #'m'
   667 5667 D0 0C		        bne ?done
   668 5669 AD B0 51		        lda attr_name_buf+3
   669 566C C9 65		        cmp #'e'
   670 566E D0 05		        bne ?done
   671 5670 AD B1 51		        lda attr_name_buf+4
   672 5673 F0 01		        jeq check_frag_match   ; must be exactly "name"
   673
   674 5675 60			?done   rts
   675 				.endp
   676
   677 				; ============================================================================
   678 				; check_frag_match - Compare attr_val_buf against frag_buf
   679 				; If match: clear skip_to_frag (start rendering from here)
   680 				; ============================================================================
   681 5676			.proc check_frag_match
   682 5676 A0 00		        ldy #0
   683 5678 B9 0C 50		?cmp    lda frag_buf,y
   684 567B D9 BD 51		        cmp attr_val_buf,y
   685 567E D0 11		        bne ?done              ; mismatch
   686 5680 AA			        tax                    ; Z=1 if null terminator
   687 5681 F0 06		        beq ?match             ; both null → match!
   688 5683 C8			        iny
   689 5684 C0 1F		        cpy #FRAG_BUF_SZ-1
   690 5686 D0 F0		        bne ?cmp
   691 5688 60			        rts                    ; too long, no match
   692 5689 A9 00		?match  lda #0
   693 568B 8D 0B 50		        sta skip_to_frag       ; Fragment target found!
   694 568E 4C E2 4F		        jmp update_emit_skip
   695 5691 60			?done   rts
   696 				.endp
