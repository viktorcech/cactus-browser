   448 				; http_url_tolower - Convert DOMAIN part of url_buffer to lowercase
   449 				; Only lowercases up to first '/' after "://" (path is case-sensitive!)
   450 				; ----------------------------------------------------------------------------
   451 4927			.proc http_url_tolower
   452 4927 A0 00		        ldy #0
   453 				        ; Find "://" first
   454 4929 B9 02 90		?fs     lda url_buffer,y
   455 492C F0 33		        beq ?done
   456 492E C9 3A		        cmp #':'
   457 4930 D0 11		        bne ?fs_n
   458 4932 C8			        iny
   459 4933 B9 02 90		        lda url_buffer,y
   460 4936 C9 2F		        cmp #'/'
   461 4938 D0 09		        bne ?fs_n
   462 493A C8			        iny
   463 493B B9 02 90		        lda url_buffer,y
   464 493E C9 2F		        cmp #'/'
   465 4940 F0 05		        beq ?found
   466 4942 88			        dey
   467 4943 C8			?fs_n   iny
   468 4944 D0 E3		        bne ?fs
   469 4946 60			        rts                    ; no "://" found, don't touch
   470 4947 C8			?found  iny                    ; skip past "//"
   471 				        ; Lowercase until end of domain (next '/' or end)
   472 4948 B9 02 90		?lp     lda url_buffer,y
   473 494B F0 14		        beq ?done
   474 494D C9 2F		        cmp #'/'
   475 494F F0 10		        beq ?done              ; reached path, stop lowercasing
   476 				 .if 1                          ; 2026-09-23 (6502-idioms: to lower: the common lowercase byte (> 'Z') leaves on the
   477 				                                ; first compare, 5 cycles instead of 9; same result for every byte)
   478 4951 C9 5B		        cmp #'Z'+1
   479 4953 B0 09		        bcs ?next
   480 4955 C9 41		        cmp #'A'
   481 4957 90 05		        bcc ?next
   482 4959 09 20		        ora #$20
   483 				 .else
   484 				        cmp #'A'
   485 				        bcc ?next
   486 				        cmp #'Z'+1
   487 				        bcs ?next
   488 				        ora #$20
   489 				 .endif
   490 495B 99 02 90		        sta url_buffer,y
   491 495E C8			?next   iny
   492 495F D0 E7		        bne ?lp
   493 4961 60			?done   rts
   494 				.endp
   495
   496 				; ----------------------------------------------------------------------------
   497 				; nibble_to_hex - Convert low nibble (0-15) in A to ASCII hex char
   498 				; Input: A = 0-15. Output: A = '0'-'9' or 'A'-'F'
   499 				; Note: exploits carry from CMP: C=1 when A>=10, C=0 when A<10
   500 				; ----------------------------------------------------------------------------
   501 4962			.proc nibble_to_hex
   502 4962 C9 0A		        cmp #10
   503 4964 90 03		        bcc ?dig
   504 4966 69 36		        adc #'A'-11          ; C=1 from CMP, so adds 'A'-10
   505 4968 60			        rts
   506 4969 69 30		?dig    adc #'0'             ; C=0 from CMP, so adds '0'
   507 496B 60			        rts
   508 				.endp
   509
   510 				; ----------------------------------------------------------------------------
   511 				; byte_to_hex - A = byte -> A = high hex digit, X = low hex digit
   512 				; ----------------------------------------------------------------------------
   513 496C			.proc byte_to_hex
   514 496C 48			        pha
   515 496D 29 0F		        and #$0F
   516 496F 20 62 49		        jsr nibble_to_hex
   517 4972 AA			        tax
   518 4973 68			        pla
   519 4974 4A			        lsr
   520 4975 4A			        lsr
   521 4976 4A			        lsr
   522 4977 4A			        lsr
   523 4978 4C 62 49		        jmp nibble_to_hex
   524 				.endp
   525
   526 				; ----------------------------------------------------------------------------
   527 				; Proxy mode
   528 				; ----------------------------------------------------------------------------
   529 497B 00			use_proxy  dta b(0)           ; 0=direct, 1=proxy
   530
   531 				; ----------------------------------------------------------------------------
   532 				; http_apply_proxy - Wrap url_buffer with proxy prefix
   533 				; Only called when use_proxy=1. Strips N: and http:// from original URL,
   534 				; builds: N:https://turiecfoto.sk/cactus/proxy.php?url= + bare_url
   535 				; ----------------------------------------------------------------------------
   536 497C			.proc http_apply_proxy
   537 497C AD 7B 49		        lda use_proxy
   538 497F D0 01		        bne ?go
   539 4981 60			        rts
   540 4982			?go
   541 				        ; Skip if URL already points to our server (proxy or search)
   542 				        ; Check for "turiecfoto" substring in first 60 chars
   543 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero)
   544 4982 A0 C4		        ldy #256-60
   545 4984 B9 3E 8F		?chk    lda url_buffer+60-256,y
   546 4987 F0 1D		        beq ?ok                ; end of string, not found - proceed
   547 4989 C9 74		        cmp #'t'
   548 498B D0 16		        bne ?cn
   549 498D B9 3F 8F		        lda url_buffer+60-256+1,y
   550 4990 C9 75		        cmp #'u'
   551 4992 D0 0F		        bne ?cn
   552 4994 B9 40 8F		        lda url_buffer+60-256+2,y
   553 4997 C9 72		        cmp #'r'
   554 4999 D0 08		        bne ?cn
   555 499B B9 41 8F		        lda url_buffer+60-256+3,y
   556 499E C9 69		        cmp #'i'
   557 49A0 D0 01		        bne ?cn
   558 49A2 60			        rts                    ; "turi" found - our server, skip proxy
   559 49A3 C8			?cn     iny
   560 49A4 D0 DE		        bne ?chk
   561 				 .else
   562 				        ldy #0
   563 				?chk    lda url_buffer,y
   564 				        beq ?ok                ; end of string, not found - proceed
   565 				        cmp #'t'
   566 				        bne ?cn
   567 				        lda url_buffer+1,y
   568 				        cmp #'u'
   569 				        bne ?cn
   570 				        lda url_buffer+2,y
   571 				        cmp #'r'
   572 				        bne ?cn
   573 				        lda url_buffer+3,y
   574 				        cmp #'i'
   575 				        bne ?cn
   576 				        rts                    ; "turi" found - our server, skip proxy
   577 				?cn     iny
   578 				        cpy #60
   579 				        bne ?chk
   580 				 .endif
   581 49A6			?ok
   582 				        ; Find start of bare URL (skip N: and http://)
   583 49A6 A0 00		        ldy #0
   584 49A8 AD 02 90		        lda url_buffer
   585 49AB C9 4E		        cmp #'N'
   586 49AD D0 21		        bne ?bare
   587 49AF AD 03 90		        lda url_buffer+1
   588 49B2 C9 3A		        cmp #':'
   589 49B4 D0 1A		        bne ?bare
   590 49B6 A0 02		        ldy #2                 ; skip "N:"
   591 49B8 AD 04 90		        lda url_buffer+2
   592 49BB C9 68		        cmp #'h'
   593 49BD D0 11		        bne ?bare
   594 49BF AD 08 90		        lda url_buffer+6
   595 49C2 C9 2F		        cmp #'/'
   596 49C4 D0 0A		        bne ?bare
   597 49C6 A0 09		        ldy #9                 ; skip "N:http://"
   598 				        ; Check for https (extra s)
   599 49C8 AD 07 90		        lda url_buffer+5
   600 49CB C9 73		        cmp #'s'
   601 49CD D0 01		        bne ?bare
   602 49CF C8			        iny                    ; skip "N:https://"
   603
   604 49D0			?bare   ; Y = start of bare URL in url_buffer
   605 				        ; Copy bare URL to rx_buffer (temp)
   606 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero)
   607 49D0 A2 38		        ldx #256-200
   608 49D2 B9 02 90		?cp1    lda url_buffer,y
   609 49D5 9D C8 80		        sta rx_buffer+200-256,x
   610 49D8 F0 09		        beq ?cp1d
   611 49DA C8			        iny
   612 49DB E8			        inx
   613 49DC D0 F4		        bne ?cp1
   614 49DE A9 00		        lda #0
   615 49E0 8D C8 81		        sta rx_buffer+200
   616 				 .else
   617 				        ldx #0
   618 				?cp1    lda url_buffer,y
   619 				        sta rx_buffer,x
   620 				        beq ?cp1d
   621 				        iny
   622 				        inx
   623 				        cpx #200
   624 				        bne ?cp1
   625 				        lda #0
   626 				        sta rx_buffer,x
   627 				 .endif
   628 49E3			?cp1d
   629 				        ; Copy proxy prefix to url_buffer
   630 49E3 A0 00		        ldy #0
   631 49E5 B9 09 4A		?pfx    lda proxy_prefix,y
   632 49E8 F0 06		        beq ?pfxd
   633 49EA 99 02 90		        sta url_buffer,y
   634 49ED C8			        iny
   635 49EE D0 F5		        bne ?pfx
   636 49F0			?pfxd   ; Y = length of prefix
   637 				        ; Append bare URL from rx_buffer
   638 49F0 A2 00		        ldx #0
   639 49F2 BD 00 81		?cp2    lda rx_buffer,x
   640 49F5 99 02 90		        sta url_buffer,y
   641 49F8 F0 0B		        beq ?upd
   642 49FA C8			        iny
   643 49FB E8			        inx
   644 49FC C0 FF		        cpy #URL_BUF_SIZE-1
   645 49FE D0 F2		        bne ?cp2
   646 4A00 A9 00		        lda #0
   647 4A02 99 02 90		        sta url_buffer,y
   648 4A05 8C 02 91		?upd    sty url_length
   649 4A08 60			?done   rts
   650
   651 				.endp
   652
   653 4A09 4E 3A 68 74 74 70 + proxy_prefix dta c'N:https://turiecfoto.sk/cactus/proxy.php?url=',0
   654
   655 				; ----------------------------------------------------------------------------
   656 				; url_build_search - Convert search query in url_buffer to search URL
   657 				; Input: url_buffer = "search terms", url_length = length
   658 				; Output: url_buffer = "N:https://turiecfoto.sk/cactus/search.php?q=search+terms"
   659 				; (https: the server answers plain http with a 301 redirect)
   660 				; ----------------------------------------------------------------------------
   661 4A37			.proc url_build_search
   662 				        ; Copy query from url_buffer to rx_buffer (temp)
   663 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero)
   664 4A37 A0 38		        ldy #256-200
   665 4A39 B9 CA 8F		?cp1    lda url_buffer+200-256,y
   666 4A3C 99 C8 80		        sta rx_buffer+200-256,y
   667 4A3F F0 08		        beq ?cp1d
   668 4A41 C8			        iny
   669 4A42 D0 F5		        bne ?cp1
   670 4A44 A9 00		        lda #0
   671 4A46 8D C8 81		        sta rx_buffer+200
   672 				 .else
   673 				        ldy #0
   674 				?cp1    lda url_buffer,y
   675 				        sta rx_buffer,y
   676 				        beq ?cp1d
   677 				        iny
   678 				        cpy #200
   679 				        bne ?cp1
   680 				        lda #0
   681 				        sta rx_buffer,y
   682 				 .endif
   683 4A49			?cp1d
   684 				        ; Copy search prefix to url_buffer
   685 4A49 A0 00		        ldy #0
   686 4A4B B9 75 4A		?pfx    lda search_prefix,y
   687 4A4E F0 06		        beq ?pfxd
   688 4A50 99 02 90		        sta url_buffer,y
   689 4A53 C8			        iny
   690 4A54 D0 F5		        bne ?pfx
   691 4A56			?pfxd   ; Y = length of prefix
   692 				        ; Append query from rx_buffer, encoding spaces as '+'
   693 4A56 A2 00		        ldx #0
   694 4A58 BD 00 81		?cp2    lda rx_buffer,x
   695 4A5B F0 0F		        beq ?done
   696 4A5D C9 20		        cmp #' '
   697 4A5F D0 02		        bne ?nosp
   698 4A61 A9 2B		        lda #'+'
   699 4A63 99 02 90		?nosp   sta url_buffer,y
   700 4A66 C8			        iny
   701 4A67 E8			        inx
   702 4A68 C0 FF		        cpy #URL_BUF_SIZE-1
   703 4A6A D0 EC		        bne ?cp2
   704 4A6C A9 00		?done   lda #0
   705 4A6E 99 02 90		        sta url_buffer,y
   706 4A71 8C 02 91		        sty url_length
   707 4A74 60			        rts
   708 				.endp
   709
   710 4A75 4E 3A 68 74 74 70 + search_prefix dta c'N:https://'
   711 4A7F 74 75 72 69 65 63 + search_host   dta c'turiecfoto.sk/cactus/search.php?q=',0
   712 = 000A			SEARCH_SCHEME = search_host - search_prefix      ; 10
   713
   714 				; ----------------------------------------------------------------------------
   715 				; http_extract_frag - Extract #fragment from url_buffer
   716 				; Sets skip_to_frag=1 and fills frag_buf if '#' found
   717 				; Strips '#...' from url_buffer (server doesn't need it)
   718 				; ----------------------------------------------------------------------------
   719 4AA2			.proc http_extract_frag
   720 4AA2 A9 00		        lda #0
   721 4AA4 8D 0B 50		        sta skip_to_frag
   722 4AA7 A0 00		        ldy #0
   723 4AA9 B9 02 90		?scan   lda url_buffer,y
   724 4AAC F0 07		        beq ?done              ; no fragment found
   725 4AAE C9 23		        cmp #'#'
   726 4AB0 F0 06		        beq ?found
   727 4AB2 C8			        iny
   728 4AB3 D0 F4		        bne ?scan
   729 4AB5 4C E2 4F		?done   jmp update_emit_skip   ; skip_to_frag = 0
   730 4AB8			?found  ; Null-terminate URL at '#'
   731 4AB8 A9 00		        lda #0
   732 4ABA 99 02 90		        sta url_buffer,y
   733 4ABD 8C 02 91		        sty url_length
   734 				        ; Copy fragment (after '#') to frag_buf
   735 4AC0 C8			        iny                    ; skip '#'
   736 4AC1 A2 00		        ldx #0
   737 4AC3 B9 02 90		?cp     lda url_buffer,y
   738 4AC6 9D 0C 50		        sta frag_buf,x
   739 4AC9 F0 0B		        beq ?set               ; null terminator copied
   740 4ACB C8			        iny
   741 4ACC E8			        inx
   742 4ACD E0 1F		        cpx #FRAG_BUF_SZ-1
   743 4ACF D0 F2		        bne ?cp
   744 4AD1 A9 00		        lda #0
   745 4AD3 9D 0C 50		        sta frag_buf,x         ; force null-terminate
   746 4AD6 A9 01		?set    lda #1
   747 4AD8 8D 0B 50		        sta skip_to_frag
   748 4ADB 4C E2 4F		        jmp update_emit_skip
   749 				.endp
    99 4ADE			        icl 'vbxe_pal.asm'
Source: vbxe_pal.asm
     1 				; ============================================================================
     2 				; VBXE Palette Routines
     3 				; Pure register I/O -- no MEMAC B window access, so this code may live
     4 				; ABOVE $4000. Writing CB selects the next colour (CSEL + 1), so a run of
     5 				; colours needs one CSEL write. The CR/CG/CB stores are absolute, patched
     6 				; with the detected register page ($D6xx or $D7xx).
     7 				; ============================================================================
     8
     9 				; ----------------------------------------------------------------------------
    10 				; pal_regs - Patch the CR/CG/CB store operands of both routines below
    11 				; ----------------------------------------------------------------------------
    12 4ADE			.proc pal_regs
    13 4ADE A5 81		        lda zp_vbxe_base+1     ; register page (base low byte is 0)
    14 4AE0 8D 12 4B		        sta setup_palette.st_r+2
    15 4AE3 8D 18 4B		        sta setup_palette.st_g+2
    16 4AE6 8D 1E 4B		        sta setup_palette.st_b+2
    17 4AE9 8D 28 4B		        sta setup_palette.st_lr+2
    18 4AEC 8D 2D 4B		        sta setup_palette.st_lg+2
    19 4AEF 8D 32 4B		        sta setup_palette.st_lb+2
    20 4AF2 8D AE 4B		        sta vbxe_img_setpal.st_r+2
    21 4AF5 8D B8 4B		        sta vbxe_img_setpal.st_g+2
    22 4AF8 8D C2 4B		        sta vbxe_img_setpal.st_b+2
    23 4AFB 60			        rts
    24 				.endp
    25
    26 				; ----------------------------------------------------------------------------
    27 				; setup_palette - Init VBXE overlay palette 1: colours 0-31 from pal_*,
    28 				; 32-95 (link colours with embedded link#) all blue
    29 				; ----------------------------------------------------------------------------
    30 4AFC			.proc setup_palette
    31 4AFC 20 DE 4A		        jsr pal_regs
    32 4AFF A0 45		        ldy #VBXE_PSEL
    33 4B01 A9 01		        lda #1
    34 4B03 91 80		        sta (zp_vbxe_base),y
    35 4B05 A0 44		        ldy #VBXE_CSEL
    36 4B07 A9 00		        lda #0
    37 4B09 91 80		        sta (zp_vbxe_base),y
    38
    39 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero,
    40 				                                ; same colour order for the CSEL auto-increment)
    41 4B0B A2 E0		        ldx #256-PAL_N
    42 4B0D BD 57 4A		?lp     lda pal_r+PAL_N-256,x
    43 4B10 8D 46 D6		st_r    sta $D600+VBXE_CR      ; (page patched)
    44 4B13 BD 77 4A		        lda pal_g+PAL_N-256,x
    45 4B16 8D 47 D6		st_g    sta $D600+VBXE_CG
    46 4B19 BD 97 4A		        lda pal_b+PAL_N-256,x
    47 4B1C 8D 48 D6		st_b    sta $D600+VBXE_CB      ; CSEL + 1
    48 4B1F E8			        inx
    49 4B20 D0 EB		        bne ?lp
    50 				 .else
    51 				        ldx #0
    52 				?lp     lda pal_r,x
    53 				st_r    sta $D600+VBXE_CR      ; (page patched)
    54 				        lda pal_g,x
    55 				st_g    sta $D600+VBXE_CG
    56 				        lda pal_b,x
    57 				st_b    sta $D600+VBXE_CB      ; CSEL + 1
    58 				        inx
    59 				        cpx #PAL_N
    60 				        bne ?lp
    61 				 .endif
    62
    63 				        ; Palette entries $20-$5F: blue (same as COL_BLUE)
    64 4B22 A2 40		        ldx #MAX_LINKS
    65 4B24 A9 00		?lnk    lda #$00
    66 4B26 8D 46 D6		st_lr   sta $D600+VBXE_CR
    67 4B29 A9 AA		        lda #$AA
    68 4B2B 8D 47 D6		st_lg   sta $D600+VBXE_CG
    69 4B2E A9 FF		        lda #$FF
    70 4B30 8D 48 D6		st_lb   sta $D600+VBXE_CB
    71 4B33 CA			        dex
    72 4B34 D0 EE		        bne ?lnk
    73 4B36 60			        rts
    74
    75 				; Colours 0-31 in index order:
    76 				;   0-7 text (blk wht blue org grn red gray yel), 8-11 title gradient
    77 				;   (dark blue top -> medium blue bottom), 12-15 extra text colours
    78 				;   (cyan pink ltgray lime), 16-31 ANSI CGA colours (black, red, green,
    79 				;   yellow, blue, magenta, cyan, white; then the same bright, for ESC[1m)
    80 4B37 00 FF 00 FF 00 FF + pal_r   dta $00, $FF, $00, $FF, $00, $FF, $88, $FF
    81 4B3F 10 20 30 50		        dta $10, $20, $30, $50
    82 4B43 00 FF BB 88		        dta $00, $FF, $BB, $88
    83 4B47 00 AA 00 AA 00 AA +         dta $00, $AA, $00, $AA, $00, $AA, $00, $AA, $55, $FF, $55, $FF, $55, $FF, $55, $FF
    84 = 0020			PAL_N = * - pal_r
    85 4B57 00 FF AA AA FF 44 + pal_g   dta $00, $FF, $AA, $AA, $FF, $44, $88, $FF
    86 4B5F 10 30 60 90		        dta $10, $30, $60, $90
    87 4B63 DD 88 BB FF		        dta $DD, $88, $BB, $FF
    88 4B67 00 00 AA 55 00 00 +         dta $00, $00, $AA, $55, $00, $00, $AA, $AA, $55, $55, $FF, $FF, $55, $55, $FF, $FF
    89 4B77 00 FF FF 00 00 44 + pal_b   dta $00, $FF, $FF, $00, $00, $44, $88, $00
    90 4B7F 40 80 C0 FF		        dta $40, $80, $C0, $FF
    91 4B83 FF CC BB 44		        dta $FF, $CC, $BB, $44
    92 4B87 00 00 00 00 AA AA +         dta $00, $00, $00, $00, $AA, $AA, $AA, $AA, $55, $55, $55, $55, $FF, $FF, $FF, $FF
    93 				        ert PAL_N<>ATTR_LINK_BASE
    94 				.endp
    95
    96 				; ----------------------------------------------------------------------------
    97 				; vbxe_img_setpal - Set image palette (always palette 1)
    98 				; Input: zp_tmp_ptr = palette data (768 bytes, above $7FFF)
    99 				; Preserves colors 0-7 (text), writes colors 8-255 from image data
   100 				; ----------------------------------------------------------------------------
   101 4B97			.proc vbxe_img_setpal
   102 4B97 20 DE 4A		        jsr pal_regs
   103 4B9A A0 45		        ldy #VBXE_PSEL
   104 4B9C A9 01		        lda #1
   105 4B9E 91 80		        sta (zp_vbxe_base),y
   106 4BA0 A0 44		        ldy #VBXE_CSEL
   107 4BA2 A9 08		        lda #8                 ; start at color 8 (preserve text colors 0-7)
   108 4BA4 91 80		        sta (zp_vbxe_base),y
   109
   110 4BA6 A0 18		        ldy #24                ; skip the first 8 entries of the source
   111 4BA8 A2 F8		        ldx #256-8             ; colours 8-255
   112 4BAA B1 87		?write  lda (zp_tmp_ptr),y     ; Red
   113 4BAC 8D 46 D6		st_r    sta $D600+VBXE_CR
   114 4BAF C8			        iny
   115 4BB0 D0 02		        bne ?g0
   116 4BB2 E6 88		        inc zp_tmp_ptr+1
   117 4BB4 B1 87		?g0     lda (zp_tmp_ptr),y     ; Green
   118 4BB6 8D 47 D6		st_g    sta $D600+VBXE_CG
   119 4BB9 C8			        iny
   120 4BBA D0 02		        bne ?b0
   121 4BBC E6 88		        inc zp_tmp_ptr+1
   122 4BBE B1 87		?b0     lda (zp_tmp_ptr),y     ; Blue
   123 4BC0 8D 48 D6		st_b    sta $D600+VBXE_CB      ; CSEL + 1
   124 4BC3 C8			        iny
   125 4BC4 D0 02		        bne ?nx
   126 4BC6 E6 88		        inc zp_tmp_ptr+1
   127 4BC8 CA			?nx     dex
   128 4BC9 D0 DF		        bne ?write
   129 4BCB 60			        rts
   130 				.endp
   100 4BCC			        icl 'html_parser.asm'
