    34 				; ----------------------------------------------------------------------------
    35 				; img_check_abort - Non-blocking key check during image download
    36 				; Allows user to cancel long image transfers by pressing any key
    37 				; Output: C=1 if key pressed (abort), C=0 continue
    38 				; ----------------------------------------------------------------------------
    39 6519			.proc img_check_abort
    40 6519 AD FC 02		        lda CH
    41 651C 49 FF		        eor #KEY_NONE          ; 0 = no key
    42 651E C9 01		        cmp #1                 ; C = 1: a key was pressed
    43 6520 90 05		        bcc ?no
    44 6522 A9 FF		        lda #KEY_NONE          ; consume it (C stays 1)
    45 6524 8D FC 02		        sta CH
    46 6527 60			?no     rts
    47 				.endp
