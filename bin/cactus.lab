   532 				; ----------------------------------------------------------------------------
   533 				; ui_status_progress - Show "Loading... NNkB" on status bar
   534 				; Input: http_bytes_lo/hi = total bytes downloaded (16-bit)
   535 				; ----------------------------------------------------------------------------
   536 63CD			.proc ui_status_progress
   537 				        ; Convert bytes to KB (divide by 256 = just use high byte)
   538 				        ; Show update only when KB value changes (avoid flicker)
   539 				 .if 1                          ; 2026-09-23 (fix: real kB from the 24-bit pb_total)
   540 63CD AD 3B 3B		        lda pb_total+1         ; kB = pb_total >> 10 (24-bit, <= 448):
   541 63D0 8D 8B 64		        sta ?kl                ; the old high byte of http_bytes counted
   542 63D3 AD 3C 3B		        lda pb_total+2         ; 256-byte blocks and wrapped at 64 KB
   543 63D6 4A			        lsr
   544 63D7 6E 8B 64		        ror ?kl
   545 63DA 4A			        lsr
   546 63DB 6E 8B 64		        ror ?kl
   547 63DE 8D 8C 64		        sta ?kh
   548 63E1 AD 8B 64		        lda ?kl
   549 63E4 CD 8A 64		        cmp prog_last_kb
   550 63E7 F0 14		        beq ?skip              ; same kB as last time, skip update
   551 63E9 8D 8A 64		        sta prog_last_kb
   552
   553 				 .if 1                          ; 2026-09-23 (one status bar for everything)
   554 63EC A9 1B		        lda #STATUS_ROW        ; the bar from ui_status_loading stays:
   555 63EE A2 0C		        ldx #PROG_COL          ; only the number is written (kB only grow)
   556 63F0 20 E3 32		        jsr vbxe_setpos
   557 63F3 20 FE 63		        jsr ?p16
   558 				 .else
   559 				        status_msg COL_YELLOW, m_prog
   560
   561 				        lda #COL_YELLOW
   562 				        sta zp_cur_attr
   563 				        jsr ?p16
   564 				 .endif
   565 				 .else
   566 				        lda http_bytes_hi
   567 				        cmp prog_last_kb
   568 				        beq ?skip              ; same KB as last time, skip update
   569 				        sta prog_last_kb
   570
   571 				        status_msg COL_YELLOW, m_prog
   572
   573 				        ; Print KB number (0-255) — attr still yellow from fill_row
   574 				        lda #COL_YELLOW
   575 				        sta zp_cur_attr
   576 				        lda prog_last_kb
   577 				        jsr ?print_num
   578 				 .endif
   579
   580 				 .if 1                          ; 2026-09-23 (one status bar for everything)
   581 63F6 A9 86		        lda #<m_kb
   582 63F8 A2 64		        ldx #>m_kb
   583 63FA 20 ED 35		        jsr sb_text
   584 63FD 60			?skip   rts
   585 				 .else
   586 				        lda #<m_kb
   587 				        ldx #>m_kb
   588 				        jsr vbxe_print
   589
   590 				        lda #ATTR_NORMAL
   591 				        sta zp_cur_attr
   592 				?skip   rts
   593 				 .endif
   594
   595 				 .if 1                          ; 2026-09-23 (fix: 16-bit kB, ends in ?tens / ?t_lp like ?print_num)
   596 63FE A2 2F		?p16    ldx #'0'-1             ; hundreds digit of the 16-bit kB
   597 6400 E8			?h16    inx
   598 6401 AD 8B 64		        lda ?kl
   599 6404 38			        sec
   600 6405 E9 64		        sbc #100
   601 6407 8D 8B 64		        sta ?kl
   602 640A AD 8C 64		        lda ?kh
   603 640D E9 00		        sbc #0
   604 640F 8D 8C 64		        sta ?kh
   605 6412 B0 EC		        bcs ?h16
   606 6414 AD 8B 64		        lda ?kl
   607 6417 69 64		        adc #100               ; C = 0: undo the last subtraction, A < 100
   608 				 .if 1                          ; 2026-09-23 (one status bar for everything)
   609 6419 E0 30		        cpx #'0'
   610 641B F0 1B		        beq ?no_h
   611 641D 48			        pha                    ; hundreds digit, then both lower digits
   612 641E 8A			        txa
   613 641F 20 23 36		        jsr sb_char
   614 6422 68			        pla
   615 6423 A2 2F		        ldx #'0'-1
   616 6425 38			        sec
   617 6426 E8			?t16    inx
   618 6427 E9 0A		        sbc #10
   619 6429 B0 FB		        bcs ?t16
   620 642B 69 0A		        adc #10                ; C = 0
   621 642D 48			        pha
   622 642E 8A			        txa
   623 642F 20 23 36		        jsr sb_char
   624 6432 68			        pla
   625 6433 09 30		        ora #'0'
   626 6435 4C 23 36		        jmp sb_char
   627 6438 4C 32 36		?no_h   jmp sb_num             ; < 100
   628 				 .else
   629 				        cpx #'0'
   630 				        beq ?no_h
   631 				        jsr ?digit             ; print X, keep A
   632 				        ldx #'0'-1
   633 				        sec
   634 				        bcs ?t_lp              ; always: with hundreds, tens always print
   635 				?no_h   ldx #'0'-1
   636 				        jmp ?tens
   637 				 .endif
   638 				 .endif
   639 				        ; Print 8-bit number in A as decimal (no leading zeros)
   640 643B			?print_num
   641 643B A2 2F		        ldx #'0'-1             ; X = digit char (vbxe_putchar keeps X)
   642 643D C9 64		        cmp #100
   643 643F 90 0F		        bcc ?tens
   644 6441 E8			?h_lp   inx                    ; hundreds
   645 6442 E9 64		        sbc #100
   646 6444 B0 FB		        bcs ?h_lp
   647 6446 69 64		        adc #100               ; C = 0: undo the last subtraction
   648 6448 20 63 64		        jsr ?digit
   649 644B A2 2F		        ldx #'0'-1
   650 644D 38			        sec
   651 644E B0 04		        bcs ?t_lp              ; always: with hundreds, tens always print
   652 6450 C9 0A		?tens   cmp #10
   653 6452 90 0A		        bcc ?one
   654 6454 E8			?t_lp   inx
   655 6455 E9 0A		        sbc #10
   656 6457 B0 FB		        bcs ?t_lp
   657 6459 69 0A		        adc #10
   658 645B 20 63 64		        jsr ?digit
   659 645E 09 30		?one    ora #'0'
   660 6460 4C EA 32		        jmp vbxe_putchar
   661 6463 8D 6E 64		?digit  sta ?rest              ; print X, keep A
   662 6466 8A			        txa
   663 6467 20 EA 32		        jsr vbxe_putchar
   664 646A AD 6E 64		        lda ?rest
   665 646D 60			        rts
   666 646E 00			?rest   dta 0
   667
   668 				 .if 1                          ; 2026-09-23 (one status bar for everything)
   669 646F 20 4C 6F 61 64 69 + m_prog  dta c' Loading... ',1,c'Key  Stop',0
   670 6486 20 6B 42 00		m_kb    dta c' kB',0
   671 = 000C			PROG_COL = 12                  ; after " Loading... " (m_load + space)
   672 				 .else
   673 				m_prog  dta c' Loading... ',0
   674 				m_kb    dta c'kB',0
   675 				 .endif
   676 648A FF			prog_last_kb dta b($FF)
   677 				 .if 1
   678 648B 00			?kl     dta 0
   679 648C 00			?kh     dta 0
   680 				 .endif
   681 				.endp
