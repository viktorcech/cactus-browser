   514 				; render_number - Output number 0-99 as ASCII digits
   515 				; Input: A = number
   516 				; ----------------------------------------------------------------------------
   517 5EE6			.proc render_number
   518 5EE6 C9 0A		        cmp #10
   519 5EE8 90 14		        bcc ?one
   520
   521 5EEA A2 00		        ldx #0
   522 5EEC C9 0A		?tens   cmp #10
   523 5EEE 90 05		        bcc ?got
   524 5EF0 E9 0A		        sbc #10
   525 5EF2 E8			        inx
   526 5EF3 D0 F7		        bne ?tens
   527 5EF5 48			?got    pha
   528 5EF6 8A			        txa
   529 5EF7 18			        clc
   530 5EF8 69 30		        adc #'0'
   531 5EFA 20 33 5C		        jsr render_out_char
   532 5EFD 68			        pla
   533
   534 5EFE 18			?one    clc
   535 5EFF 69 30		        adc #'0'
   536 5F01 4C 33 5C		        jmp render_out_char
   537 				.endp
