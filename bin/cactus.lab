Source: fujinet.asm
     1 				; ============================================================================
     2 				; FujiNet N: Device SIO Layer
     3 				; ============================================================================
     4
     5 = 0071			FN_DEVID       = $71
     6 = 0001			FN_UNIT        = 1
     7 41EA 01			fn_cur_unit    dta FN_UNIT     ; current N: unit (1=page, 2=image)
     8 = 004F			FN_CMD_OPEN    = 'O'
     9 = 0043			FN_CMD_CLOSE   = 'C'
    10 = 0052			FN_CMD_READ    = 'R'
    11 = 0053			FN_CMD_STATUS  = 'S'
    12 = 0040			SIO_READ       = $40
    13 = 0080			SIO_WRITE      = $80
    14 = 0000			SIO_NONE       = $00
    15 = 0004			FN_OPEN_READ   = 4
    16 = 0000			FN_TRANS_NONE  = 0
    17 = 001E			FN_TIMEOUT     = 30
    18 = 0100			URL_BUF_SIZE   = 256
    19 = 0100			RX_BUF_SIZE    = 256
    20
    21 				; ----------------------------------------------------------------------------
    22 				; fn_open - Open FujiNet connection (url_buffer -> OPEN)
    23 				; Output: C=0 ok, C=1 error
    24 				; ----------------------------------------------------------------------------
    25 41EB			.proc fn_open
    26 41EB A9 71		        lda #FN_DEVID
    27 41ED 8D 00 03		        sta DDEVIC
    28 41F0 AD EA 41		        lda fn_cur_unit
    29 41F3 8D 01 03		        sta DUNIT
    30 41F6 A9 4F		        lda #FN_CMD_OPEN
    31 41F8 8D 02 03		        sta DCOMND
    32 41FB A9 80		        lda #SIO_WRITE
    33 41FD 8D 03 03		        sta DSTATS
    34 4200 A9 02		        lda #<url_buffer
    35 4202 8D 04 03		        sta DBUFLO
    36 4205 A9 90		        lda #>url_buffer
    37 4207 8D 05 03		        sta DBUFHI
    38 420A A9 1E		        lda #FN_TIMEOUT
    39 420C 8D 06 03		        sta DTIMLO
    40 420F A9 00		        lda #<URL_BUF_SIZE
    41 4211 8D 08 03		        sta DBYTLO
    42 4214 A9 01		        lda #>URL_BUF_SIZE
    43 4216 8D 09 03		        sta DBYTHI
    44 4219 A9 04		        lda #FN_OPEN_READ
    45 421B 8D 0A 03		        sta DAUX1
    46 421E A9 00		        lda #FN_TRANS_NONE
    47 4220 8D 0B 03		        sta DAUX2
    48 4223 4C B8 42		        jmp sio_ok
    49 				.endp
    50
    51 				; ----------------------------------------------------------------------------
    52 				; fn_status - Get FujiNet status (bytes waiting, connected, error)
    53 				; Reads 4-byte DVSTAT: [0]=bytes_lo, [1]=bytes_hi, [2]=connected, [3]=error
    54 				; Error codes: 0=ok, 136($88)=EOF/closed, other=fatal
    55 				; Output: zp_fn_bytes_lo/hi, zp_fn_connected, zp_fn_error, C=0/1
    56 				; ----------------------------------------------------------------------------
    57 4226			.proc fn_status
    58 4226 A9 71		        lda #FN_DEVID
    59 4228 8D 00 03		        sta DDEVIC
    60 422B AD EA 41		        lda fn_cur_unit
    61 422E 8D 01 03		        sta DUNIT
    62 4231 A9 53		        lda #FN_CMD_STATUS
    63 4233 8D 02 03		        sta DCOMND
    64 4236 A9 40		        lda #SIO_READ
    65 4238 8D 03 03		        sta DSTATS
    66 423B A9 EA		        lda #<DVSTAT
    67 423D 8D 04 03		        sta DBUFLO
    68 4240 A9 02		        lda #>DVSTAT
    69 4242 8D 05 03		        sta DBUFHI
    70 4245 A9 1E		        lda #FN_TIMEOUT
    71 4247 8D 06 03		        sta DTIMLO
    72 424A A9 04		        lda #4
    73 424C 8D 08 03		        sta DBYTLO
    74 424F A9 00		        lda #0
    75 4251 8D 09 03		        sta DBYTHI
    76 4254 8D 0A 03		        sta DAUX1
    77 4257 8D 0B 03		        sta DAUX2
    78
    79 425A 20 B8 42		        jsr sio_ok
    80 425D B0 14		        bcs ?err
    81
    82 425F AD EA 02		        lda DVSTAT
    83 4262 85 A1		        sta zp_fn_bytes_lo
    84 4264 AD EB 02		        lda DVSTAT+1
    85 4267 85 A2		        sta zp_fn_bytes_hi
    86 4269 AD EC 02		        lda DVSTAT+2
    87 426C 85 9F		        sta zp_fn_connected
    88 426E AD ED 02		        lda DVSTAT+3
    89 				 .if 1                          ; 2026-09-23 (6502-idioms: known carry: the not-taken bcs ?err leaves C = 0)
    90 4271 85 A0		        sta zp_fn_error        ; C = 0: the bcs ?err above was not taken
    91 4273 60			?err    rts
    92 				 .else
    93 				        sta zp_fn_error
    94 				        clc
    95 				?err    rts
    96 				 .endif
    97 				.endp
    98
    99 				; ----------------------------------------------------------------------------
   100 				; fn_read - Read data from FujiNet into rx_buffer
   101 				; Uses zp_fn_bytes_lo/hi from fn_status, caps at 255 (8-bit zp_rx_len)
   102 				; Reading 256 would set zp_rx_len=0 (overflow!) — always read max 255
   103 				; DAUX1/DAUX2 must match DBYTLO/DBYTHI (FujiNet requirement)
   104 				; Output: zp_rx_len = bytes read, C=0/1
   105 				; ----------------------------------------------------------------------------
   106 4274			.proc fn_read
   107 4274 A5 A1		        lda zp_fn_bytes_lo
   108 4276 A6 A2		        ldx zp_fn_bytes_hi
   109 4278 F0 02		        beq ?lo
   110 427A A9 FF		        lda #255                       ; Max 255 bytes (fits in 8-bit rx_len)
   111 427C 85 A3		?lo     sta zp_rx_len
   112 427E AA			        tax
   113 427F D0 02		        bne ?do
   114 4281 18			        clc                            ; nothing waiting
   115 4282 60			        rts
   116
   117 4283 8E 08 03		?do     stx DBYTLO
   118 4286 8E 0A 03		        stx DAUX1                      ; DAUX = DBYT (FujiNet requirement)
   119 4289 A9 00		        lda #0
   120 428B 8D 09 03		        sta DBYTHI
   121 428E 8D 0B 03		        sta DAUX2
   122 4291 A9 71		        lda #FN_DEVID
   123 4293 8D 00 03		        sta DDEVIC
   124 4296 AD EA 41		        lda fn_cur_unit
   125 4299 8D 01 03		        sta DUNIT
   126 429C A9 52		        lda #FN_CMD_READ
   127 429E 8D 02 03		        sta DCOMND
   128 42A1 A9 40		        lda #SIO_READ
   129 42A3 8D 03 03		        sta DSTATS
   130 42A6 A9 00		        lda #<rx_buffer
   131 42A8 8D 04 03		        sta DBUFLO
   132 42AB A9 81		        lda #>rx_buffer
   133 42AD 8D 05 03		        sta DBUFHI
   134 42B0 A9 1E		        lda #FN_TIMEOUT
   135 42B2 8D 06 03		        sta DTIMLO
   136 42B5 4C B8 42		        jmp sio_ok
   137 				.endp
   138
   139 				; ----------------------------------------------------------------------------
   140 				; sio_ok - Call SIOV; C = 1 when DSTATS reports an error (bit 7)
   141 				; ----------------------------------------------------------------------------
   142 42B8			.proc sio_ok
   143 42B8 20 59 E4		        jsr SIOV
   144 42BB AD 03 03		        lda DSTATS
   145 42BE 0A			        asl                    ; C = bit 7 = error
   146 42BF 60			        rts
   147 				.endp
   148
   149 				; ----------------------------------------------------------------------------
   150 				; fn_read_img - Read up to 2KB into img_big_buf for fast image streaming
   151 				; Standard fn_read caps at 255 bytes (8-bit zp_rx_len), requiring ~260
   152 				; SIO calls for a 66KB image. This routine reads up to 2048 bytes per
   153 				; SIO call, reducing calls to ~33 (8x fewer, much less SIO overhead).
   154 				; Uses zp_fn_bytes_lo/hi from fn_status, caps at IMG_BIG_SIZE (2048)
   155 				; Output: img_chunk_lo/hi = bytes actually requested, C=0 ok, C=1 error
   156 				; DAUX1/DAUX2 must equal DBYTLO/DBYTHI (FujiNet protocol requirement)
   157 				; ----------------------------------------------------------------------------
   158 42C0			.proc fn_read_img
   159 				        ; Cap at IMG_BIG_SIZE ($0800)
   160 42C0 A5 A2		        lda zp_fn_bytes_hi
   161 42C2 C9 08		        cmp #>IMG_BIG_SIZE     ; >= 8 pages?
   162 42C4 90 0C		        bcc ?use               ; < 8 pages, use exact
   163 				        ; >= 2048 bytes: cap
   164 42C6 A9 00		        lda #<IMG_BIG_SIZE
   165 42C8 8D 00 90		        sta img_chunk_lo
   166 42CB A9 08		        lda #>IMG_BIG_SIZE
   167 42CD 8D 01 90		        sta img_chunk_hi
   168 42D0 D0 0D		        bne ?do                ; always
   169 42D2 8D 01 90		?use    sta img_chunk_hi
   170 42D5 A5 A1		        lda zp_fn_bytes_lo
   171 42D7 8D 00 90		        sta img_chunk_lo
   172 42DA 0D 01 90		        ora img_chunk_hi
   173 42DD F0 39		        beq ?nothing
   174
   175 42DF A9 71		?do     lda #FN_DEVID
   176 42E1 8D 00 03		        sta DDEVIC
   177 42E4 AD EA 41		        lda fn_cur_unit
   178 42E7 8D 01 03		        sta DUNIT
