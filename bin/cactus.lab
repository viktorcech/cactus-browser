    12 				; $8000-$87FF: page-aligned tables and buffers the hot loops index
    13 				; (outside the MEMAC B window, so they stay readable while it is open)
    14 				; ============================================================================
    15 				; MEMAC B register stores to move to $D7xx (memac_patch), 2 bytes each:
    16 				; the address of each store's operand high byte (memb_set, vbxe_const.asm)
    17 = 002E			MEMAC_COUNT = .get[0]
    18 78A9			memac_sites
    19 78A9 AB 30 C1 30 F1 32 +         .sav [2] MEMAC_COUNT*2
    20 				        ert MEMAC_COUNT*2 > 254
