   746 56BD			.proc store_img_src
   747 				        ; Just copy attr_val_buf to img_src_buf (temp storage)
   748 				        ; Actual link storage happens in store_img_as_link when tag closes
   749 56BD A0 00		        ldy #0
   750 56BF B9 BD 51		?cp     lda attr_val_buf,y
   751 56C2 99 16 57		        sta img_src_buf,y
   752 56C5 F0 0A		        beq ?done
   753 56C7 C8			        iny
   754 56C8 C0 FF		        cpy #IMG_SRC_SIZE-1
   755 56CA D0 F3		        bne ?cp
   756 56CC A9 00		        lda #0
   757 56CE 99 16 57		        sta img_src_buf,y
   758 56D1 8C 16 58		?done   sty img_src_len
   759 56D4 60			        rts
   760 				.endp
