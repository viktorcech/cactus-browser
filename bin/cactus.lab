   123 3A82			?block  ; Block size = min(remaining, 256, space to $8000); 0 means 256
   124 3A82 A5 8D		        lda zp_tmp3
   125 3A84 F0 04		        beq ?small
   126 3A86 A9 00		        lda #0                 ; remaining >= 256: candidate = 256
   127 3A88 F0 02		        beq ?cap
   128 3A8A A5 8C		?small  lda zp_tmp2            ; candidate = remaining (1-255)
   129 3A8C			?cap    ; Cap at bank boundary: only possible when dest page = $7F
