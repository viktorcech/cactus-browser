   338 				; --- Table state ---
   339 				; Tables use simple " | " cell separators with horizontal rule borders.
   340 				; <th> header rows get colored text (ATTR_H3) and a separator line below.
   341 				; </tr> resets text color after header rows.
   342 547E 00			tbl_active     dta 0              ; 1 = inside table
   343 547F 00			tbl_had_th     dta 0              ; 1 = row had <th> (draw separator line after)
   344
   345 5480			.proc open_table
   346 5480 20 F6 5B		        jsr render_flush_word
   347 5483 20 60 5C		        jsr render_newline
   348 5486 A9 01		        lda #1
   349 5488 8D 7E 54		        sta tbl_active
   350 548B A9 00		        lda #0
   351 548D 8D 09 50		        sta td_count
   352 5490 8D 7F 54		        sta tbl_had_th
   353 5493 4C 3B 5F		        jmp render_tbl_line
   354 				.endp
   355
   356 5496			.proc open_tr
   357 5496 20 F6 5B		        jsr render_flush_word
   358 5499 AD 09 50		        lda td_count
   359 549C F0 13		        beq ?first              ; very first TR
   360 				        ; Finish previous row
   361 549E 20 60 5C		        jsr render_newline
   362 				        ; Draw separator after TH header row
   363 54A1 AD 7F 54		        lda tbl_had_th
   364 54A4 F0 0B		        beq ?no_sep
   365 54A6 20 3B 5F		        jsr render_tbl_line
   366 54A9 20 60 5C		        jsr render_newline
   367 54AC A9 00		        lda #0
   368 54AE 8D 7F 54		        sta tbl_had_th
   369 54B1			?no_sep
   370 54B1 8D 09 50		?first  sta td_count           ; A = 0 on every path here
   371 54B4 60			        rts
   372 				.endp
   373
   374 54B5			.proc open_td
   375 54B5 20 F6 5B		        jsr render_flush_word
   376 54B8 AD 09 50		        lda td_count
   377 54BB F0 07		        beq ?first
   378 54BD A9 E4		        lda #<m_tbl_sep
   379 54BF A2 54		        ldx #>m_tbl_sep
   380 54C1 20 26 5F		        jsr render_string
   381 54C4 EE 09 50		?first  inc td_count
   382 54C7 60			        rts
   383 				.endp
