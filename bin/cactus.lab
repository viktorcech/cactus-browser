   204 				 .if 1                          ; 2026-09-23 (welcome screen as data: 6502-loops-tables-smc, tables beat code)
   205 				; ----------------------------------------------------------------------------
   206 				; ui_draw - Draw a screen description (A/X = list - 1):
   207 				;   UL_BOX,  row, col, w, h, attr         frame of ATASCII line characters
   208 				;   UL_TEXT, row, col, attr, c'...', 0    string
   209 				;   UL_FILL, row, col, n, attr, char      n copies of char
   210 				;   UL_END
   211 				; The list pointer is the SMC operand of ?ld (no zero page pointer).
   212 				; ----------------------------------------------------------------------------
   213 = 0000			UL_END  = 0
   214 = 0001			UL_BOX  = 1
   215 = 0002			UL_TEXT = 2
   216 = 0003			UL_FILL = 3
   217
   218 705C			.proc ui_draw
   219 705C 8D FF 70		        sta ?ld+1
   220 705F 8E 00 71		        stx ?ld+2
   221 7062 20 F6 70		?next   jsr ?get
   222 7065 D0 01		        bne ?op
   223 7067 60			        rts                    ; UL_END
   224 7068 C9 02		?op     cmp #UL_TEXT
   225 706A F0 25		        beq ?text
   226 706C B0 62		        bcs ?fill
   227 706E 20 F6 70		        jsr ?get               ; UL_BOX
   228 7071 8D 7F 71		        sta ui_box.row
   229 7074 20 F6 70		        jsr ?get
   230 7077 8D 80 71		        sta ui_box.col
   231 707A 20 F6 70		        jsr ?get
   232 707D 8D 81 71		        sta ui_box.w
   233 7080 20 F6 70		        jsr ?get
   234 7083 8D 82 71		        sta ui_box.h
   235 7086 20 F6 70		        jsr ?get
   236 7089 85 84		        sta zp_cur_attr
   237 708B 20 03 71		        jsr ui_box
   238 708E 4C 62 70		        jmp ?next
   239 7091 20 EA 70		?text   jsr ?pos
   240 7094 20 F6 70		        jsr ?get
   241 7097 85 84		        sta zp_cur_attr
   242 7099 AD FF 70		        lda ?ld+1              ; the string starts at the next byte
   243 709C 18			        clc
   244 709D 69 01		        adc #1
   245 709F 8D AD 70		        sta ?sc+1
   246 70A2 AD 00 71		        lda ?ld+2
   247 70A5 69 00		        adc #0
   248 70A7 8D AE 70		        sta ?sc+2
   249 70AA A0 00		        ldy #0                 ; its length (< 80): abs,y scan
   250 70AC B9 FF FF		?sc     lda $FFFF,y
   251 70AF F0 03		        beq ?se
   252 70B1 C8			        iny
   253 70B2 D0 F8		        bne ?sc
   254 70B4 98			?se     tya                    ; list pointer -> its NUL: += length + 1
   255 70B5 38			        sec
   256 70B6 6D FF 70		        adc ?ld+1
   257 70B9 8D FF 70		        sta ?ld+1
   258 70BC 90 03		        bcc ?tp
   259 70BE EE 00 71		        inc ?ld+2
   260 70C1 20 87 34		?tp     jsr blit_sync          ; text may sit on a line just filled
   261 70C4 AD AD 70		        lda ?sc+1
   262 70C7 AE AE 70		        ldx ?sc+2
   263 70CA 20 0E 34		        jsr vbxe_print
   264 70CD 4C 62 70		        jmp ?next
   265 70D0 20 EA 70		?fill   jsr ?pos
   266 70D3 20 F6 70		        jsr ?get
   267 70D6 8D 02 71		        sta ?n
   268 70D9 20 F6 70		        jsr ?get
   269 70DC 85 84		        sta zp_cur_attr
   270 70DE 20 F6 70		        jsr ?get
   271 70E1 AE 02 71		        ldx ?n
   272 70E4 20 F4 34		        jsr vbxe_hline
   273 70E7 4C 62 70		        jmp ?next
   274
   275 70EA 20 F6 70		?pos    jsr ?get               ; row, col -> cursor
   276 70ED 48			        pha
   277 70EE 20 F6 70		        jsr ?get
   278 70F1 AA			        tax
   279 70F2 68			        pla
   280 70F3 4C E3 32		        jmp vbxe_setpos
   281
   282 70F6 EE FF 70		?get    inc ?ld+1              ; next list byte in A, N/Z from it
   283 70F9 D0 03		        bne ?ld
   284 70FB EE 00 71		        inc ?ld+2
   285 70FE AD FF FF		?ld     lda $FFFF
   286 7101 60			        rts
   287 7102 00			?n      dta 0
   288 				.endp
