   297 				; Input: zp_rx_len = number of bytes in rx_buffer (1-255)
   298 				; Block copy: since len <= 255, the $8000 bank boundary can only be hit
   299 				; when the write pointer is in page $7F — split the copy there instead of
   300 				; testing per byte (~18 cycles/byte vs ~28 in the old loop).
