   351 				; ----------------------------------------------------------------------------
   352 				; bk_edit - Inline edit of slot X using CIO kbd_get_line.
   353 				; On RETURN: save URL to slot and persist. On ESC: slot unchanged.
   354 				; ----------------------------------------------------------------------------
   355 401B			.proc bk_edit
   356 401B 8E 75 40		        stx ?slot
   357
   358 				        ; Clear row, position cursor, yellow attr
   359 401E 8A			        txa
   360 401F 18			        clc
   361 4020 69 03		        adc #CONTENT_TOP+1
   362 4022 8D 76 40		        sta ?row
   363 4025 20 BF 34		        jsr vbxe_clear_row
   364 4028 AD 76 40		        lda ?row
   365 402B A2 04		        ldx #4
   366 402D 20 E3 32		        jsr vbxe_setpos
   367 4030 A9 07		        lda #COL_YELLOW
   368 4032 85 84		        sta zp_cur_attr
   369
   370 				        ; "N. " prefix
   371 4034 AD 75 40		        lda ?slot
   372 4037 18			        clc
   373 4038 69 31		        adc #'1'
   374 403A 20 EA 32		        jsr vbxe_putchar
   375 403D A9 2E		        lda #'.'
   376 403F 20 EA 32		        jsr vbxe_putchar
   377 4042 A9 20		        lda #' '
   378 4044 20 EA 32		        jsr vbxe_putchar
   379
   380 				        ; Edit into url_save_buf (256 B, free outside image fetch)
   381 4047 A9 24		        lda #<url_save_buf
   382 4049 85 87		        sta zp_tmp_ptr
   383 404B A9 BA		        lda #>url_save_buf
   384 404D 85 88		        sta zp_tmp_ptr+1
   385 404F A2 3E		        ldx #BK_SLOT_SZ-2
   386 4051 20 E3 5F		        jsr kbd_get_line
   387 4054 B0 1E		        bcs ?cancel
   388 4056 98			        tya
   389 4057 F0 1B		        beq ?cancel
   390
   391 				        ; Copy url_save_buf (NUL-terminated) -> slot[?slot]
   392 4059 AE 75 40		        ldx ?slot
   393 405C 20 CE 3D		        jsr bk_slot_addr
   394 405F A0 00		        ldy #0
   395 4061 B9 24 BA		?cp     lda url_save_buf,y
   396 4064 91 87		        sta (zp_tmp_ptr),y
   397 4066 F0 09		        beq ?cpd
   398 4068 C8			        iny
   399 4069 C0 3F		        cpy #BK_SLOT_SZ-1
   400 406B D0 F4		        bne ?cp
   401 406D A9 00		        lda #0
   402 406F 91 87		        sta (zp_tmp_ptr),y
   403 4071 4C AB 3E		?cpd    jmp bk_save
   404 4074 60			?cancel rts
   405 4075 00			?slot   dta 0
   406 4076 00			?row    dta 0
   407 				.endp
