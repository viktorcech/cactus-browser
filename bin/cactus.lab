     1 				; ============================================================================
     2 				; HTML Tag Handlers - open/close tag actions, attribute processing, link storage
     3 				; ============================================================================
     4
     5 				; Current tag ID - saved before dispatch for handlers that need it
     6 52C5-52C5> 00		current_tag_id dta 0
