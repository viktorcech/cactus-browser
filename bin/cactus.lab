     1 				; ============================================================================
     2 				; History Module - URL history stack
     3 				; ============================================================================
     4
     5 = 0010			HIST_MAX       = 16
     6 = 0082			HIST_ENTRY_SZ  = 130   ; 128 bytes URL + 2 bytes scroll pos
     7
     8 				; ----------------------------------------------------------------------------
     9 				; history_init
    10 				; ----------------------------------------------------------------------------
    11 6B6E			.proc history_init
    12 6B6E A9 00		        lda #0
    13 6B70 85 A9		        sta zp_hist_ptr
    14 6B72 60			        rts
    15 				.endp
    16
    17 				; ----------------------------------------------------------------------------
    18 				; history_push - Save current URL to history stack
    19 				; ----------------------------------------------------------------------------
    20 6B73			.proc history_push
    21 6B73 A5 A9		        lda zp_hist_ptr
    22 6B75 C9 10		        cmp #HIST_MAX
    23 6B77 90 05		        bcc ?room
    24 6B79 20 F5 6B		        jsr history_shift
    25 6B7C C6 A9		        dec zp_hist_ptr
    26
    27 6B7E 20 C8 6B		?room   jsr calc_hist_addr
    28
    29 6B81 A0 80		        ldy #128               ; scroll pos after the 128-byte URL
    30 6B83 A5 A5		        lda zp_scroll_pos
    31 6B85 91 87		        sta (zp_tmp_ptr),y
    32 6B87 C8			        iny
    33 6B88 A5 A6		        lda zp_scroll_pos+1
    34 6B8A 91 87		        sta (zp_tmp_ptr),y
    35 6B8C A0 7F		        ldy #127
    36 6B8E B9 02 90		?cp     lda url_buffer,y
    37 6B91 91 87		        sta (zp_tmp_ptr),y
    38 6B93 88			        dey
    39 6B94 10 F8		        bpl ?cp
    40
    41 6B96 E6 A9		        inc zp_hist_ptr
    42 6B98 60			        rts
    43 				.endp
    44
    45 				; ----------------------------------------------------------------------------
    46 				; history_pop - Restore URL from history
    47 				; Output: C=0 ok, C=1 empty
    48 				; ----------------------------------------------------------------------------
    49 6B99			.proc history_pop
    50 6B99 A5 A9		        lda zp_hist_ptr
    51 6B9B F0 29		        beq ?empty
    52
    53 6B9D C6 A9		        dec zp_hist_ptr
    54 6B9F 20 C8 6B		        jsr calc_hist_addr
    55
    56 6BA2 A0 80		        ldy #128
    57 6BA4 B1 87		        lda (zp_tmp_ptr),y
    58 6BA6 85 A5		        sta zp_scroll_pos
    59 6BA8 C8			        iny
    60 6BA9 B1 87		        lda (zp_tmp_ptr),y
    61 6BAB 85 A6		        sta zp_scroll_pos+1
    62 6BAD A0 7F		        ldy #127
    63 6BAF B1 87		?cp     lda (zp_tmp_ptr),y
    64 6BB1 99 02 90		        sta url_buffer,y
    65 6BB4 88			        dey
    66 6BB5 10 F8		        bpl ?cp
    67
    68 				        ; Recalc url_length
    69 6BB7 A0 00		        ldy #0
    70 6BB9 B9 02 90		?len    lda url_buffer,y
    71 6BBC F0 03		        beq ?gl
    72 6BBE C8			        iny
    73 6BBF D0 F8		        bne ?len
    74 6BC1 8C 02 91		?gl     sty url_length
    75 6BC4 18			        clc
    76 6BC5 60			        rts
    77
    78 6BC6 38			?empty  sec
    79 6BC7 60			        rts
    80 				.endp
