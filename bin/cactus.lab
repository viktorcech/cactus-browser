   828 35FE 9D 00 82		        sta print_buf,x
   829 3601 E8			        inx
   830 3602 D0 F1		        bne ?s                 ; always (< 80)
   831 3604 8A			?e      txa
   832 3605 D0 01		        bne sb_emit            ; X = count >= 1
   833 3607 60			        rts
   834 				.endp
