    23 5B49			.proc render_reset
    24 5B49 A9 02		        lda #CONTENT_TOP
    25 5B4B 85 94		        sta zp_render_row
    26 5B4D A9 00		        lda #0
    27 5B4F 85 93		        sta zp_render_col
    28 5B51 85 95		        sta zp_word_len
    29 5B53 85 96		        sta zp_indent
    30 5B55 85 97		        sta zp_in_link
    31 5B57 85 98		        sta zp_link_num
    32 5B59 85 BF		        sta last_was_sp
    33 5B5B 8D 5B 5F		        sta title_len
    34 5B5E 8D 5F 5F		        sta title_buf          ; null-terminate empty title
    35 5B61 85 A5		        sta zp_scroll_pos
    36 5B63 85 A6		        sta zp_scroll_pos+1
    37 5B65 8D 5C 5F		        sta page_abort
    38 5B68 8D 5E 5F		        sta skip_to_heading
    39
    40 5B6B A9 01		        lda #ATTR_NORMAL
    41 5B6D 85 84		        sta zp_cur_attr
    42 5B6F A9 FF		        lda #$FF
    43 5B71 8D 5D 5F		        sta pending_link
    44 5B74 85 BC		        sta zp_tab_link
    45 5B76 4C E2 4F		        jmp update_emit_skip   ; skip_to_heading changed above
    46 				.endp
