   324 				; ui_show_url - Display current URL in URL bar
   325 				; ----------------------------------------------------------------------------
   326 62D0			.proc ui_show_url
   327 62D0 A9 00		        lda #URL_ROW
   328 62D2 A2 04		        ldx #COL_GREEN
   329 62D4 20 C1 34		        jsr vbxe_fill_row
   330 62D7 A9 00		        lda #URL_ROW
   331 62D9 A2 00		        ldx #0
   332 62DB 20 E3 32		        jsr vbxe_setpos
   333 62DE A9 04		        lda #COL_GREEN
   334 62E0 85 84		        sta zp_cur_attr
   335 62E2 A9 9D		        lda #<ui_init.m_urlp
   336 62E4 A2 60		        ldx #>ui_init.m_urlp
   337 62E6 20 0E 34		        jsr vbxe_print
   338 				        ; Check if URL starts with proxy prefix — if so, skip it
   339 				        ; proxy_prefix = "N:https://turiecfoto.sk/cactus/proxy.php?url=" (45 chars)
   340 62E9 A0 00		        ldy #0
   341 62EB B9 09 4A		?chk    lda proxy_prefix,y
   342 62EE F0 6F		        beq ?show_bare         ; end of prefix = full match, skip it
   343 62F0 D9 02 90		        cmp url_buffer,y
   344 62F3 D0 03		        bne ?show_full         ; mismatch = not proxied, show full URL
   345 62F5 C8			        iny
   346 62F6 D0 F3		        bne ?chk
   347 62F8			?show_full
   348 				        ; Search URL? Show "Search: query" instead. The host part is checked
   349 				        ; bare (typed before the prefix is added) and after "N:https://"
   350 62F8 A0 00		        ldy #0
   351 62FA B9 7F 4A		?chks   lda search_host,y
   352 62FD F0 1B		        beq ?show_search           ; full match = search URL
   353 62FF D9 02 90		        cmp url_buffer,y
   354 6302 D0 03		        bne ?chks2
   355 6304 C8			        iny
   356 6305 D0 F3		        bne ?chks
   357 6307 A0 00		?chks2  ldy #0
   358 6309 B9 7F 4A		?chks3  lda search_host,y
   359 630C F0 08		        beq ?show_search10
   360 630E D9 0C 90		        cmp url_buffer+SEARCH_SCHEME,y
   361 6311 D0 30		        bne ?not_search
   362 6313 C8			        iny
   363 6314 D0 F3		        bne ?chks3
   364 6316			?show_search10
   365 6316 98			        tya
   366 6317 69 09		        adc #SEARCH_SCHEME-1       ; C = 1 (cmp equal): skip "N:https://" too
   367 6319 A8			        tay
   368 631A			?show_search
   369 				        ; Y = length of search prefix
   370 631A			?do_search
   371 				        ; Print "Search: " then query (decode + back from url_buffer+Y)
   372 				        ; Save Y before vbxe_print (it clobbers Y)
   373 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero,
   374 				                                ; the patched operand carries the -(256-68) bias)
   375 631A 98			        tya                        ; query source = url_buffer + Y + 68 - 256 (SMC)
   376 631B 18			        clc
   377 631C 69 46		        adc #<(url_buffer+68-256)
   378 631E 8D 32 63		        sta ?sq+1
   379 6321 A9 8F		        lda #>(url_buffer+68-256)
   380 6323 69 00		        adc #0
   381 6325 8D 33 63		        sta ?sq+2
   382 6328 A9 6B		        lda #<m_search
   383 632A A2 63		        ldx #>m_search
   384 632C 20 0E 34		        jsr vbxe_print
   385 				        ; Print query from url_buffer+Y, converting '+' back to spaces
   386 632F A2 BC		        ldx #256-68                ; max display width 68
   387 6331 BD FF FF		?sq     lda $FFFF,x                ; (patched: query start - 188)
   388 6334 F0 0C		        beq ?sqd
   389 6336 C9 2B		        cmp #'+'
   390 6338 D0 02		        bne ?sqn
   391 633A A9 20		        lda #' '
   392 633C 20 EA 32		?sqn    jsr vbxe_putchar           ; preserves X
   393 633F E8			        inx
   394 6340 D0 EF		        bne ?sq
   395 6342 60			?sqd    rts
   396 				 .else
   397 				        tya                        ; query source = url_buffer + Y (SMC)
   398 				        clc
   399 				        adc #<url_buffer
   400 				        sta ?sq+1
   401 				        lda #>url_buffer
   402 				        adc #0
   403 				        sta ?sq+2
   404 				        lda #<m_search
   405 				        ldx #>m_search
   406 				        jsr vbxe_print
   407 				        ; Print query from url_buffer+Y, converting '+' back to spaces
   408 				        ldx #0
   409 				?sq     lda $FFFF,x                ; (patched: query start)
   410 				        beq ?sqd
   411 				        cmp #'+'
   412 				        bne ?sqn
   413 				        lda #' '
   414 				?sqn    jsr vbxe_putchar           ; preserves X
   415 				        inx
   416 				        cpx #68                    ; max display width
   417 				        bne ?sq
   418 				?sqd    rts
   419 				 .endif
   420
   421 6343			?not_search
   422 				        ; Skip "N:" prefix if present
   423 6343 AD 02 90		        lda url_buffer
   424 6346 C9 4E		        cmp #'N'
   425 6348 D0 0E		        bne ?ns_full
   426 634A AD 03 90		        lda url_buffer+1
   427 634D C9 3A		        cmp #':'
   428 634F D0 07		        bne ?ns_full
   429 6351 A9 04		        lda #<(url_buffer+2)
   430 6353 A2 90		        ldx #>(url_buffer+2)
   431 6355 4C 0E 34		        jmp vbxe_print
   432 6358			?ns_full
   433 6358 A9 02		        lda #<url_buffer
   434 635A A2 90		        ldx #>url_buffer
   435 635C 4C 0E 34		        jmp vbxe_print
   436 635F			?show_bare
   437 				        ; Y = length of proxy prefix, print from url_buffer+Y
   438 635F A2 90		        ldx #>url_buffer
   439 6361 98			        tya
   440 6362 18			        clc
   441 6363 69 02		        adc #<url_buffer
   442 6365 90 01		        bcc ?sb
   443 6367 E8			        inx
   444 6368 4C 0E 34		?sb     jmp vbxe_print
