     1 				; ============================================================================
     2 				; Find in page
     3 				; Ctrl+F opens "Find: " prompt. Scans visible content rows for the typed
     4 				; string (case-insensitive, ASCII). Highlights all matches in yellow.
     5 				; Any key closes find mode and restores original attributes.
     6 				; ============================================================================
     7
     8 = 0010			FIND_MAX_LEN    = 16
     9 = 0010			FIND_MAX_MATCH  = 16
    10 = 0007			FIND_HILITE     = COL_YELLOW
    11
    12 				; Find state in page 5 (free RAM)
    13 = 0500			find_buf         = $0500          ; 16 B search string
    14 = 0510			find_match_row   = $0510          ; 16 B row per match
    15 = 0520			find_match_col   = $0520          ; 16 B col (0..79) per match
    16 = 0530			find_len         = $0530          ; search string length
    17 = 0531			find_count       = $0531          ; number of VIEWPORT matches (highlighted)
    18 = 0532			find_total       = $0532          ; total matches in full page buffer (counted only)
    19 = 0533			find_mpos        = $0533          ; full-scan: partial match position
    20 = 0534			find_intag       = $0534          ; full-scan: inside HTML tag flag
    21 = 0540			find_fold        = $0540          ; 16 B search string, case-folded
    22
    23 				; Saved attributes — packed linearly as matches are processed.
    24 				; For match i we save find_len bytes, running total <= FIND_MAX_MATCH*FIND_MAX_LEN = 256.
    25 = 0700			find_saved       = $0700          ; 256 B in page 7
    26
