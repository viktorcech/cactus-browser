    65 				; ----------------------------------------------------------------------------
    66 				; kbd_get_line - Read a line of text input
    67 				; Input: zp_tmp_ptr = buffer address, X = max length
    68 				; Output: Y = length entered
    69 				;         C=0 confirmed (Enter), C=1 cancelled (Esc)
