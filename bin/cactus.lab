    70 4BCC			.proc html_reset
    71 4BCC A9 00		        lda #0                 ; PS_NORMAL = 0
    72 4BCE 85 8E		        sta zp_parse_state
    73 4BD0 85 8F		        sta zp_tag_idx
    74 4BD2 85 90		        sta zp_attr_idx
    75 4BD4 85 91		        sta zp_val_idx
    76 4BD6 85 92		        sta zp_entity_idx
    77 4BD8 85 9C		        sta zp_in_skip
    78 4BDA 8D 06 50		        sta is_closing
    79 4BDD 8D 07 50		        sta in_title
    80 4BE0 85 A8		        sta in_pre
    81 4BE2 8D 16 58		        sta img_src_len
    82 4BE5 85 9B		        sta utf8_skip
    83 4BE7 8D 08 50		        sta utf8_lead
    84 4BEA 8D 09 50		        sta td_count
    85 4BED 85 98		        sta zp_link_num
    86 4BEF 85 A7		        sta ansi_state
    87 4BF1 8D 0B 51		        sta ansi_bold
    88 4BF4 A9 01		        lda #1
    89 4BF6 8D 0A 50		        sta zp_in_head         ; start in head-skip mode
    90 4BF9 4C E2 4F		        jmp update_emit_skip
    91 				.endp
    92
    93 				; The parse loop and the text path share one page: none of their hot taken
    94 				; branches pays the page-crossing cycle (checked by skill_scan --layout)
    95 4BFC			        .align $100
    96 				; ============================================================================
    97 				; html_process_chunk - main parser loop over rx_buffer[0..zp_rx_len-1]
    98 				; A '<' sentinel at rx_buffer[zp_rx_len] ends the text and skip scans
    99 				; without a length test per byte. A page abort (render_do_nl) cuts
   100 				; zp_rx_len to chunk_idx, so the loop needs no per-byte abort test.
   101 				; ============================================================================
   102 4C00			.proc html_process_chunk
   103 4C00-4DF6> 20 27 4C	        jsr parse_sentinel
   104 4C03 A0 00		        ldy #0
   105 				.endp
   106 				        ; fall through with Y = 0
   107
   108 4C05			parse_loop_y                   ; Y = index of the next byte
   109 4C05 84 99		        sty chunk_idx
   110 4C07			parse_loop_re
   111 4C07 A4 99		        ldy chunk_idx
   112 4C09 C4 A3		        cpy zp_rx_len
   113 4C0B F0 19		        beq parse_chunk_done
   114 4C0D B9 00 81		        lda rx_buffer,y
   115 4C10 C8			        iny
   116 4C11 84 99		        sty chunk_idx
   117 4C13 A6 8E		        ldx zp_parse_state
   118 4C15 F0 2D		        beq parse_normal       ; most bytes: text
   119 4C17 A8			        tay                    ; keep the byte
   120 4C18 BD 36 4C		        lda state_tbl_lo,x
   121 4C1B 85 87		        sta zp_tmp_ptr
   122 4C1D BD 3D 4C		        lda state_tbl_hi,x
   123 4C20 85 88		        sta zp_tmp_ptr+1
   124 4C22 98			        tya
   125 4C23 6C 87 00		        jmp (zp_tmp_ptr)
   126
   127 4C26			parse_chunk_done
   128 4C26 60			        rts
   129
   130 				; parse_sentinel - Put the '<' sentinel after the chunk (rx_buffer[zp_rx_len]);
   131 				; also after anything that reused rx_buffer mid-page (image, find)
   132 4C27			.proc parse_sentinel
   133 4C27 A4 A3		        ldy zp_rx_len
   134 4C29 A9 3C		        lda #'<'
   135 4C2B 99 00 81		        sta rx_buffer,y
   136 4C2E 60			        rts
   137 				.endp
   138
   139 				; Shared exit: reset parse state to PS_NORMAL and resume main loop
   140 4C2F			reset_parse_and_loop
   141 4C2F A9 00		        lda #0                 ; PS_NORMAL
   142 4C31 85 8E		        sta zp_parse_state
   143 4C33 4C 07 4C		        jmp parse_loop_re
   144
   145 4C36			state_tbl_lo
   146 4C36 44			        dta <parse_normal      ; 0 PS_NORMAL
   147 4C37 68			        dta <parse_tag         ; 1 PS_IN_TAG
   148 4C38 5E			        dta <parse_entity      ; 2 PS_IN_ENTITY
   149 4C39 00			        dta <parse_attrname    ; 3 PS_IN_ATTRNAME
   150 4C3A 5E			        dta <parse_attrval     ; 4 PS_IN_ATTRVAL
   151 4C3B FB			        dta <parse_skipmode    ; 5 PS_SKIP_TAG
   152 4C3C 24			        dta <parse_comment     ; 6 PS_IN_COMMENT
   153 4C3D			state_tbl_hi
   154 4C3D 4C			        dta >parse_normal
   155 4C3E 4D			        dta >parse_tag
   156 4C3F 4F			        dta >parse_entity
   157 4C40 4E			        dta >parse_attrname
   158 4C41 4E			        dta >parse_attrval
   159 4C42 4E			        dta >parse_skipmode
   160 4C43 4F			        dta >parse_comment
   161
   162 				; --- Normal text ---
   163 				; A = byte, chunk_idx = index after it. Plain bytes (char_class 0) outside
   164 				; UTF-8 sequences go to the word buffer in a tight run (?run); the rest
   165 				; takes the full path below.
   166 4C44			.proc parse_normal
   167 4C44 AA			        tax
   168 4C45 BD 00 80		        lda char_class,x
   169 4C48 F0 5F		        beq ?plain             ; class 0: word run / skip (below)
   170
   171 4C4A 8A			        txa                    ; '<', '&', <= $20, >= $C0
   172 4C4B C9 3C		        cmp #'<'
   173 4C4D F0 30		        beq ?start_tag
   174 4C4F C9 26		        cmp #'&'
   175 4C51 F0 4D		        beq ?t_ent             ; rare cases: short branches to jmp stubs,
   176 4C53 A6 9B		        ldx utf8_skip          ; so the common path never pays a taken
   177 4C55 D0 4C		        bne ?t_cont            ; branch over a jmp (MADS jcc long form)
   178 4C57 C9 C0		        cmp #$C0               ; UTF-8 lead byte?
   179 4C59 B0 4B		        bcs ?t_lead
   180
   181 				        ; byte <= $20: plain mode sends space / CR / LF / TAB straight to
   182 				        ; the word-space path (what html_emit_char + render_char would do)
   183 4C5B A6 BE		        ldx emit_slow
   184 4C5D D0 16		        bne ?ascii
   185 4C5F C9 20		        cmp #CH_SPACE
   186 4C61 F0 0C		        beq ?space
   187 4C63 C9 0D		        cmp #13
   188 4C65 F0 08		        beq ?space
   189 4C67 C9 0A		        cmp #10
   190 4C69 F0 04		        beq ?space
   191 4C6B C9 09		        cmp #9
   192 4C6D D0 0A		        bne ?emit
   193 4C6F 20 9C 5B		?space  jsr render_space
   194 4C72 4C 07 4C		        jmp parse_loop_re
   195
   196 4C75 A6 9A		?ascii  ldx emit_skip          ; combined flag: skips the jsr entirely
   197 4C77 D0 03		        bne ?jlp               ; during head/script/heading/fragment skip
   198 4C79 20 AE 4F		?emit   jsr html_emit_char_ns
   199 4C7C 4C 07 4C		?jlp    jmp parse_loop_re
   200
   201 4C7F			?start_tag
   202 4C7F A9 01		        lda #PS_IN_TAG
   203 4C81 85 8E		        sta zp_parse_state
   204 4C83 A9 00		        lda #0
   205 4C85 85 8F		        sta zp_tag_idx
   206 4C87 85 90		        sta zp_attr_idx
   207 4C89 85 91		        sta zp_val_idx
   208 4C8B 8D 06 50		        sta is_closing
   209 4C8E 8D 16 58		        sta img_src_len
   210 				        ; next byte straight into parse_tag (no dispatch)
   211 4C91 A4 99		        ldy chunk_idx
   212 4C93 C4 A3		        cpy zp_rx_len
   213 4C95 F0 E5		        beq ?jlp
   214 4C97 B9 00 81		        lda rx_buffer,y
   215 4C9A C8			        iny
   216 4C9B 84 99		        sty chunk_idx
   217 4C9D 4C 68 4D		        jmp parse_tag
   218
   219 4CA0 4C 5C 4D		?t_ent  jmp ?start_ent
   220 4CA3 4C 1E 4D		?t_cont jmp ?utf8_cont
   221 4CA6 4C 32 4D		?t_lead jmp ?lead
   222
   223 				        ; --- class 0: plain text byte ---
   224 4CA9 05 9B		?plain  ora utf8_skip          ; A = utf8_skip
   225 4CAB D0 70		        bne ?cont_x            ; UTF-8 continuation byte
   226 4CAD 05 BE		        ora emit_slow
   227 4CAF D0 54		        bne ?slow_x            ; skip / ANSI / pre / title mode
   228 4CB1 A4 99		        ldy chunk_idx
   229 4CB3 88			        dey                    ; Y = this byte (class 0, so the run takes it)
   230
   231 				        ; Word run: room = 79 - word_len (0 -> the byte is dropped)
   232 4CB4 A9 4F		        lda #WORD_BUF_SZ-1
   233 4CB6 38			        sec
   234 4CB7 E5 95		        sbc zp_word_len
   235 4CB9 F0 46		        beq ?full_y
   236 4CBB 8C 67 4D		        sty ?y0
   237 4CBE 18			        clc
   238 4CBF 6D 67 4D		        adc ?y0                ; limit = Y + room
   239 4CC2 90 02		        bcc ?lim_ok
   240 4CC4 A9 00		        lda #0                 ; beyond 255: the sentinel ends the run first
   241 4CC6 8D F1 4C		?lim_ok sta ?lim+1
   242 4CC9 A5 95		        lda zp_word_len        ; store base = word_buf + word_len - Y
   243 4CCB 18			        clc
   244 4CCC 69 80		        adc #<word_buf
   245 4CCE AA			        tax
   246 4CCF A9 82		        lda #>word_buf
   247 4CD1 69 00		        adc #0
   248 4CD3 8D EE 4C		        sta ?st+2
   249 4CD6 8A			        txa
   250 4CD7 38			        sec
   251 4CD8 ED 67 4D		        sbc ?y0
   252 4CDB 8D ED 4C		        sta ?st+1
   253 4CDE B0 03		        bcs ?run
   254 4CE0 CE EE 4C		        dec ?st+2
   255 4CE3 BE 00 81		?run    ldx rx_buffer,y
   256 4CE6 BD 00 80		        lda char_class,x
   257 4CE9 D0 09		        bne ?stop
   258 4CEB 8A			        txa
   259 4CEC 99 FF FF		?st     sta $FFFF,y            ; word_buf[word_len + Y - y0]
   260 4CEF C8			        iny
   261 4CF0 C0 00		?lim    cpy #0
   262 4CF2 D0 EF		        bne ?run
   263 				        ert >?run <> >*         ; hot loop: keep it in one page
   264 4CF4 98			?stop   tya                    ; word_len += Y - y0
   265 4CF5 38			        sec
   266 4CF6 ED 67 4D		        sbc ?y0
   267 4CF9 18			        clc
   268 4CFA 65 95		        adc zp_word_len
   269 4CFC 85 95		        sta zp_word_len
   270 4CFE 4C 05 4C		        jmp parse_loop_y
   271
   272 4D01 C8			?full_y iny                    ; word full: the byte is dropped (last_was_sp
   273 4D02 4C 05 4C		        jmp parse_loop_y       ; only counts at word_len 0)
   274
   275 4D05 8A			?slow_x txa
   276 4D06 A6 9A		        ldx emit_skip
   277 4D08 D0 03 4C 79 4C	        jeq ?emit              ; ANSI / pre / title: full emit path
   278 				        ; skipped text: consume plain bytes without a jsr
   279 4D0D A4 99		        ldy chunk_idx
   280 4D0F BE 00 81		?skip   ldx rx_buffer,y
   281 4D12 BD 00 80		        lda char_class,x
   282 4D15 D0 03		        bne ?sk_end
   283 4D17 C8			        iny
   284 4D18 D0 F5		        bne ?skip              ; always: the sentinel stops it
   285 				        ert >?skip <> >*         ; hot loop: keep it in one page
   286 4D1A 4C 05 4C		?sk_end jmp parse_loop_y
   287
   288 4D1D 8A			?cont_x txa
   289 4D1E			?utf8_cont
   290 4D1E C6 9B		        dec utf8_skip
   291 4D20 D0 0D		        bne ?jlp2               ; more continuation bytes to skip
   292 				        ; Last continuation byte -- try transliteration
   293 4D22 AE 08 50		        ldx utf8_lead
   294 4D25 F0 08		        beq ?jlp2               ; no lead saved (3/4-byte), skip
   295 4D27 20 2C 50		        jsr utf8_xlat           ; A=cont byte, X=lead -> A=ascii or 0
   296 4D2A F0 03 4C 75 4C	        jne ?ascii              ; 0 = no mapping, skip
   297 4D2F 4C 07 4C		?jlp2   jmp parse_loop_re
   298
   299 4D32			?lead   ; UTF-8 transliteration: 2-byte ($C0-$DF lead + 1 cont),
   300 				        ; 3-byte ($E0-$EF + 2), 4-byte ($F0+ + 3)
   301 4D32 C9 E0		        cmp #$E0               ; 3-byte UTF-8 lead (E0-EF)?
   302 4D34 90 10		        bcc ?utf2
   303 4D36 C9 F0		        cmp #$F0               ; 4-byte UTF-8 lead (F0-F7)?
   304 4D38 90 16		        bcc ?utf3
   305 4D3A A9 03		        lda #3                 ; >= F0: skip 3 continuation bytes
   306 4D3C 85 9B		        sta utf8_skip
   307 4D3E A9 00		        lda #0
   308 4D40 8D 08 50		        sta utf8_lead
   309 4D43 4C 07 4C		        jmp parse_loop_re
   310 4D46			?utf2   ; 2-byte UTF-8 lead - save for transliteration lookup
   311 4D46 8D 08 50		        sta utf8_lead
   312 4D49 A9 01		        lda #1
   313 4D4B 85 9B		        sta utf8_skip
   314 4D4D 4C 07 4C		        jmp parse_loop_re
   315 4D50 A9 02		?utf3   lda #2
   316 4D52 85 9B		        sta utf8_skip
   317 4D54 A9 00		        lda #0
   318 4D56 8D 08 50		        sta utf8_lead           ; no transliteration for 3-byte sequences
   319 4D59 4C 07 4C		        jmp parse_loop_re
   320
   321 4D5C			?start_ent
   322 4D5C A9 02		        lda #PS_IN_ENTITY
   323 4D5E 85 8E		        sta zp_parse_state
   324 4D60 A9 00		        lda #0
   325 4D62 85 92		        sta zp_entity_idx
   326 4D64 4C 07 4C		        jmp parse_loop_re
   327
   328 4D67 00			?y0     dta 0
   329 				.endp
   330
   331 				; --- Inside tag name ---
   332 				; Collects the name in a local loop until '>' or white space; '/' counts
   333 				; only as the first byte, "!--" as the first three switch to comment mode.
   334 4D68			.proc parse_tag
   335 4D68 A6 8F		        ldx zp_tag_idx
   336 4D6A D0 0C		        bne ?chr
   337 4D6C C9 2F		        cmp #'/'
   338 4D6E D0 08		        bne ?chr
   339 4D70 A9 01		        lda #1
   340 4D72 8D 06 50		        sta is_closing
   341 4D75 4C 07 4C		        jmp parse_loop_re
   342
   343 4D78 A4 99		?chr    ldy chunk_idx          ; X = tag_idx, Y = next index
   344 4D7A C9 3E		?lp     cmp #'>'
   345 4D7C F0 6A		        beq ?end
   346 4D7E C9 20		        cmp #CH_SPACE
   347 4D80 F0 54		        beq ?2attr
   348 4D82 C9 0A		        cmp #10
   349 4D84 F0 50		        beq ?2attr
   350 4D86 C9 0D		        cmp #13
   351 4D88 F0 4C		        beq ?2attr
   352 4D8A E0 0F		        cpx #TAG_BUF_SIZE-1
   353 4D8C B0 12		        bcs ?next              ; buffer full: drop
   354 				 .if 1                          ; 2026-09-23 (6502-idioms: to lower: the common lowercase byte (> 'Z') leaves on the
   355 				                                ; first compare, 5 cycles instead of 9; same result for every byte)
   356 4D8E C9 5B		        cmp #'Z'+1             ; to lower
   357 4D90 B0 06		        bcs ?st
   358 4D92 C9 41		        cmp #'A'
   359 4D94 90 02		        bcc ?st
   360 4D96 09 20		        ora #$20
   361 4D98 9D 9D 51		?st     sta tag_name_buf,x
   362 				 .else
   363 				        cmp #'A'               ; to lower
   364 				        bcc ?st
   365 				        cmp #'Z'+1
   366 				        bcs ?st
   367 				        ora #$20
   368 				?st     sta tag_name_buf,x
   369 				 .endif
   370 4D9B E8			        inx
   371 4D9C E0 03		        cpx #3
   372 4D9E F0 11		        beq ?chk3
   373 4DA0 C4 A3		?next   cpy zp_rx_len
   374 4DA2 F0 06		        beq ?out
   375 4DA4 B9 00 81		        lda rx_buffer,y
   376 4DA7 C8			        iny
   377 4DA8 D0 D0		        bne ?lp                ; always (Y <= 255)
   378 				        ert >?lp <> >*         ; hot loop: keep it in one page
   379
   380 4DAA 86 8F		?out    stx zp_tag_idx         ; chunk exhausted mid-name
   381 4DAC 84 99		        sty chunk_idx
   382 4DAE 4C 07 4C		        jmp parse_loop_re
   383
   384 4DB1 AD 9D 51		?chk3   lda tag_name_buf       ; "!--" = HTML comment
   385 4DB4 C9 21		        cmp #'!'
   386 4DB6 D0 E8		        bne ?next
   387 4DB8 AD 9E 51		        lda tag_name_buf+1
   388 4DBB C9 2D		        cmp #'-'
   389 4DBD D0 E1		        bne ?next
   390 4DBF AD 9F 51		        lda tag_name_buf+2
   391 4DC2 C9 2D		        cmp #'-'
   392 4DC4 D0 DA		        bne ?next
   393 4DC6 86 8F		        stx zp_tag_idx
   394 4DC8 84 99		        sty chunk_idx
   395 4DCA A9 06		        lda #PS_IN_COMMENT
   396 4DCC 85 8E		        sta zp_parse_state
   397 4DCE A9 00		        lda #0
   398 4DD0 8D 5D 4F		        sta comment_dashes
   399 4DD3 4C 07 4C		        jmp parse_loop_re
   400
   401 4DD6 86 8F		?2attr  stx zp_tag_idx
   402 4DD8 84 99		        sty chunk_idx
   403 4DDA A9 00		        lda #0
   404 4DDC 9D 9D 51		        sta tag_name_buf,x
   405 4DDF 85 90		        sta zp_attr_idx
   406 4DE1 A9 03		        lda #PS_IN_ATTRNAME
   407 4DE3 85 8E		        sta zp_parse_state
   408 4DE5 4C 07 4C		        jmp parse_loop_re
   409
   410 4DE8 86 8F		?end    stx zp_tag_idx
   411 4DEA 84 99		        sty chunk_idx
   412 4DEC A9 00		        lda #0
   413 4DEE 9D 9D 51		        sta tag_name_buf,x
   414 4DF1 20 00 53		        jsr process_tag
   415 4DF4 4C 2F 4C		        jmp reset_parse_and_loop
   416 				.endp
   417
   418 4DF7			        .align $100            ; keep the attr-name loop in one page
   419 				; --- Attribute name --- (white space is skipped, the name continues)
   420 4E00			.proc parse_attrname
   421 4E00-500B> A6 90		        ldx zp_attr_idx
   422 4E02 A4 99		        ldy chunk_idx
   423 4E04 C9 3E		?lp     cmp #'>'
   424 4E06 F0 47		        beq ?end_tag
   425 4E08 C9 3D		        cmp #'='
   426 4E0A F0 2F		        beq ?2val
   427 4E0C C9 20		        cmp #CH_SPACE
   428 4E0E F0 1A		        beq ?next
   429 4E10 C9 0A		        cmp #10
   430 4E12 F0 16		        beq ?next
   431 4E14 C9 0D		        cmp #13
   432 4E16 F0 12		        beq ?next
   433 4E18 E0 0F		        cpx #ATTR_BUF_SIZE-1
   434 4E1A B0 0E		        bcs ?next
   435 				 .if 1                          ; 2026-09-23 (6502-idioms: to lower: the common lowercase byte (> 'Z') leaves on the
   436 				                                ; first compare, 5 cycles instead of 9; same result for every byte)
   437 4E1C C9 5B		        cmp #'Z'+1             ; to lower
   438 4E1E B0 06		        bcs ?st
   439 4E20 C9 41		        cmp #'A'
   440 4E22 90 02		        bcc ?st
   441 4E24 09 20		        ora #$20
   442 4E26 9D AD 51		?st     sta attr_name_buf,x
   443 				 .else
   444 				        cmp #'A'               ; to lower
   445 				        bcc ?st
   446 				        cmp #'Z'+1
   447 				        bcs ?st
   448 				        ora #$20
   449 				?st     sta attr_name_buf,x
   450 				 .endif
   451 4E29 E8			        inx
   452 4E2A C4 A3		?next   cpy zp_rx_len
   453 4E2C F0 06		        beq ?out
   454 4E2E B9 00 81		        lda rx_buffer,y
   455 4E31 C8			        iny
   456 4E32 D0 D0		        bne ?lp                ; always
   457 				        ert >?lp <> >*         ; hot loop: keep it in one page
   458
   459 4E34 86 90		?out    stx zp_attr_idx
   460 4E36 84 99		        sty chunk_idx
   461 4E38 4C 07 4C		        jmp parse_loop_re
   462
   463 4E3B 86 90		?2val   stx zp_attr_idx
   464 4E3D 84 99		        sty chunk_idx
   465 4E3F A9 00		        lda #0
   466 4E41 9D AD 51		        sta attr_name_buf,x
   467 4E44 85 91		        sta zp_val_idx
   468 4E46 85 AA		        sta in_quotes
   469 4E48 A9 04		        lda #PS_IN_ATTRVAL
   470 4E4A 85 8E		        sta zp_parse_state
   471 4E4C 4C 07 4C		        jmp parse_loop_re
   472
   473 4E4F			?end_tag
   474 4E4F 86 90		        stx zp_attr_idx
   475 4E51 84 99		        sty chunk_idx
   476 4E53 A9 00		        lda #0
   477 4E55 9D AD 51		        sta attr_name_buf,x
   478 4E58 20 00 53		        jsr process_tag
   479 4E5B 4C 2F 4C		        jmp reset_parse_and_loop
   480 				.endp
