    12 				; ----------------------------------------------------------------------------
    13 				; calc_scr_ptr - Calculate screen pointer for cursor position
    14 				; ----------------------------------------------------------------------------
    15 32D1			.proc calc_scr_ptr
    16 				 .if 1                          ; 2026-09-23 (6502-idioms: compute in A, store once): col*2 added
    17 				                                ; to the row low byte in A, no inc in memory; asl of col <= 79 leaves C = 0
    18 32D1 A6 82		        ldx zp_cursor_row
    19 32D3 A5 83		        lda zp_cursor_col
    20 32D5 0A			        asl                    ; col <= 79: C = 0
    21 32D6 7D 97 32		        adc row_addr_lo,x
    22 32D9 85 85		        sta zp_scr_ptr
    23 32DB BD B4 32		        lda row_addr_hi,x
    24 32DE 69 00		        adc #0
    25 32E0 85 86		        sta zp_scr_ptr+1
    26 32E2 60			        rts
    27 				 .else
    28 				        ldx zp_cursor_row
    29 				        lda row_addr_lo,x
    30 				        sta zp_scr_ptr
    31 				        lda row_addr_hi,x
    32 				        sta zp_scr_ptr+1
    33 				        lda zp_cursor_col
    34 				        asl
    35 				        clc
    36 				        adc zp_scr_ptr
    37 				        sta zp_scr_ptr
    38 				        bcc ?ok
    39 				        inc zp_scr_ptr+1
    40 				?ok     rts
    41 				 .endif
    42 				.endp
