   587 				; ----------------------------------------------------------------------------
   588 				; Compact images (vbxe.php &c=1): the converter sends only the image's own
   589 				; width w (<= 320) instead of black-padded 320-byte rows, so narrow images
   590 				; cross SIO in fewer bytes. The rows stream to the END of the image area
   591 				; (img_stage) and one blit list moves them to centred 320-byte rows and
   592 				; blacks the margins (img_center). The move runs forward with every
   593 				; destination below its source, so no unread byte is overwritten.
   594 				; ----------------------------------------------------------------------------
   595 = 0140			IMG_ROW   = 320
   596
   597 69E6			.proc img_stage
   598 69E6 20 0A 6A		        jsr img_margin         ; m = 320 - w (0: full width, nothing to do)
   599 69E9 F0 1E		        beq ?done
   600 				        ; img_vram = VRAM_IMG_BASE + h * m (24-bit)
   601 69EB AE 14 65		        ldx img_hdr_h
   602 69EE AD 0A 3A		?mul    lda img_vram
   603 69F1 18			        clc
   604 69F2 6D 27 6B		        adc img_m
   605 69F5 8D 0A 3A		        sta img_vram
   606 69F8 AD 0B 3A		        lda img_vram+1
   607 69FB 6D 28 6B		        adc img_m+1
   608 69FE 8D 0B 3A		        sta img_vram+1
   609 6A01 90 03		        bcc ?nc
   610 6A03 EE 0C 3A		        inc img_vram+2
   611 6A06 CA			?nc     dex
   612 6A07 D0 E5		        bne ?mul
   613 6A09 60			?done   rts
   614 				.endp
   615
   616 				; img_m = 320 - img_hdr_w; Z=1 when 0
   617 6A0A			.proc img_margin
   618 6A0A A9 40		        lda #<IMG_ROW
   619 6A0C 38			        sec
   620 6A0D ED 12 65		        sbc img_hdr_w
   621 6A10 8D 27 6B		        sta img_m
   622 6A13 A9 01		        lda #>IMG_ROW
   623 6A15 ED 13 65		        sbc img_hdr_w+1
   624 6A18 8D 28 6B		        sta img_m+1
   625 6A1B 0D 27 6B		        ora img_m
   626 6A1E 60			        rts
   627 				.endp
   628
   629 6A1F			.proc img_center
   630 6A1F AD 0A 3A		        lda img_vram           ; source = the staged rows
   631 6A22 8D E8 6A		        sta ?b_src
   632 6A25 AD 0B 3A		        lda img_vram+1
   633 6A28 8D E9 6A		        sta ?b_src+1
   634 6A2B AD 0C 3A		        lda img_vram+2
   635 6A2E 8D EA 6A		        sta ?b_src+2
   636 6A31 A9 00		        lda #<VRAM_IMG_BASE    ; the image is shown from the base again
   637 6A33 8D 0A 3A		        sta img_vram
   638 6A36 A9 30		        lda #>VRAM_IMG_BASE
   639 6A38 8D 0B 3A		        sta img_vram+1
   640 6A3B A9 00		        lda #0
   641 6A3D 8D 0C 3A		        sta img_vram+2
   642 6A40 20 0A 6A		        jsr img_margin
   643 6A43 D0 03 4C E5 6A	        jeq ?done
   644
   645 				        ; left = m / 2, right = m - left (>= 1)
   646 6A48 AD 28 6B		        lda img_m+1
   647 6A4B 4A			        lsr
   648 6A4C AD 27 6B		        lda img_m
   649 6A4F 6A			        ror
   650 6A50 8D E6 6A		        sta ?left              ; m <= 312: left <= 156
   651 6A53 AD 27 6B		        lda img_m
   652 6A56 38			        sec
   653 6A57 ED E6 6A		        sbc ?left
   654 6A5A 8D E7 6A		        sta ?right             ; right <= 156 (8-bit)
   655
   656 				        ; BCB 1: move w x h, source step w, dest step 320, dest base+left
   657 6A5D AD 12 65		        lda img_hdr_w
   658 6A60 8D EB 6A		        sta ?b_sstep
   659 6A63 38			        sec
   660 6A64 E9 01		        sbc #1
   661 6A66 8D F4 6A		        sta ?b_w1
   662 6A69 AD 13 65		        lda img_hdr_w+1
   663 6A6C 8D EC 6A		        sta ?b_sstep+1
   664 6A6F E9 00		        sbc #0
   665 6A71 8D F5 6A		        sta ?b_w1+1
   666 6A74 AE 14 65		        ldx img_hdr_h
   667 6A77 CA			        dex
   668 6A78 8E F6 6A		        stx ?b_h1
   669 6A7B 8E 0B 6B		        stx ?r_h1
   670 6A7E 8E 20 6B		        stx ?l_h1
   671 6A81 A9 00		        lda #<VRAM_IMG_BASE
   672 6A83 18			        clc
   673 6A84 6D E6 6A		        adc ?left
   674 6A87 8D EE 6A		        sta ?b_dst
   675 6A8A A9 30		        lda #>VRAM_IMG_BASE
   676 6A8C 69 00		        adc #0
   677 6A8E 8D EF 6A		        sta ?b_dst+1
   678 				        ; BCB 2: right margin at base + left + w, width right
   679 6A91 AD EE 6A		        lda ?b_dst
   680 6A94 18			        clc
   681 6A95 6D 12 65		        adc img_hdr_w
   682 6A98 8D 03 6B		        sta ?r_dst
   683 6A9B AD EF 6A		        lda ?b_dst+1
   684 6A9E 6D 13 65		        adc img_hdr_w+1
   685 6AA1 8D 04 6B		        sta ?r_dst+1
   686 6AA4 AE E7 6A		        ldx ?right
   687 6AA7 CA			        dex
   688 6AA8 8E 09 6B		        stx ?r_w1
   689 				        ; BCB 3: left margin at base, width left (chained only if left > 0)
   690 6AAB A9 00		        lda #0                 ; no left margin: the list ends at BCB 2
   691 6AAD AE E6 6A		        ldx ?left
   692 6AB0 F0 06		        beq ?noleft
   693 6AB2 CA			        dex
   694 6AB3 8E 1E 6B		        stx ?l_w1
   695 6AB6 A9 08		        lda #8                 ; chain on
   696 6AB8 8D 11 6B		?noleft sta ?r_ctl             ; A = 0 when left = 0: the list ends here
   697
   698 				        ; Copy the 3 BCBs to VRAM through the image writer, then run them
   699 6ABB A2 3E		        ldx #?bcb_len-1
   700 6ABD BD E8 6A		?cp     lda ?bcb,x
   701 6AC0 9D 00 88		        sta img_big_buf,x
   702 6AC3 CA			        dex
   703 6AC4 10 F7		        bpl ?cp
   704 6AC6 A9 3F		        lda #?bcb_len
   705 6AC8 8D 00 90		        sta img_chunk_lo
   706 6ACB A9 00		        lda #0
   707 6ACD 8D 01 90		        sta img_chunk_hi
   708 6AD0 8D 0D 3A		        sta img_wr_bank        ; VRAM_IMG_BCB is in bank 0
   709 6AD3 A9 80		        lda #<(MEMB_BASE + VRAM_IMG_BCB)
   710 6AD5 85 AB		        sta zp_img_ptr
   711 6AD7 A9 54		        lda #>(MEMB_BASE + VRAM_IMG_BCB)
   712 6AD9 85 AC		        sta zp_img_ptr+1
   713 6ADB 20 5D 3A		        jsr vbxe_img_write_big
   714 6ADE A9 80		        lda #<VRAM_IMG_BCB     ; started, not waited for: palette and
   715 6AE0 A2 14		        ldx #>VRAM_IMG_BCB     ; status bar go on meanwhile (the next
   716 6AE2 4C 76 34		        jmp blit_go            ; blit_run waits for it first)
   717 6AE5 60			?done   rts
   718
   719 6AE6 00			?left   dta 0
   720 6AE7 00			?right  dta 0
   721 6AE8			?bcb
   722 				        ; move: staged rows -> centred rows
   723 6AE8 00 00 00		?b_src  dta 0, 0, 0
   724 6AEB 00 00		?b_sstep dta a(0)              ; source step Y = w
   725 6AED 01			        dta 1
   726 6AEE 00 00 00		?b_dst  dta 0, 0, 0
   727 6AF1 40 01		        dta a(IMG_ROW)
   728 6AF3 01			        dta 1
   729 6AF4 00 00		?b_w1   dta a(0)               ; width - 1 = w - 1
   730 6AF6 00			?b_h1   dta 0
   731 6AF7 FF 00 00 00 00	        dta $FF, $00, $00, 0, $00
   732 6AFC 08			        dta $08                ; chain
   733 				        ; right margin: black
   734 6AFD 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0
   735 6B03 00 00 00		?r_dst  dta 0, 0, 0
   736 6B06 40 01		        dta a(IMG_ROW)
   737 6B08 01			        dta 1
   738 6B09 00 00		?r_w1   dta a(0)
   739 6B0B 00			?r_h1   dta 0
   740 6B0C 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00   ; AND 0, XOR = colour: fill
   741 6B11 08			?r_ctl  dta $08
   742 				        ; left margin: black
   743 6B12 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0
   744 6B18 00 30 00		        dta <VRAM_IMG_BASE, >VRAM_IMG_BASE, 0
   745 6B1B 40 01		        dta a(IMG_ROW)
   746 6B1D 01			        dta 1
   747 6B1E 00 00		?l_w1   dta a(0)
   748 6B20 00			?l_h1   dta 0
   749 6B21 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00
   750 6B26 00			        dta $00
   751 = 003F			?bcb_len = * - ?bcb
   752 				        ert VRAM_IMG_BCB + ?bcb_len > VRAM_FONT
   753 				.endp
   754
   755 6B27 00 00		img_m   dta a(0)
