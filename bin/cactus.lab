   482 				; --- Parser state save area for img_fetch during --More-- ---
   483 				; img_fetch_single clobbers ZP, rx_buffer, and status_msg overwrites attr.
   484 				; After image view, VRAM is rewound and chunk re-read, parser resumes exactly.
   485 5EB8 00			rpp_link_num    dta 0              ; link number of clicked IMG link
   486 5EB9 00			rpp_saved_cidx  dta 0              ; saved chunk_idx (parser position in rx_buffer)
   487 5EBA 00			rpp_saved_rxlen dta 0              ; saved zp_rx_len (chunk size for re-read)
   488 5EBB 00			rpp_saved_quotes dta 0             ; saved in_quotes (parser mid-attribute state)
   489 5EBC 00			rpp_saved_closing dta 0            ; saved is_closing (parser mid-tag state)
   490 = 5EBD			rpp_state_buf   .ds 15             ; bulk save: ZP $84-$92 (cur_attr..entity_idx)
   491 				.endp
