   264 6691 8D 2F 67		        sta img_left+1
   265 6694 90 03		        bcc ?m1
   266 6696 EE 30 67		        inc img_left+2
   267 6699 CA			?m1     dex
   268 669A D0 E5		        bne ?mul
   269 669C AD 2E 67		        lda img_left
   270 669F 38			        sec
   271 66A0 ED 18 65		        sbc img_pal_leftover
   272 66A3 8D 2E 67		        sta img_left
   273 66A6 B0 0B		        bcs ?m2
   274 66A8 AD 2F 67		        lda img_left+1
   275 66AB D0 03		        bne ?m3
   276 66AD CE 30 67		        dec img_left+2
   277 66B0 CE 2F 67		?m3     dec img_left+1
   278 66B3			?m2
