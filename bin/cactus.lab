     1 				; ============================================================================
     2 				; HTML Parser Module - Streamovy byte-by-byte parser
     3 				; Tag handlers in html_tags.asm, entity decode in html_entities.asm
     4 				; ============================================================================
     5
     6 				; Parser states
     7 = 0000			PS_NORMAL      = 0
     8 = 0001			PS_IN_TAG      = 1
     9 = 0002			PS_IN_ENTITY   = 2
    10 = 0003			PS_IN_ATTRNAME = 3
    11 = 0004			PS_IN_ATTRVAL  = 4
    12 = 0005			PS_SKIP_TAG    = 5
    13 = 0006			PS_IN_COMMENT  = 6
    14
    15 				; Tag IDs
    16 = 0000			TAG_UNKNOWN    = 0
    17 = 0001			TAG_H1         = 1
    18 = 0002			TAG_H2         = 2
    19 = 0003			TAG_H3         = 3
    20 = 0004			TAG_P          = 4
    21 = 0005			TAG_BR         = 5
    22 = 0006			TAG_A          = 6
    23 = 0007			TAG_UL         = 7
    24 = 0008			TAG_OL         = 8
    25 = 0009			TAG_LI         = 9
    26 = 000A			TAG_B          = 10
    27 = 000B			TAG_STRONG     = 11
    28 = 000C			TAG_I          = 12
    29 = 000D			TAG_EM         = 13
    30 = 000E			TAG_TITLE      = 14
    31 = 000F			TAG_SCRIPT     = 15
    32 = 0010			TAG_STYLE      = 16
    33 = 0011			TAG_IMG        = 17
    34 = 0012			TAG_INPUT      = 18
    35 = 0013			TAG_FORM       = 19
    36 = 0014			TAG_DIV        = 20
    37 = 0015			TAG_SPAN       = 21
    38 = 0016			TAG_PRE        = 22
    39 = 0017			TAG_HR         = 23
    40 = 0018			TAG_NOSCRIPT   = 24
    41 = 0019			TAG_TABLE      = 25
    42 = 001A			TAG_TR         = 26
    43 = 001B			TAG_TD         = 27
    44 = 001C			TAG_TH         = 28
    45 = 001D			TAG_BLOCKQUOTE = 29
    46 = 001E			TAG_DT         = 30
    47 = 001F			TAG_DD         = 31
    48 = 0020			TAG_CODE       = 32
    49 = 0021			TAG_HEAD       = 33
    50 = 0022			TAG_BODY       = 34
    51 = 0023			TAG_H4         = 35
    52 = 0024			TAG_H5         = 36
    53 = 0025			TAG_H6         = 37
    54 = 0026			TAG_U          = 38
    55 = 0027			TAG_SUP        = 39
    56 = 0028			TAG_SUB        = 40
    57 = 0029			TAG_NAV        = 41
    58 = 002A			TAG_ARTICLE    = 42
    59 = 002B			TAG_SECTION    = 43
    60 = 002C			TAG_ASIDE      = 44
    61 = 002D			TAG_HEADER     = 45
    62 = 002E			TAG_FOOTER     = 46
    63 = 002F			TAG_MAIN       = 47
    64
    65 = 0010			TAG_BUF_SIZE   = 16
    66 = 0010			ATTR_BUF_SIZE  = 16
