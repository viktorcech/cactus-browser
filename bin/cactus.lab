   608 				; process_attr
   609 				; ============================================================================
   610 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: the "href" test and its branches to ?chk_src
   611 				                                ; in one page)
   612 55F0			        page_fit 0, process_attr.chk_src-process_attr+1
Macro: PAGE_FIT [Source: vbxe_const.asm]
