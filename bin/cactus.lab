   281
   282 66B8 AD 2E 67		?lp     lda img_left           ; whole image received: done
   283 66BB 0D 2F 67		        ora img_left+1
   284 66BE 0D 30 67		        ora img_left+2
   285 66C1 F0 67		        beq ?done
   286 66C3 20 19 65		        jsr img_check_abort
   287 66C6 B0 64		        bcs ?err
