   339 				; ----------------------------------------------------------------------------
   340 				; mouse_hide_cursor - Remove cursor before screen updates
   341 				; ----------------------------------------------------------------------------
   342 6D92			.proc mouse_hide_cursor
   343 6D92 A5 B6		        lda zp_mouse_prev_x
   344 6D94 C9 FF		        cmp #$FF
   345 6D96 F0 0B		        beq ?done
   346 6D98 A5 B7		        lda zp_mouse_prev_y
   347 6D9A A6 B6		        ldx zp_mouse_prev_x
   348 6D9C 20 BD 6D		        jsr mouse_restore_char
   349 6D9F A9 FF		        lda #$FF
   350 6DA1 85 B6		        sta zp_mouse_prev_x    ; mark as restored, prevent double restore
   351 6DA3 60			?done   rts
   352 				.endp
