   302 				; ----------------------------------------------------------------------------
   303 				; mouse_show_cursor - Update cursor on screen (call from main loop)
   304 				; ----------------------------------------------------------------------------
   305 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: the whole proc in one page, the taken
   306 				                                ; branches do not cross)
   307 6D65			        page_fit 0, mouse_show_cursor.pend-mouse_show_cursor
Macro: PAGE_FIT [Source: vbxe_const.asm]
     2 = 6D65			?pf_s   = * + 0
Source: mouse.asm
   308 				 .endif
   309 6D65			.proc mouse_show_cursor
   310 6D65 A5 B6		        lda zp_mouse_prev_x
   311 6D67 C5 B0		        cmp zp_mouse_x
   312 6D69 D0 06		        bne ?moved
   313 6D6B A5 B7		        lda zp_mouse_prev_y
   314 6D6D C5 B1		        cmp zp_mouse_y
   315 6D6F F0 20		        beq ?done
   316 6D71			?moved
   317 6D71 A9 FF		        lda #$FF
   318 6D73 85 BC		        sta zp_tab_link        ; mouse movement clears TAB selection
   319 				        ; Skip restore if prev_x=$FF (invalid — screen was redrawn)
   320 6D75 A5 B6		        lda zp_mouse_prev_x
   321 6D77 C9 FF		        cmp #$FF
   322 6D79 F0 07		        beq ?no_restore
   323 6D7B A5 B7		        lda zp_mouse_prev_y
   324 6D7D A6 B6		        ldx zp_mouse_prev_x
   325 6D7F 20 BD 6D		        jsr mouse_restore_char
   326 6D82			?no_restore
   327 6D82 A5 B1		        lda zp_mouse_y
   328 6D84 A6 B0		        ldx zp_mouse_x
   329 6D86 20 A4 6D		        jsr mouse_invert_char
   330
   331 6D89 A5 B0		        lda zp_mouse_x
   332 6D8B 85 B6		        sta zp_mouse_prev_x
   333 6D8D A5 B1		        lda zp_mouse_y
   334 6D8F 85 B7		        sta zp_mouse_prev_y
   335 6D91 60			?done   rts
   336 6D92			pend
   337 				.endp
