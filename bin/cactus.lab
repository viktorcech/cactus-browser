   288 				; ----------------------------------------------------------------------------
   289 				; url_ext - Lower-cased extension of url_buffer (after the last '.') in
   290 				; ext_buf, NUL-terminated. C=1 when there is none or it is longer than any
   291 				; listed extension (so it cannot match).
   292 				; ----------------------------------------------------------------------------
   293 = 0004			EXT_MAX = 4
   294 = 0550			ext_buf = $0550                 ; page 5 (after find_fold)
   295
   296 4813			.proc url_ext
   297 4813 A0 00		        ldy #0
   298 4815 A2 FF		        ldx #$FF               ; X = position of last dot ($FF=none)
   299 4817 B9 02 90		?scan   lda url_buffer,y
   300 481A F0 09		        beq ?check
   301 481C C9 2E		        cmp #'.'
   302 481E D0 02		        bne ?next
   303 4820 98			        tya
   304 4821 AA			        tax                    ; X = dot position
   305 4822 C8			?next   iny
   306 4823 D0 F2		        bne ?scan
   307 4825 E0 FF		?check  cpx #$FF
   308 4827 F0 1A		        beq ?none              ; C = 1
   309 4829 A0 00		        ldy #0
   310 482B BD 03 90		?cp     lda url_buffer+1,x     ; char after the dot
   311 482E F0 15		        beq ?end
   312 				 .if 1                          ; 2026-09-23 (6502-idioms: to lower, lowercase leaves on the first compare)
   313 4830 C9 5B		        cmp #'Z'+1             ; to lower
   314 4832 B0 06		        bcs ?st
   315 4834 C9 41		        cmp #'A'
   316 4836 90 02		        bcc ?st
   317 4838 09 20		        ora #$20
   318 483A 99 50 05		?st     sta ext_buf,y
   319 				 .else
   320 				        cmp #'A'               ; to lower
   321 				        bcc ?st
   322 				        cmp #'Z'+1
   323 				        bcs ?st
   324 				        ora #$20
   325 				?st     sta ext_buf,y
   326 				 .endif
   327 483D E8			        inx
   328 483E C8			        iny
   329 483F C0 05		        cpy #EXT_MAX+1
   330 4841 D0 E8		        bne ?cp
   331 4843 38			?none   sec                    ; too long / no dot
   332 4844 60			        rts
   333 4845 99 50 05		?end    sta ext_buf,y          ; A = 0
   334 4848 18			        clc
   335 4849 60			        rts
   336 				.endp
