   620 				        ; 4 gradient bands (320 bytes each at VRAM_GRADIENT): one blit, the
   621 				        ; source steps one colour byte per row with X step 0 (vbxe_init).
   622 				        ; Started, not waited for: the text that follows goes to the screen
   623 				        ; area, not the gradient
   624 3D80 A9 C0		        lda #<(VRAM_BCB+BCB_GRAD_OFS)
   625 3D82 A2 14		        ldx #>(VRAM_BCB+BCB_GRAD_OFS)
   626 3D84 4C 76 34		        jmp blit_go
   627
   628 3D87			title_xdl_data
   629 				        ; Band 0 (top, darkest)
   630 3D87 72 08		        dta a(XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_OVATT)
   631 3D89 07			        dta GRAD_BAND_H - 1
   632 3D8A 00 30 00		        dta <VRAM_GRADIENT, >VRAM_GRADIENT, 0
   633 3D8D 00 00		        dta a(0)                       ; step=0 (repeat scanline)
   634 3D8F 11 FF		        dta $11, $FF                   ; palette 1 + NORMAL, priority
   635
   636 				        ; Band 1
   637 3D91 72 08		        dta a(XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_OVATT)
   638 3D93 07			        dta GRAD_BAND_H - 1
   639 3D94 40 31 00		        dta <(VRAM_GRADIENT + GRAD_BAND_W), >(VRAM_GRADIENT + GRAD_BAND_W), 0
   640 3D97 00 00		        dta a(0)
   641 3D99 11 FF		        dta $11, $FF
   642
   643 				        ; Band 2
   644 3D9B 72 08		        dta a(XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_OVATT)
   645 3D9D 07			        dta GRAD_BAND_H - 1
   646 3D9E 80 32 00		        dta <(VRAM_GRADIENT + GRAD_BAND_W*2), >(VRAM_GRADIENT + GRAD_BAND_W*2), 0
   647 3DA1 00 00		        dta a(0)
   648 3DA3 11 FF		        dta $11, $FF
   649
   650 				        ; Band 3 (bottom, lightest)
   651 3DA5 72 08		        dta a(XDLC_GMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_OVATT)
   652 3DA7 07			        dta GRAD_BAND_H - 1
   653 3DA8 C0 33 00		        dta <(VRAM_GRADIENT + GRAD_BAND_W*3), >(VRAM_GRADIENT + GRAD_BAND_W*3), 0
   654 3DAB 00 00		        dta a(0)
   655 3DAD 11 FF		        dta $11, $FF
   656
   657 				        ; Text section (26 rows = 208 scanlines)
   658 3DAF 71 89		        dta a(XDLC_TMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_CHBASE | XDLC_OVATT | XDLC_END)
   659 3DB1 CF			        dta TITLE_TEXT_ROWS * 8 - 1
   660 3DB2 00 00 00		        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   661 3DB5 A0 00		        dta a(SCR_STRIDE)
   662 3DB7 04			        dta CHBASE_VAL
   663 3DB8 11			        dta $11                        ; palette 1 + NORMAL
   664 3DB9 FF			        dta $FF                        ; priority
