   280 3B74 85 AB		        sta zp_img_ptr
   281 3B76 A5 B9		        lda zp_pb_wr_ptr+1
   282 3B78 85 AC		        sta zp_img_ptr+1
   283 3B7A AD 38 3B		        lda pb_wr_bank
   284 3B7D 8D 0D 3A		        sta img_wr_bank
   285 3B80 20 5D 3A		        jsr vbxe_img_write_big
   286 3B83 A5 AB		        lda zp_img_ptr
   287 3B85 85 B8		        sta zp_pb_wr_ptr
   288 3B87 A5 AC		        lda zp_img_ptr+1
   289 3B89 85 B9		        sta zp_pb_wr_ptr+1
   290 3B8B AD 0D 3A		        lda img_wr_bank
   291 3B8E 8D 38 3B		        sta pb_wr_bank
   292 3B91 60			        rts
   293 				.endp
