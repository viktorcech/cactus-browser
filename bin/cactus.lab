   482 				; --- Attribute value ---
   483 4E5E			.proc parse_attrval
   484 4E5E A6 AA		        ldx in_quotes
   485 4E60 D0 44		        bne ?inq
   486
   487 				        ; Unquoted: local loop until a quote, '>' or space
   488 4E62 A6 91		        ldx zp_val_idx
   489 4E64 A4 99		        ldy chunk_idx
   490 4E66 C9 22		?ulp    cmp #'"'
   491 4E68 F0 25		        beq ?stq
   492 4E6A C9 27		        cmp #$27
   493 4E6C F0 21		        beq ?stq
   494 4E6E C9 3E		        cmp #'>'
   495 4E70 F0 2D		        beq ?evtag_xy
   496 4E72 C9 20		        cmp #CH_SPACE
   497 4E74 F0 22		        beq ?endv_xy
   498 4E76 E0 FF		        cpx #VAL_BUF_SIZE-1
   499 4E78 B0 04		        bcs ?unext
   500 4E7A 9D BD 51		        sta attr_val_buf,x
   501 4E7D E8			        inx
   502 4E7E C4 A3		?unext  cpy zp_rx_len
   503 4E80 F0 06		        beq ?uout
   504 4E82 B9 00 81		        lda rx_buffer,y
   505 4E85 C8			        iny
   506 4E86 D0 DE		        bne ?ulp               ; always
   507 				        ert >?ulp <> >*         ; hot loop: keep it in one page
   508 4E88 86 91		?uout   stx zp_val_idx
   509 4E8A 84 99		        sty chunk_idx
   510 4E8C 4C 07 4C		        jmp parse_loop_re
   511
   512 4E8F 86 91		?stq    stx zp_val_idx
   513 4E91 84 99		        sty chunk_idx
   514 4E93 85 AA		        sta in_quotes
   515 4E95 4C 07 4C		        jmp parse_loop_re
   516
   517 4E98			?endv_xy
   518 4E98 86 91		        stx zp_val_idx
   519 4E9A 84 99		        sty chunk_idx
   520 4E9C 4C D4 4E		        jmp ?endv
   521 4E9F			?evtag_xy
   522 4E9F 86 91		        stx zp_val_idx
   523 4EA1 84 99		        sty chunk_idx
   524 4EA3 4C EB 4E		        jmp ?evtag
   525
   526 4EA6 C5 AA		?inq    cmp in_quotes
   527 4EA8 F0 2A		        beq ?endv
   528 				        ; Quoted value: copy in a tight loop until the closing quote
   529 4EAA A6 91		        ldx zp_val_idx
   530 4EAC A4 99		        ldy chunk_idx          ; >= 1: the current byte is stored first
   531 4EAE D0 0C		        bne ?iq_store          ; always
   532 4EB0 C4 A3		?iq_lp  cpy zp_rx_len
   533 4EB2 F0 19		        beq ?iq_end            ; chunk exhausted mid-value
   534 4EB4 B9 00 81		        lda rx_buffer,y
   535 4EB7 C8			        iny
   536 4EB8 C5 AA		        cmp in_quotes
   537 4EBA F0 0A		        beq ?iq_quote          ; closing quote found
   538 4EBC			?iq_store
   539 4EBC E0 FF		        cpx #VAL_BUF_SIZE-1
   540 4EBE B0 F0		        bcs ?iq_lp             ; buffer full: keep scanning, don't store
   541 4EC0 9D BD 51		        sta attr_val_buf,x
   542 4EC3 E8			        inx
   543 4EC4 D0 EA		        bne ?iq_lp             ; always taken (X <= 255)
   544 				        ert >?iq_lp <> >*         ; hot loop: keep it in one page
   545 4EC6			?iq_quote
   546 4EC6 84 99		        sty chunk_idx
   547 4EC8 86 91		        stx zp_val_idx
   548 4ECA 4C D4 4E		        jmp ?endv
   549 4ECD 84 99		?iq_end sty chunk_idx
   550 4ECF 86 91		        stx zp_val_idx
   551 4ED1 4C 07 4C		        jmp parse_loop_re      ; index == len -> chunk done
   552
   553 4ED4 A6 91		?endv   ldx zp_val_idx
   554 4ED6 A9 00		        lda #0
   555 4ED8 9D BD 51		        sta attr_val_buf,x
   556 4EDB 20 00 56		        jsr process_attr
   557 4EDE A9 03		        lda #PS_IN_ATTRNAME
   558 4EE0 85 8E		        sta zp_parse_state
   559 4EE2 A9 00		        lda #0
   560 4EE4 85 90		        sta zp_attr_idx
   561 4EE6 85 AA		        sta in_quotes
   562 4EE8 4C 07 4C		        jmp parse_loop_re
   563
   564 4EEB A6 91		?evtag  ldx zp_val_idx
   565 4EED A9 00		        lda #0
   566 4EEF 9D BD 51		        sta attr_val_buf,x
   567 4EF2 20 00 56		        jsr process_attr
   568 4EF5 20 00 53		        jsr process_tag
   569 4EF8 4C 2F 4C		        jmp reset_parse_and_loop
   570 				.endp
   571
   572 				; --- Skip mode (script/style) - fast scan for '<' (sentinel ends it) ---
   573 4EFB			.proc parse_skipmode
   574 4EFB C9 3C		        cmp #'<'
   575 4EFD F0 12		        beq ?found
   576 4EFF A4 99		        ldy chunk_idx
   577 4F01 B9 00 81		?scan   lda rx_buffer,y
   578 4F04 C8			        iny
   579 4F05 C9 3C		        cmp #'<'
   580 4F07 D0 F8		        bne ?scan
   581 				        ert >?scan <> >*         ; hot loop: keep it in one page
   582 4F09 88			        dey
   583 4F0A C4 A3		        cpy zp_rx_len
   584 4F0C F0 11		        beq ?end               ; the sentinel: chunk consumed
   585 4F0E C8			        iny
   586 4F0F 84 99		        sty chunk_idx
   587 4F11 A9 01		?found  lda #PS_IN_TAG
   588 4F13 85 8E		        sta zp_parse_state
   589 4F15 A9 00		        lda #0
   590 4F17 85 8F		        sta zp_tag_idx
   591 4F19 8D 06 50		        sta is_closing
   592 4F1C 4C 07 4C		        jmp parse_loop_re
   593 4F1F 84 99		?end    sty chunk_idx
   594 4F21 4C 07 4C		        jmp parse_loop_re
   595 				.endp
   596
   597 				; --- HTML comment mode (<!-- ... -->) ---
   598 4F24			.proc parse_comment
   599 4F24 C9 2D		        cmp #'-'
   600 4F26 D0 06		        bne ?not_dash
   601 4F28 EE 5D 4F		        inc comment_dashes
   602 4F2B 4C 07 4C		        jmp parse_loop_re
   603 4F2E			?not_dash
   604 4F2E C9 3E		        cmp #'>'
   605 4F30 D0 07		        bne ?other
   606 				        ; Check if we had -- before >
   607 4F32 AD 5D 4F		        lda comment_dashes
   608 4F35 C9 02		        cmp #2
   609 4F37 B0 21		        bcs ?end_comment
   610 4F39			?other  ; Ordinary comment byte: reset dash count, then fast-scan the
   611 				        ; rest of the chunk for '-'/'>' in a tight loop
   612 4F39 A9 00		        lda #0
   613 4F3B 8D 5D 4F		        sta comment_dashes
   614 4F3E A4 99		        ldy chunk_idx
   615 4F40 C4 A3		?scan   cpy zp_rx_len
   616 4F42 F0 11		        beq ?chunk_end
   617 4F44 B9 00 81		        lda rx_buffer,y
   618 4F47 C8			        iny
   619 4F48 C9 2D		        cmp #'-'
   620 4F4A F0 04		        beq ?stop
   621 4F4C C9 3E		        cmp #'>'
   622 4F4E D0 F0		        bne ?scan
   623 				        ert >?scan <> >*         ; hot loop: keep it in one page
   624 4F50 84 99		?stop   sty chunk_idx
   625 4F52 4C 24 4F		        jmp parse_comment      ; re-handle found '-' or '>' above
   626 4F55			?chunk_end
   627 4F55 84 99		        sty chunk_idx
   628 4F57 4C 07 4C		        jmp parse_loop_re      ; index == len -> chunk done
   629 4F5A			?end_comment
   630 4F5A 4C 2F 4C		        jmp reset_parse_and_loop
   631 				.endp
   632
   633 4F5D 00			comment_dashes dta 0          ; consecutive '-' count before '>' (need 2+ for -->)
   634
   635 				; --- Entity ---
   636 4F5E			.proc parse_entity
   637 4F5E C9 3B		        cmp #';'
   638 4F60 F0 16		        beq ?end_ent
   639 4F62 C9 20		        cmp #CH_SPACE
   640 4F64 F0 22		        beq ?abort
   641 4F66 C9 3C		        cmp #'<'
   642 4F68 F0 29		        beq ?abort_tag
   643
   644 4F6A A6 92		        ldx zp_entity_idx
   645 4F6C E0 07		        cpx #ENTITY_BUF_SZ-1
   646 4F6E B0 05		        bcs ?jlp
   647 4F70 9D BD 52		        sta entity_buf,x
   648 4F73 E6 92		        inc zp_entity_idx
   649 4F75 4C 07 4C		?jlp    jmp parse_loop_re
   650
   651 4F78			?end_ent
   652 4F78 A6 92		        ldx zp_entity_idx
   653 4F7A A9 00		        lda #0
   654 4F7C 9D BD 52		        sta entity_buf,x
   655 4F7F 20 B9 5A		        jsr decode_entity
   656 4F82 20 A9 4F		        jsr html_emit_char
   657 4F85 4C 2F 4C		        jmp reset_parse_and_loop
   658
   659 4F88 A9 26		?abort  lda #'&'
   660 4F8A 20 A9 4F		        jsr html_emit_char
   661 4F8D 20 35 5B		        jsr emit_entity_buf
   662 4F90 4C 2F 4C		        jmp reset_parse_and_loop
   663
   664 4F93			?abort_tag
   665 4F93 A9 26		        lda #'&'
   666 4F95 20 A9 4F		        jsr html_emit_char
   667 4F98 20 35 5B		        jsr emit_entity_buf
   668 4F9B A9 01		        lda #PS_IN_TAG
   669 4F9D 85 8E		        sta zp_parse_state
   670 4F9F A9 00		        lda #0
   671 4FA1 85 8F		        sta zp_tag_idx
   672 4FA3 8D 06 50		        sta is_closing
   673 4FA6 4C 07 4C		        jmp parse_loop_re
   674 				.endp
   675
   676 				; ============================================================================
   677 				; html_flush / html_emit_char
   678 				; ============================================================================
   679 = 5BF6			html_flush = render_flush_word
   680
   681 4FA9			.proc html_emit_char
   682 				        ; Single precomputed skip test (see update_emit_skip)
   683 4FA9 A6 9A		        ldx emit_skip
   684 4FAB F0 01		        beq html_emit_char_ns
   685 4FAD 60			        rts
   686 				.endp
   687
   688 				; html_emit_char_ns - html_emit_char when the caller already knows
   689 				; emit_skip = 0
   690 4FAE			.proc html_emit_char_ns
   691 				        ; ANSI escape sequence handling
   692 				        ; Detects ESC[$1B] and routes to CSI parser for SGR color codes
   693 				        ; Works in both normal text and <pre> blocks
   694 4FAE A6 A7		        ldx ansi_state
   695 4FB0 D0 2C		        bne ?ansi_cont         ; already inside ESC sequence
   696 4FB2 C9 1B		        cmp #$1B               ; ESC character? start new sequence
   697 4FB4 F0 23		        beq ?ansi_start
   698
   699 4FB6 A6 A8		        ldx in_pre
   700 4FB8 D0 11		        bne ?pre_ch
   701 4FBA C9 0D		        cmp #13
   702 4FBC F0 08		        beq ?ws
   703 4FBE C9 0A		        cmp #10
   704 4FC0 F0 04		        beq ?ws
   705 4FC2 C9 09		        cmp #9
   706 4FC4 D0 02		        bne ?rc
   707 4FC6 A9 20		?ws     lda #CH_SPACE
   708 4FC8 4C 79 5B		?rc     jmp render_char
   709 4FCB C9 0A		?pre_ch cmp #10
   710 4FCD F0 07		        beq ?pre_nl
   711 4FCF C9 0D		        cmp #13
   712 4FD1 F0 0E		        beq ?skip              ; CR in pre -> skip
   713 4FD3 4C 33 5C		        jmp render_out_char    ; direct output, preserve spaces
   714 4FD6 4C 66 5C		?pre_nl jmp render_do_nl
   715
   716 4FD9			?ansi_start
   717 4FD9 E6 A7		        inc ansi_state         ; 0 -> 1: consume ESC, don't emit
   718 4FDB 4C E2 4F		        jmp update_emit_skip
   719
   720 4FDE			?ansi_cont
   721 4FDE 4C 0C 51		        jmp ansi_process       ; handle ANSI continuation byte
   722 4FE1 60			?skip   rts
   723 				.endp
   724
   725 				; ----------------------------------------------------------------------------
   726 				; update_emit_skip - Recompute the combined per-character flags
   727 				; emit_skip = zp_in_skip OR (!in_title AND (zp_in_head OR skip_to_heading
   728 				;             OR skip_to_frag))
   729 				; skip_hf   = skip_to_heading OR skip_to_frag
   730 				; emit_slow = emit_skip OR ansi_state OR in_pre OR in_title (0 = plain text)
   731 				; In <title> only script/style skip applies -- title text is always
   732 				; collected into title_buf (render_char routes it there).
   733 				; MUST be called after changing any source flag. Clobbers: A
   734 				; ----------------------------------------------------------------------------
   735 4FE2			.proc update_emit_skip
   736 4FE2 AD 5E 5F		        lda skip_to_heading
   737 4FE5 0D 0B 50		        ora skip_to_frag
   738 4FE8 85 BD		        sta skip_hf
   739 4FEA AD 07 50		        lda in_title
   740 4FED F0 04		        beq ?notitle
   741 4FEF A5 9C		        lda zp_in_skip
   742 4FF1 10 07		        bpl ?set               ; always (flags are 0/1)
   743 4FF3			?notitle
   744 4FF3 AD 0A 50		        lda zp_in_head
   745 4FF6 05 BD		        ora skip_hf
   746 4FF8 05 9C		        ora zp_in_skip
   747 4FFA 85 9A		?set    sta emit_skip
   748 4FFC 05 A7		        ora ansi_state
   749 4FFE 05 A8		        ora in_pre
   750 5000 0D 07 50		        ora in_title
   751 5003 85 BE		        sta emit_slow
   752 5005 60			        rts
   753 				.endp
   754
   755
   756 				; --- Parser state variables ---
   757 				; (in_pre and utf8_skip moved to zero page — tested per emitted/text char)
   758 5006 00			is_closing     dta 0          ; 1 = closing tag (</...>), set when '/' seen at tag start
   759 5007 00			in_title       dta 0          ; 1 = inside <title>: chars go to title_buf via render_char
   760 5008 00			utf8_lead      dta 0          ; saved lead byte for 2-byte UTF-8 transliteration
   761 5009 00			td_count       dta 0          ; table cell counter per <tr> row (reset at open_tr)
   762 500A 00			zp_in_head     dta 0          ; 1 = inside <head>: skip all content except <title>
   763
   764 				; Fragment anchor support
   765 = 0020			FRAG_BUF_SZ    = 32
   766 500B 00			skip_to_frag   dta 0          ; 1 = suppress output until matching id/name found
   767 = 500C			frag_buf       .ds FRAG_BUF_SZ ; fragment text (from URL #anchor)
   768
   769 				; ============================================================================
   770 				; UTF-8 to ASCII Transliteration
   771 				; Input: A = continuation byte ($80-$BF), X = lead byte (C3/C4/C5)
   772 				; Output: A = ASCII char, or 0 = no mapping (Z flag set)
   773 				; ============================================================================
   774 502C			.proc utf8_xlat
   775 502C-519C> 29 3F		        and #$3F               ; index 0-63
   776 502E A8			        tay
   777 502F E0 C3		        cpx #$C3
   778 5031 F0 0B		        beq ?c3
   779 5033 E0 C4		        cpx #$C4
   780 5035 F0 0B		        beq ?c4
   781 5037 E0 C5		        cpx #$C5
   782 5039 F0 0B		        beq ?c5
   783 503B A9 00		        lda #0                 ; unknown lead byte
   784 503D 60			        rts
   785 503E B9 4A 50		?c3     lda utf8_c3,y
   786 5041 60			        rts
   787 5042 B9 8A 50		?c4     lda utf8_c4,y
   788 5045 60			        rts
   789 5046 B9 CA 50		?c5     lda utf8_c5,y
   790 5049 60			        rts
   791 				.endp
   792
   793 				; C3: U+00C0-U+00FF (Latin-1 Supplement: À-ÿ)
   794 504A			utf8_c3
   795 504A 41 41 41 41 41 41 +         dta c'AAAAAAAC'        ; $80-$87: À Á Â Ã Ä Å Æ Ç
   796 5052 45 45 45 45 49 49 +         dta c'EEEEIIII'        ; $88-$8F: È É Ê Ë Ì Í Î Ï
   797 505A 44 4E 4F 4F 4F 4F	        dta c'DNOOOO'          ; $90-$95: Ð Ñ Ò Ó Ô Õ
   798 5060 4F			        dta c'O'               ; $96: Ö
   799 5061 00			        dta b(0)               ; $97: × (skip)
   800 5062 4F 55 55 55 55 59 +         dta c'OUUUUYTS'        ; $98-$9F: Ø Ù Ú Û Ü Ý Þ ß→s
   801 506A 61 61 61 61 61 61 +         dta c'aaaaaaac'        ; $A0-$A7: à á â ã ä å æ ç
   802 5072 65 65 65 65 69 69 +         dta c'eeeeiiiidn'      ; $A8-$B1: è-ë ì-ï ð ñ
   803 507C 6F 6F 6F 6F 6F	        dta c'ooooo'           ; $B2-$B6: ò ó ô õ ö
   804 5081 00			        dta b(0)               ; $B7: ÷ (skip)
   805 5082 6F 75 75 75 75 79 +         dta c'ouuuuyty'        ; $B8-$BF: ø ù ú û ü ý þ ÿ
   806
   807 				; C4: U+0100-U+013F (Latin Extended-A, part 1)
   808 508A			utf8_c4
   809 508A 41 61 41 61 41 61 +         dta c'AaAaAaCcCcCcCcDd' ; $80-$8F: Ā-ď
   810 509A 44 64 45 65 45 65 +         dta c'DdEeEeEeEeEeGgGg' ; $90-$9F: Đ-ğ
   811 50AA 47 67 47 67 48 68 +         dta c'GgGgHhHhIiIiIiIi' ; $A0-$AF: Ġ-į
   812 50BA 49 69 49 69 4A 6A +         dta c'IiIiJjKkkLlLlLlL'  ; $B0-$BF: İ-Ŀ
   813
   814 				; C5: U+0140-U+017F (Latin Extended-A, part 2)
   815 50CA			utf8_c5
   816 50CA 6C 4C 6C 4E 6E 4E +         dta c'lLlNnNnNnnNnOoOo' ; $80-$8F: ŀ-ŏ
   817 50DA 4F 6F 4F 6F 52 72 +         dta c'OoOoRrRrRrSsSsSs' ; $90-$9F: Ő-ş
   818 50EA 53 73 54 74 54 74 +         dta c'SsTtTtTtUuUuUuUu' ; $A0-$AF: Š-ů
   819 50FA 55 75 55 75 57 77 +         dta c'UuUuWwYyYZzZzZzs' ; $B0-$BF: Ű-ſ
   820
   821 				; ============================================================================
   822 				; ANSI SGR Escape Sequence Handler
   823 				; Supports: ESC[0m (reset), ESC[1m (bold/bright), ESC[22m (normal),
   824 				;           ESC[30-37m (FG), ESC[90-97m (bright FG), ESC[param;...m
   825 				; ============================================================================
   826
   827 				; --- ANSI state ---
   828 				; (ansi_state moved to zero page — tested per emitted char)
   829 510A 00			ansi_param  dta 0              ; current parameter value being accumulated
   830 510B 00			ansi_bold   dta 0              ; 1=bold (bright) mode active
   831
   832 				; ---------------------------------------------------------------------------
   833 				; ansi_process - Handle one byte of ANSI escape sequence
   834 				; Called from html_emit_char when ansi_state > 0
   835 				; ANSI CSI format: ESC [ param1 ; param2 ; ... command_char
   836 				; We only handle 'm' (SGR = Set Graphics Rendition)
   837 				; Input: A = current byte
   838 				; ---------------------------------------------------------------------------
   839 510C			.proc ansi_process
   840 510C A6 A7		        ldx ansi_state
   841 510E E0 01		        cpx #1
   842 5110 F0 2D		        beq ?expect_bracket    ; state 1: ESC received, expect '['
   843 				        ; state 2: inside CSI, collecting parameter digits
   844
   845 				        ; Digit 0-9: accumulate into current parameter
   846 5112 C9 30		        cmp #'0'
   847 5114 90 1B		        bcc ?cmd
   848 5116 C9 3A		        cmp #'9'+1
   849 5118 B0 17		        bcs ?cmd
   850 				        ; param = param * 10 + (char - '0')
   851 				        ; Multiply by 10 using shifts: x*10 = x*8 + x*2
   852 511A E9 2F		        sbc #'0'-1             ; C = 0 (A < '9'+1): A = digit
   853 511C 8D 5B 51		        sta ?tmp
   854 511F AD 0A 51		        lda ansi_param         ; (4p + p) * 2 = 10p, mod 256 as before
   855 5122 0A			        asl
   856 5123 0A			        asl
   857 5124 18			        clc
   858 5125 6D 0A 51		        adc ansi_param
   859 5128 0A			        asl
   860 5129 18			        clc
   861 512A 6D 5B 51		        adc ?tmp               ; + digit
   862 512D 8D 0A 51		        sta ansi_param
   863 5130 60			        rts
   864
   865 5131			?cmd    ; Non-digit: check for separator or command
   866 5131 C9 3B		        cmp #';'
   867 5133 F0 1D		        beq ?separator         ; ';' separates params (e.g. ESC[1;31m)
   868 5135 C9 6D		        cmp #'m'
   869 5137 D0 12		        bne ?abort             ; unknown command letter - abort
   870 				        ; 'm' = SGR command: apply the last param and finish
   871 5139 20 5C 51		        jsr ansi_apply_sgr
   872 513C 4C 4B 51		        jmp ?abort
   873
   874 513F			?expect_bracket
   875 513F C9 5B		        cmp #'['               ; CSI introducer
   876 5141 D0 08		        bne ?abort
   877 5143 E6 A7		        inc ansi_state         ; 1 -> 2: parameter collection
   878 5145 A9 00		        lda #0
   879 5147 8D 0A 51		        sta ansi_param         ; reset first parameter
   880 514A 60			        rts
   881
   882 514B A9 00		?abort  lda #0                 ; not CSI, abort sequence
   883 514D 85 A7		        sta ansi_state
   884 514F 4C E2 4F		        jmp update_emit_skip   ; plain text again
   885
   886 5152			?separator
   887 5152 20 5C 51		        jsr ansi_apply_sgr     ; apply current param
   888 5155 A9 00		        lda #0
   889 5157 8D 0A 51		        sta ansi_param         ; reset for next param
   890 515A 60			        rts
   891
   892 515B 00			?tmp    dta 0
   893 				.endp
   894
   895 				; ---------------------------------------------------------------------------
   896 				; ansi_apply_sgr - Apply single SGR (Set Graphics Rendition) parameter
   897 				; Maps ANSI color codes to VBXE palette indices $10-$1F (CGA colors)
   898 				; Palette layout: $10-$17 = standard 8 colors, $18-$1F = bright 8 colors
   899 				; Supported codes:
   900 				;   0       = reset to normal white text
   901 				;   1       = bold (selects bright color variant)
   902 				;   22      = normal intensity (deselects bold)
   903 				;   30-37   = standard foreground: blk,red,grn,yel,blu,mag,cyn,wht
   904 				;   90-97   = bright foreground (same order)
   905 				; Input: ansi_param = SGR code, ansi_bold = bold flag
   906 				; ---------------------------------------------------------------------------
   907 515C			.proc ansi_apply_sgr
   908 515C AD 0A 51		        lda ansi_param
   909 515F F0 19		        beq ?reset             ; 0 = reset all attributes
   910 5161 C9 01		        cmp #1
   911 5163 F0 1D		        beq ?bold              ; 1 = bold/bright
   912 5165 C9 16		        cmp #22
   913 5167 F0 1D		        beq ?unbold            ; 22 = normal intensity
   914 				        ; Standard foreground 30-37
   915 5169 C9 1E		        cmp #30
   916 516B 90 0C		        bcc ?done
   917 516D C9 26		        cmp #38
   918 516F 90 1B		        bcc ?fg_std
   919 				        ; 40-47: background colors (not supported - single attr byte)
   920 				        ; Bright foreground 90-97
   921 5171 C9 5A		        cmp #90
   922 5173 90 04		        bcc ?done
   923 5175 C9 62		        cmp #98
   924 5177 90 1F		        bcc ?fg_bright
   925 5179 60			?done   rts
   926
   927 517A 8D 0B 51		?reset  sta ansi_bold           ; A = 0
   928 517D A9 01		        lda #ATTR_NORMAL
   929 517F 85 84		        sta zp_cur_attr        ; = render_set_attr
   930 5181 60			        rts
   931
   932 5182 8D 0B 51		?bold   sta ansi_bold           ; A = 1
   933 5185 60			        rts
   934
   935 5186 A9 00		?unbold lda #0
   936 5188 8D 0B 51		        sta ansi_bold
   937 518B 60			        rts
   938
   939 518C			?fg_std ; C = 0 (A < 38): code 30-37 -> palette $10-$17 (+8 when bold)
   940 518C 69 F2		        adc #ATTR_ANSI_BASE-30 ; (adds $F2: C = 1 afterwards)
   941 518E AE 0B 51		        ldx ansi_bold
   942 5191 F0 02		        beq ?set
   943 5193 69 07		        adc #8-1               ; C = 1: +8
   944 5195 85 84		?set    sta zp_cur_attr        ; = render_set_attr
   945 5197 60			        rts
   946
   947 5198			?fg_bright
   948 				        ; C = 0 (A < 98): code 90-97 -> bright palette $18-$1F
   949 5198 69 BE		        adc #ATTR_ANSI_BASE+8-90
   950 519A 85 84		        sta zp_cur_attr
   951 519C 60			        rts
   952 				.endp
