   354 				; ----------------------------------------------------------------------------
   355 				; mouse_invert_char - Show cursor at A=row, X=col
   356 				; Uses vbxe_read_vram/vbxe_write_vram (below $4000) for VRAM access.
   357 				; ----------------------------------------------------------------------------
   358 6DA4			.proc mouse_invert_char
   359 6DA4 20 CC 6D		        jsr mouse_calc_vram    ; zp_tmp_ptr set, Y = col*2
   360 6DA7 8C CB 6D		        sty mouse_col_off
   361 6DAA 20 50 35		        jsr vbxe_cell_get      ; A = char, X = attr
   362 6DAD 8D C9 6D		        sta mouse_saved_char
   363 6DB0 8E CA 6D		        stx mouse_saved_attr
   364 6DB3 09 80		        ora #$80               ; inverted char, red attr
   365 6DB5 A2 05		        ldx #COL_RED
   366 6DB7 AC CB 6D		        ldy mouse_col_off
   367 6DBA 4C 68 35		        jmp vbxe_cell_put
   368 				.endp
   369
   370 				; ----------------------------------------------------------------------------
   371 				; mouse_restore_char - Restore char+attr at A=row, X=col
   372 				; ----------------------------------------------------------------------------
   373 6DBD			.proc mouse_restore_char
   374 6DBD 20 CC 6D		        jsr mouse_calc_vram    ; Y = col*2
   375 6DC0 AD C9 6D		        lda mouse_saved_char
   376 6DC3 AE CA 6D		        ldx mouse_saved_attr
   377 6DC6 4C 68 35		        jmp vbxe_cell_put
   378 				.endp
   379
   380 6DC9 00			mouse_saved_char dta 0
   381 6DCA 00			mouse_saved_attr dta 0
   382 6DCB 00			mouse_col_off    dta 0
   383
   384 				; ----------------------------------------------------------------------------
   385 				; mouse_calc_vram - MEMAC B address for text cell
   386 				; Input: A=row, X=col  Output: zp_tmp_ptr, Y=col*2
   387 				; ----------------------------------------------------------------------------
   388 6DCC			.proc mouse_calc_vram
   389 6DCC A8			        tay
   390 6DCD B9 97 32		        lda row_addr_lo,y      ; from vbxe_text.asm (below $4000)
   391 6DD0 85 87		        sta zp_tmp_ptr
   392 6DD2 B9 B4 32		        lda row_addr_hi,y
   393 6DD5 85 88		        sta zp_tmp_ptr+1
   394 6DD7 8A			        txa
   395 6DD8 0A			        asl
   396 6DD9 A8			        tay
   397 6DDA 60			        rts
   398 				.endp
   399
   400 				; ----------------------------------------------------------------------------
   401 				; mouse_check_link - Is cursor over a link? Find link number.
   402 				; Uses vbxe_read_vram for all VRAM access (safe from above $4000).
   403 				; Output: C=0 A=link#, C=1 not on link
   404 				; ----------------------------------------------------------------------------
   405 6DDB			.proc mouse_check_link
   406 				        ; Link number is encoded in the attr byte: $20+link_num
   407 				        ; mouse_saved_attr has the original attr from cursor position
   408 				        ; Output: C=0 A=link#, C=1 not on link
   409 6DDB AD CA 6D		        lda mouse_saved_attr
   410 6DDE 38			        sec                    ; range test: C = 0 inside [$20, $5F]
   411 6DDF E9 20		        sbc #ATTR_LINK_BASE    ; A = link number
   412 6DE1 C9 40		        cmp #MAX_LINKS         ; (attrs below $20 wrap to >= $E0)
   413 6DE3 90 03		        bcc ?yes
   414 6DE5 AD CA 6D		        lda mouse_saved_attr   ; not a link: A = attr as before (C = 1)
   415 6DE8 60			?yes    rts
   416 				.endp
   109 6DE9			        icl 'title.asm'
