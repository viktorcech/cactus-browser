   203 = 00A9			zp_hist_ptr    = $A9   ; 1 byte - history stack index (0-7)
   204 = 00AA			in_quotes      = $AA   ; quote char inside attr value (tested per attr byte)
   205 = 00AB			zp_img_ptr     = $AB   ; 2 bytes - image write pointer (MEMAC B window)
   206 = 00AD			zp_memb_shadow = $AD   ; MEMAC B shadow for NMI-safe restore
   207 = 00AE			zp_tirq_saved  = $AE   ; Timer IRQ: saved shadow value
   208 = 00AF			zp_vbi_saved   = $AF   ; VBI: saved shadow value
