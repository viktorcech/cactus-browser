     6 				; http_ensure_prefix - Add "N:http://" to url_buffer if missing
     7 				; ----------------------------------------------------------------------------
     8 466E			.proc http_ensure_prefix
     9 				        ; Check if url_buffer starts with "N:" (already has FujiNet prefix)
    10 466E AD 02 90		        lda url_buffer
    11 4671 C9 4E		        cmp #'N'
    12 4673 F0 04		        beq ?chkcolon
    13 4675 C9 6E		        cmp #'n'
    14 4677 D0 07		        bne ?chkhttp
    15 4679			?chkcolon
    16 4679 AD 03 90		        lda url_buffer+1
    17 467C C9 3A		        cmp #':'
    18 467E F0 68		        beq ?ok
    19 4680			?chkhttp
    20 				        ; Check if starts with "http" - need to prepend "N:" only
    21 4680 AD 02 90		        lda url_buffer
    22 4683 C9 68		        cmp #'h'
    23 4685 F0 04		        beq ?addN
    24 4687 C9 48		        cmp #'H'
    25 4689 D0 2B		        jne ?addFull
    26
    27 				        ; Has "http://..." but missing "N:" - shift by 2 and prepend "N:"
    28 468B AC 02 91		?addN   ldy url_length
    29 468E C0 FD		        cpy #URL_BUF_SIZE-3
    30 4690 90 02		        bcc ?sh2
    31 4692 A0 FD		        ldy #URL_BUF_SIZE-3
    32 4694 98			?sh2    tya
    33 4695 18			        clc
    34 4696 69 02		        adc #2
    35 4698 AA			        tax
    36 4699 8E 02 91		        stx url_length
    37 469C CA			        dex
    38 469D 88			        dey
    39 469E 30 0A		        bmi ?cp2
    40 46A0 B9 02 90		?sh2lp  lda url_buffer,y
    41 46A3 9D 02 90		        sta url_buffer,x
    42 46A6 CA			        dex
    43 46A7 88			        dey
    44 46A8 10 F6		        bpl ?sh2lp
    45 46AA A9 4E		?cp2    lda #'N'
    46 46AC 8D 02 90		        sta url_buffer
    47 46AF A9 3A		        lda #':'
    48 46B1 8D 03 90		        sta url_buffer+1
    49 46B4 D0 2A		        bne ?term              ; always (A = ':')
    50
    51 46B6			?addFull
    52 				        ; No http prefix - shift buffer right by 9 and prepend "N:http://"
    53 46B6 AC 02 91		        ldy url_length
    54 46B9 C0 F6		        cpy #URL_BUF_SIZE-10
    55 46BB 90 02		        bcc ?shift
    56 46BD A0 F6		        ldy #URL_BUF_SIZE-10
    57 46BF			?shift
    58 46BF 98			        tya
    59 46C0 18			        clc
    60 46C1 69 09		        adc #9
    61 46C3 AA			        tax                     ; X = new end position
    62 46C4 8E 02 91		        stx url_length
    63 46C7 CA			        dex
    64 46C8 88			        dey
    65 46C9 30 0A		        bmi ?copy
    66 46CB B9 02 90		?shlp   lda url_buffer,y
    67 46CE 9D 02 90		        sta url_buffer,x
    68 46D1 CA			        dex
    69 46D2 88			        dey
    70 46D3 10 F6		        bpl ?shlp
    71
    72 46D5			?copy   ; Copy "N:http://" to start
    73 46D5 A2 08		        ldx #8
    74 46D7 BD E9 46		?cplp   lda ?prefix,x
    75 46DA 9D 02 90		        sta url_buffer,x
    76 46DD CA			        dex
    77 46DE 10 F7		        bpl ?cplp
    78 46E0 AC 02 91		?term   ldy url_length         ; null-terminate
    79
    80 46E3 A9 00		        lda #0
    81 46E5 99 02 90		        sta url_buffer,y
    82 46E8 60			?ok     rts
    83
    84 46E9 4E 3A 68 74 74 70 + ?prefix dta c'N:http://'
    85 				.endp
