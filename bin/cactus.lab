     1 				; ============================================================================
     2 				; VBXE Graphics Mode - Fullscreen Image Display
     3 				; Single image at a time, 8bpp indexed color, stored in VBXE VRAM
     4 				; Images shown fullscreen one by one after page loads
     5 				; ============================================================================
     6
     7 				; Image VRAM layout (after font data at $2000-$2FFF)
     8 = 3000			VRAM_IMG_BASE  = $3000         ; Image storage starts here
     9
    10 				; Image state
    11 3A08 00			img_active     dta b(0)        ; 1 = image on screen
    12
    13 				; Working variables for current image
    14 3A09 00			img_height     dta b(0)
    15 3A0A 00 00 00		img_vram       dta b(0),b(0),b(0)
    16
    17 				; Write pointer for pixel streaming
    18 3A0D 00			img_wr_bank    dta b(0)        ; MEMAC B bank number
    19
    20 				; ----------------------------------------------------------------------------
    21 				; vbxe_img_alloc - Allocate VRAM for image (always at VRAM_IMG_BASE)
    22 				; Input: A=height, X=width lo, Y=width hi
    23 				; Output: C=0 ok, img_vram/img_height set
    24 				; ----------------------------------------------------------------------------
    25 3A0E			.proc vbxe_img_alloc
    26 3A0E 8D 09 3A		        sta img_height
    27 				        ; Always start at VRAM_IMG_BASE (overwrite previous image)
    28 3A11 A9 00		        lda #<VRAM_IMG_BASE
    29 3A13 8D 0A 3A		        sta img_vram
    30 3A16 A9 30		        lda #>VRAM_IMG_BASE
    31 3A18 8D 0B 3A		        sta img_vram+1
    32 3A1B A9 00		        lda #0
    33 3A1D 8D 0C 3A		        sta img_vram+2
    34 3A20 18			        clc
    35 3A21 60			        rts
    36 				.endp
    37
    38 				; ----------------------------------------------------------------------------
    39 				; vbxe_img_begin_write - Initialize write pointer for current image
    40 				; Uses img_vram (set by alloc)
    41 				; ----------------------------------------------------------------------------
    42 3A22			.proc vbxe_img_begin_write
    43 				        ; Bank = VRAM address >> 14
    44 				        ; = (vram+2 << 2) | (vram+1 >> 6)
    45 3A22 AD 0C 3A		        lda img_vram+2         ; high byte (bits 16-23)
    46 3A25 0A			        asl
    47 3A26 0A			        asl
    48 3A27 8D 0D 3A		        sta img_wr_bank        ; bits 18+ in positions 2+
    49 3A2A AD 0B 3A		        lda img_vram+1         ; mid byte (bits 8-15)
    50 3A2D 0A			        asl                    ; bit 15 -> carry
    51 3A2E 2E 0D 3A		        rol img_wr_bank        ; carry -> bank bit 0
    52 3A31 0A			        asl                    ; bit 14 -> carry
    53 3A32 2E 0D 3A		        rol img_wr_bank        ; carry -> bank bit 1
    54
    55 				        ; CPU ptr = $4000 + (VRAM & $3FFF)
    56 3A35 AD 0A 3A		        lda img_vram
    57 3A38 85 AB		        sta zp_img_ptr
    58 3A3A AD 0B 3A		        lda img_vram+1
    59 3A3D 29 3F		        and #$3F
    60 3A3F 09 40		        ora #$40
    61 3A41 85 AC		        sta zp_img_ptr+1
    62 3A43 60			        rts
    63 				.endp
    64
    65 				; ----------------------------------------------------------------------------
    66 				; vbxe_img_write_chunk - Copy rx_buffer to VRAM, handles MEMAC B safely
    67 				; Input: zp_rx_len = number of bytes in rx_buffer
    68 				; ----------------------------------------------------------------------------
    69 3A44			.proc vbxe_img_write_chunk
    70 3A44 A6 A3		        ldx zp_rx_len
    71 3A46 F0 14		        beq ?done
    72 3A48 8E 00 90		        stx img_chunk_lo       ; rx_buffer[0..n-1] -> img_big_buf, then the
    73 3A4B A9 00		        lda #0                 ; block copy (same pointer / bank handling)
    74 3A4D 8D 01 90		        sta img_chunk_hi
    75 3A50 BD FF 80		?cp     lda rx_buffer-1,x
    76 3A53 9D FF 87		        sta img_big_buf-1,x
    77 3A56 CA			        dex
    78 3A57 D0 F7		        bne ?cp
    79 3A59 4C 5D 3A		        jmp vbxe_img_write_big
    80 3A5C 60			?done   rts
    81 				.endp
    82
    83 				; ----------------------------------------------------------------------------
    84 				; vbxe_img_write_big - Copy img_big_buf to VRAM, 16-bit count, block copy
    85 				; Companion to fn_read_img: handles large (up to 2KB) chunks that
    86 				; fn_read_img deposits into img_big_buf.
    87 				;
    88 				; Input: img_chunk_lo/hi = byte count (PRESERVED), zp_img_ptr/img_wr_bank set
    89 				; Source: img_big_buf (at $B724, above $7FFF — unaffected by MEMAC B)
    90 				; Dest: VBXE VRAM via MEMAC B window ($4000-$7FFF)
    91 				; MUST be below $4000 (executes with MEMAC B active)
    92 				; Copies in blocks of up to 256 bytes that never cross the $8000 bank
    93 				; boundary — inner loop is ~19 cycles/byte vs ~53 in the old per-byte
    94 				; version (saves ~1.3s on a fullscreen 64KB image).
    95 				; Uses: zp_tmp_ptr (src), zp_tmp1 (block size, 0=256), zp_tmp2/3 (remaining)
    96 				; ----------------------------------------------------------------------------
    97 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: the per-block branches to ?haveb
    98 				                                ; and the copy loop in one page)
    99 3A5D			        page_fit vbxe_img_write_big.blk-vbxe_img_write_big, vbxe_img_write_big.cp_end-vbxe_img_write_big.blk
Macro: PAGE_FIT [Source: vbxe_const.asm]
