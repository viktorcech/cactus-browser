    93
    94 				        ; Backspace
    95 5FFE C9 7E		        cmp #ATASCII_BS
    96 6000 F0 1B		        beq ?bksp
    97
    98 				        ; Filter: only printable ASCII ($20-$7D)
    99 6002 C9 20		        cmp #ATASCII_SP
   100 6004 90 E5		        bcc ?loop
   101 6006 C9 7E		        cmp #$7E
   102 6008 B0 E1		        bcs ?loop
