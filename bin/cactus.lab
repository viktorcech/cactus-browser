   167 				; ----------------------------------------------------------------------------
   168 				; http_resolve_url - Resolve relative URL in url_buffer against base_url
   169 				; Absolute URLs (http://...) pass through unchanged
   170 				; Relative URLs get base_url prepended
   171 				; ----------------------------------------------------------------------------
   172 475E			.proc http_resolve_url
   173 				        ; Check if already absolute: must start with "http" or "N:"
   174 475E AD 02 90		        lda url_buffer
   175 4761 C9 4E		        cmp #'N'
   176 4763 D0 07		        bne ?not_n
   177 4765 AD 03 90		        lda url_buffer+1
   178 4768 C9 3A		        cmp #':'
   179 476A F0 56		        beq ?done              ; "N:..." = absolute
   180 476C AD 02 90		?not_n  lda url_buffer
   181 476F C9 68		        cmp #'h'
   182 4771 F0 04		        beq ?chk_http
   183 4773 C9 48		        cmp #'H'
   184 4775 D0 15		        bne ?not_abs
   185 4777			?chk_http
   186 4777 AD 03 90		        lda url_buffer+1
   187 477A C9 74		        cmp #'t'
   188 477C D0 0E		        bne ?not_abs
   189 477E AD 04 90		        lda url_buffer+2
   190 4781 C9 74		        cmp #'t'
   191 4783 D0 07		        bne ?not_abs
   192 4785 AD 05 90		        lda url_buffer+3
   193 4788 C9 70		        cmp #'p'
   194 478A F0 36		        beq ?done              ; "http..." = absolute
   195 478C			?not_abs
   196
   197 				        ; Check if root-relative (starts with '/')
   198 478C C9 2F		        cmp #'/'
   199 478E F0 33		        beq ?root_rel
   200
   201 				        ; --- Relative URL: prepend base_url ---
   202 				        ; Step 1: copy url_buffer to rx_buffer (temp)
   203 4790 A0 00		        ldy #0
   204 4792 B9 02 90		?s1     lda url_buffer,y
   205 4795 99 00 81		        sta rx_buffer,y
   206 4798 F0 03		        beq ?s1d
   207 479A C8			        iny
   208 479B D0 F5		        bne ?s1
   209 479D			?s1d
   210 				        ; Step 2: copy base_url to url_buffer
   211 479D A0 00		        ldy #0
   212 479F B9 24 B9		?s2     lda base_url,y
   213 47A2 F0 06		        beq ?s2d
   214 47A4 99 02 90		        sta url_buffer,y
   215 47A7 C8			        iny
   216 47A8 D0 F5		        bne ?s2
   217 47AA			?s2d    ; Y = length of base_url
   218 				        ; Step 3: append relative URL from rx_buffer
   219 47AA A2 00		        ldx #0
   220 47AC BD 00 81		?s3     lda rx_buffer,x
   221 47AF 99 02 90		        sta url_buffer,y
   222 47B2 F0 0B		        beq ?upd
   223 47B4 C8			        iny
   224 47B5 E8			        inx
   225 47B6 C0 FF		        cpy #URL_BUF_SIZE-1
   226 47B8 D0 F2		        bne ?s3
   227 47BA A9 00		        lda #0
   228 47BC 99 02 90		        sta url_buffer,y
   229 47BF 8C 02 91		?upd    sty url_length
   230 47C2 60			?done   rts
   231
   232 47C3			?root_rel
   233 				        ; Root-relative: find host part in base_url
   234 				        ; Look for "://" then the next "/" after that
   235 47C3 A0 00		        ldy #0
   236 47C5 B9 24 B9		?rr1    lda base_url,y
   237 47C8 F0 46		        beq ?rr_use_all        ; no "://" found: treat as relative
   238 47CA C9 3A		        cmp #':'
   239 47CC D0 11		        bne ?rr1n
   240 47CE C8			        iny
   241 47CF B9 24 B9		        lda base_url,y
   242 47D2 C9 2F		        cmp #'/'
   243 47D4 D0 09		        bne ?rr1n
   244 47D6 C8			        iny
   245 47D7 B9 24 B9		        lda base_url,y
   246 47DA C9 2F		        cmp #'/'
   247 47DC F0 04		        beq ?rr_found_scheme
   248 47DE 88			        dey
   249 47DF C8			?rr1n   iny
   250 47E0 D0 E3		        bne ?rr1
   251
   252 47E2			?rr_found_scheme
   253 				        ; Y points to 2nd '/' of "://", skip to find host end
   254 47E2 C8			        iny                    ; skip past "//"
   255 47E3 B9 24 B9		?rr2    lda base_url,y
   256 47E6 F0 07		        beq ?rr_host_end       ; end of base = host only, no path
   257 47E8 C9 2F		        cmp #'/'
   258 47EA F0 03		        beq ?rr_host_end
   259 47EC C8			        iny
   260 47ED D0 F4		        bne ?rr2
   261
   262 47EF			?rr_host_end
   263 				        ; Y = position of '/' after host (or end of string)
   264 47EF 84 8B		        sty zp_tmp1
   265
   266 				        ; Save original url_buffer to rx_buffer
   267 47F1 A0 00		        ldy #0
   268 47F3 B9 02 90		?rr3    lda url_buffer,y
   269 47F6 99 00 81		        sta rx_buffer,y
   270 47F9 F0 03		        beq ?rr3d
   271 47FB C8			        iny
   272 47FC D0 F5		        bne ?rr3
   273 47FE			?rr3d
   274 				        ; Copy host part of base_url
   275 47FE A0 00		        ldy #0
   276 4800 C4 8B		?rr4    cpy zp_tmp1
   277 4802 F0 09		        beq ?rr4d
   278 4804 B9 24 B9		        lda base_url,y
   279 4807 99 02 90		        sta url_buffer,y
   280 480A C8			        iny
   281 480B D0 F3		        bne ?rr4
   282 480D 4C AA 47		?rr4d   jmp ?s2d               ; append the path from rx_buffer at Y
   283
   284 4810			?rr_use_all
   285 4810 4C 92 47		        jmp ?s1                ; (Y as found, as before)
   286 				.endp
