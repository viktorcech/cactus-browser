    83 				; ----------------------------------------------------------------------------
    84 				; copy_font - Copy Atari ROM font to VBXE VRAM (MEMAC B must be on)
    85 				; Remaps internal->ASCII page order
    86 				; ----------------------------------------------------------------------------
    87 30E1			.proc copy_font
    88 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: absolute SMC source/dest pages,
    89 				                                ; 14 cycles a byte instead of 16; count down)
    90 30E1 A2 03		        ldx #3
    91 30E3 AD F4 02		?pglp   lda CHBAS              ; source page = CHBAS + int2asc[X]
    92 30E6 18			        clc
    93 30E7 7D 02 31		        adc int2asc,x
    94 30EA 8D F7 30		        sta ?src+2
    95 30ED 8A			        txa                    ; dest page = MEMB_FONT page + X (C = 0)
    96 30EE 69 60		        adc #>MEMB_FONT
    97 30F0 8D FA 30		        sta ?dst+2
    98 30F3 A0 00		        ldy #0
    99 30F5 B9 00 FF		?src    lda $FF00,y            ; (pages patched)
   100 30F8 99 00 FF		?dst    sta $FF00,y
   101 30FB C8			        iny
   102 30FC D0 F7		        bne ?src
   103 30FE CA			        dex
   104 30FF 10 E2		        bpl ?pglp
   105 3101 60			        rts
   106
   107 				; Data AFTER code so it's not executed
   108 3102 02 00 01 03		int2asc dta 2, 0, 1, 3
   109 				 .else
   110 				        lda CHBAS
   111 				        sta zp_tmp1
   112
   113 				        ldx #0
   114 				?pglp   lda zp_tmp1
   115 				        clc
   116 				        adc int2asc,x
   117 				        sta zp_tmp_ptr+1
   118 				        lda #0
   119 				        sta zp_tmp_ptr
   120
   121 				        txa
   122 				        clc
   123 				        adc #>MEMB_FONT
   124 				        sta zp_tmp_ptr2+1
   125 				        lda #0
   126 				        sta zp_tmp_ptr2
   127
   128 				        ldy #0
   129 				?bylp   lda (zp_tmp_ptr),y
   130 				        sta (zp_tmp_ptr2),y
   131 				        iny
   132 				        bne ?bylp
   133
   134 				        inx
   135 				        cpx #4
   136 				        bne ?pglp
   137 				        rts
   138
   139 				; Data AFTER code so it's not executed
   140 				int2asc dta 2, 0, 1, 3
   141 				 .endif
   142 				.endp
   143
   144 				; ----------------------------------------------------------------------------
   145 				; copy_font_inv - Create inverse font (XOR $FF)
   146 				; ----------------------------------------------------------------------------
   147 3106			.proc copy_font_inv
   148 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: absolute SMC pages; count down)
   149 3106 A2 03		        ldx #3
   150 3108 8A			?pglp   txa
   151 3109 18			        clc
   152 310A 69 60		        adc #>MEMB_FONT
   153 310C 8D 18 31		        sta ?src+2
   154 310F 69 04		        adc #4                 ; C = 0: +$400
   155 3111 8D 1D 31		        sta ?dst+2
   156 3114 A0 00		        ldy #0
   157 3116 B9 00 FF		?src    lda $FF00,y            ; (pages patched)
   158 3119 49 FF		        eor #$FF
   159 311B 99 00 FF		?dst    sta $FF00,y
   160 311E C8			        iny
   161 311F D0 F5		        bne ?src
   162 3121 CA			        dex
   163 3122 10 E4		        bpl ?pglp
   164 3124 60			        rts
   165 				 .else
   166 				        lda #<MEMB_FONT
   167 				        sta zp_tmp_ptr
   168 				        lda #>MEMB_FONT
   169 				        sta zp_tmp_ptr+1
   170
   171 				        lda #<(MEMB_FONT+$400)
   172 				        sta zp_tmp_ptr2
   173 				        lda #>(MEMB_FONT+$400)
   174 				        sta zp_tmp_ptr2+1
   175
   176 				        ldx #4
   177 				?pglp   ldy #0
   178 				?bylp   lda (zp_tmp_ptr),y
   179 				        eor #$FF
   180 				        sta (zp_tmp_ptr2),y
   181 				        iny
   182 				        bne ?bylp
   183 				        inc zp_tmp_ptr+1
   184 				        inc zp_tmp_ptr2+1
   185 				        dex
   186 				        bne ?pglp
   187 				        rts
   188 				 .endif
   189 				.endp
   190
   191 				; ----------------------------------------------------------------------------
   192 				; setup_xdl - Write XDL to VRAM (MEMAC B must be on)
   193 				; ----------------------------------------------------------------------------
   194 3125			.proc setup_xdl
   195 				 .if 1                          ; 2026-09-23 (6502-idioms: count down, no cpx)
   196 3125 A2 12		        ldx #XDL_LEN-1
   197 3127 BD 31 31		?lp     lda xdl_data,x
   198 312A 9D 00 54		        sta MEMB_XDL,x
   199 312D CA			        dex
   200 312E 10 F7		        bpl ?lp
   201 3130 60			        rts
   202 				 .else
   203 				        ldx #0
   204 				?lp     lda xdl_data,x
   205 				        sta MEMB_XDL,x
   206 				        inx
   207 				        cpx #XDL_LEN
   208 				        bne ?lp
   209 				        rts
   210 				 .endif
   211
   212 3131			xdl_data
   213 				        ; Entry 1: top border (8 scanlines for CRT overscan)
   214 				        ; Initialize overlay params but display off (OVOFF)
   215 3131 74 09		        dta a(XDLC_OVOFF | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_CHBASE | XDLC_OVATT)
   216 3133 07			        dta 8-1                        ; 8 blank scanlines
   217 3134 00 00 00		        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   218 3137 A0 00		        dta a(SCR_STRIDE)
   219 3139 04			        dta CHBASE_VAL
   220 313A 11			        dta %00010001                  ; palette 1, NORMAL width
   221 313B FF			        dta $FF                        ; priority
   222
   223 				        ; Entry 2: text mode (29 rows = 232 scanlines)
   224 				        ; Re-set OVADR to row 0 (OVOFF advanced it during border)
   225 313C 71 80		        dta a(XDLC_TMON | XDLC_MAPOFF | XDLC_RPTL | XDLC_OVADR | XDLC_END)
   226 313E E7			        dta SCR_ROWS * 8 - 1          ; 231 scanlines
   227 313F 00 00 00		        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   228 3142 A0 00		        dta a(SCR_STRIDE)
   229
   230 = 0013			XDL_LEN = * - xdl_data
   231 				.endp
   232
   233 				; ----------------------------------------------------------------------------
   234 				; setup_bcb - Write blitter command blocks to VRAM
   235 				; ----------------------------------------------------------------------------
   236 3144			.proc setup_bcb
   237 				 .if 1                          ; 2026-09-23 (6502-idioms: count down, no cpx)
   238 3144 A2 BD		        ldx #BCB_DATA_LEN      ; <= 256 bytes
   239 3146 BD 4F 31		?lp     lda bcb_data-1,x
   240 3149 9D FF 52		        sta MEMB_BCB-1,x
   241 314C CA			        dex
   242 314D D0 F7		        bne ?lp
   243 314F 60			        rts
   244 				 .else
   245 				        ldx #0
   246 				?lp     lda bcb_data,x
   247 				        sta MEMB_BCB,x
   248 				        inx
   249 				        cpx #BCB_DATA_LEN
   250 				        bne ?lp
   251 				        rts
   252 				 .endif
   253
   254 				 .if 1                          ; 2026-09-23 (vbxe-blitter: every fill a constant fill, AND 0 / XOR
   255 				                                ; value, 1 cycle a byte: cls, scroll row, row fill, content clear).
   256 				                                ; Pairs with vbxe_cls/fill_row/ui_clear_content: flip together
   257 3150			bcb_data
   258
   259 				; BCB 0: clear screen, characters (offset 0)
   260 3150 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   261 3156 00 00 00		        dta <(VRAM_SCREEN), >(VRAM_SCREEN), 0
   262 3159 A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   263 315B 02			        dta 2                          ; dest step X: every other byte
   264 315C 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   265 315E 1C			        dta SCR_ROWS - 1                 ; height - 1
   266 315F 00 20 00 00 00	        dta $00, CH_SPACE, $00, 0, $00    ; AND 0, XOR = value: constant fill
   267 3164 08			        dta $08
   268 				; BCB 1: clear screen, attributes
   269 3165 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   270 316B 01 00 00		        dta <(VRAM_SCREEN+1), >(VRAM_SCREEN+1), 0
   271 316E A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   272 3170 02			        dta 2                          ; dest step X: every other byte
   273 3171 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   274 3173 1C			        dta SCR_ROWS - 1                 ; height - 1
   275 3174 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00    ; AND 0, XOR = value: constant fill
   276 3179 00			        dta $00
   277 				; BCB 2: Scroll up (offset 42): rows 1..28 -> 0..27
   278 317A A0 00 00		        dta <(VRAM_SCREEN + SCR_STRIDE), >(VRAM_SCREEN + SCR_STRIDE), 0
   279 317D A0 00		        dta a(SCR_STRIDE)
   280 317F 01			        dta 1
   281 3180 00 00 00		        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   282 3183 A0 00		        dta a(SCR_STRIDE)
   283 3185 01			        dta 1
   284 3186 9F 00		        dta a(SCR_STRIDE - 1)
   285 3188 1B			        dta SCR_ROWS - 2
   286 3189 FF 00 00 00 00	        dta $FF, $00, $00, 0, $00
   287 318E 08			        dta $08                        ; chain: clear the last row
   288 				; BCB 3: last row, characters
   289 318F 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   290 3195 80 11 00		        dta <(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE), >(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE), 0
   291 3198 A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   292 319A 02			        dta 2                          ; dest step X: every other byte
   293 319B 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   294 319D 00			        dta 1 - 1                 ; height - 1
   295 319E 00 20 00 00 00	        dta $00, CH_SPACE, $00, 0, $00    ; AND 0, XOR = value: constant fill
   296 31A3 08			        dta $08
   297 				; BCB 4: last row, attributes
   298 31A4 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   299 31AA 81 11 00		        dta <(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE + 1), >(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE + 1), 0
   300 31AD A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   301 31AF 02			        dta 2                          ; dest step X: every other byte
   302 31B0 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   303 31B2 00			        dta 1 - 1                 ; height - 1
   304 31B3 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00    ; AND 0, XOR = value: constant fill
   305 31B8 00			        dta $00
   306 				; BCB 5: fill one row, characters (offset 105; dest set per fill)
   307 31B9 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   308 31BF 00 00 00		        dta <(VRAM_SCREEN), >(VRAM_SCREEN), 0
   309 31C2 A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   310 31C4 02			        dta 2                          ; dest step X: every other byte
   311 31C5 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   312 31C7 00			        dta 1 - 1                 ; height - 1
   313 31C8 00 20 00 00 00	        dta $00, CH_SPACE, $00, 0, $00    ; AND 0, XOR = value: constant fill
   314 31CD 08			        dta $08
   315 				; BCB 6: fill one row, attributes (dest + XOR colour set per fill)
   316 31CE 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   317 31D4 01 00 00		        dta <(VRAM_SCREEN+1), >(VRAM_SCREEN+1), 0
   318 31D7 A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   319 31D9 02			        dta 2                          ; dest step X: every other byte
   320 31DA 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   321 31DC 00			        dta 1 - 1                 ; height - 1
   322 31DD 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00    ; AND 0, XOR = value: constant fill
   323 31E2 00			        dta $00
   324 				; BCB 7: clear content rows, characters (offset 147)
   325 31E3 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   326 31E9 40 01 00		        dta <(VRAM_SCREEN + CONTENT_TOP * SCR_STRIDE), >(VRAM_SCREEN + CONTENT_TOP * SCR_STRIDE), 0
   327 31EC A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   328 31EE 02			        dta 2                          ; dest step X: every other byte
   329 31EF 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   330 31F1 18			        dta CONTENT_BOT - CONTENT_TOP + 1 - 1                 ; height - 1
   331 31F2 00 20 00 00 00	        dta $00, CH_SPACE, $00, 0, $00    ; AND 0, XOR = value: constant fill
   332 31F7 08			        dta $08
   333 				; BCB 8: clear content rows, attributes
   334 31F8 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; source unused (AND = 0)
   335 31FE 41 01 00		        dta <(VRAM_SCREEN + CONTENT_TOP * SCR_STRIDE + 1), >(VRAM_SCREEN + CONTENT_TOP * SCR_STRIDE + 1), 0
   336 3201 A0 00		        dta a(SCR_STRIDE)              ; dest step Y
   337 3203 02			        dta 2                          ; dest step X: every other byte
   338 3204 4F 00		        dta a(SCR_COLS - 1)            ; width - 1
   339 3206 18			        dta CONTENT_BOT - CONTENT_TOP + 1 - 1                 ; height - 1
   340 3207 00 00 00 00 00	        dta $00, COL_BLACK, $00, 0, $00    ; AND 0, XOR = value: constant fill
   341 320C 00			        dta $00
   342
   343 = 00BD			BCB_DATA_LEN = * - bcb_data
   344 				        ert VRAM_BCB+BCB_DATA_LEN > VRAM_GRAD
   345 				        ert BCB_DATA_LEN > 256
   346 				 .else
   347 				bcb_data
   348
   349 				; BCB 0: Clear screen (21 bytes, offset 0)
   350 				        ; Source: fill pattern
   351 				        dta <VRAM_PATTERN, >VRAM_PATTERN, 0
   352 				        dta a(0)                       ; Source step Y = 0
   353 				        dta 1                          ; Source step X
   354 				        ; Dest: screen
   355 				        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   356 				        dta a(SCR_STRIDE)              ; Dest step Y
   357 				        dta 1                          ; Dest step X
   358 				        dta a(SCR_STRIDE - 1)          ; Width - 1
   359 				        dta SCR_ROWS - 1              ; Height - 1
   360 				        dta $FF                        ; AND mask
   361 				        dta $00                        ; XOR mask
   362 				        dta $00                        ; Collision
   363 				        dta 0                          ; Zoom
   364 				        dta $81                        ; Pattern: 2-byte repeat
   365 				        dta $00                        ; Control: normal
   366
   367 				; BCB 1: Scroll up (offset 21)
   368 				        ; Source: row 1
   369 				        dta <(VRAM_SCREEN + SCR_STRIDE), >(VRAM_SCREEN + SCR_STRIDE), 0
   370 				        dta a(SCR_STRIDE)
   371 				        dta 1
   372 				        ; Dest: row 0
   373 				        dta <VRAM_SCREEN, >VRAM_SCREEN, 0
   374 				        dta a(SCR_STRIDE)
   375 				        dta 1
   376 				        dta a(SCR_STRIDE - 1)
   377 				        dta SCR_ROWS - 2              ; Copy 23 rows
   378 				        dta $FF
   379 				        dta $00
   380 				        dta $00
   381 				        dta 0
   382 				        dta $00
   383 				        dta $08                        ; Control: chain to next BCB
   384
   385 				; BCB 2: Clear last row after scroll (offset 42)
   386 				        ; Source: fill pattern
   387 				        dta <VRAM_PATTERN, >VRAM_PATTERN, 0
   388 				        dta a(0)
   389 				        dta 1
   390 				        ; Dest: last row
   391 				        dta <(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE)
   392 				        dta >(VRAM_SCREEN + (SCR_ROWS-1) * SCR_STRIDE)
   393 				        dta 0
   394 				        dta a(SCR_STRIDE)
   395 				        dta 1
   396 				        dta a(SCR_STRIDE - 1)
   397 				        dta 0                          ; 1 row
   398 				        dta $FF
   399 				        dta $00
   400 				        dta $00
   401 				        dta 0
   402 				        dta $81                        ; Pattern
   403 				        dta $00                        ; Control: normal
   404
   405 				BCB_DATA_LEN = * - bcb_data
   406 				 .endif
   407 				.endp
   408
   409 				 .if 1                          ; 2026-09-23 (vbxe-blitter: offsets of the table above)
   410 = 0000			BCB_CLS_OFS     = 0
   411 = 002A			BCB_SCROLL_OFS  = 42
   412 = 0069			BCB_ROW_OFS     = 105
   413 = 0093			BCB_CONTENT_OFS = 147
   414 				 .else
   415 				BCB_CLS_OFS    = 0
   416 				BCB_SCROLL_OFS = 21
   417 				 .endif
   418
   419 				 .if 1                          ; 2026-09-23 (vbxe-blitter: constant fills, see setup_grad_bcb)
   420 = 01C0			BCB_GRAD_OFS    = VRAM_GRAD_BCB-VRAM_BCB
   421 				 .else
   422 				BCB_GRAD_OFS    = VRAM_GRAD+4-VRAM_BCB   ; after the 4 colour bytes
   423 				 .endif
   424
   425 				; ----------------------------------------------------------------------------
   426 				; setup_grad_bcb - Title gradient colours + BCB at VRAM_GRAD (after the text
   427 				; BCBs). One blit fills the 4 bands: the source steps one colour byte per
   428 				; row (step Y 1) and repeats it along the row (step X 0).
   429 				; ----------------------------------------------------------------------------
   430 320D			.proc setup_grad_bcb
   431 				 .if 1                          ; 2026-09-23 (vbxe-blitter: a constant fill is AND 0 / XOR colour,
   432 				                                ; 1 cycle a byte: 4 x (320+22) = 1368 blitter cycles against
   433 				                                ; 4 x (320+320) + 21 = 2581 for the copy from a colour column)
   434 320D A2 7D		        ldx #GRAD_DATA_LEN-1
   435 320F BD 19 32		?lp     lda grad_data,x
   436 3212 9D C0 54		        sta MEMB_BASE+VRAM_GRAD_BCB,x
   437 3215 CA			        dex
   438 3216 10 F7		        bpl ?lp
   439 3218 60			        rts
   440
   441 3219			grad_data                       ; top (dark) to bottom, palette indices 8-11
   442 3219 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; band 0: source unused (AND = 0)
   443 321F 00 30 00		        dta <(VRAM_GRADIENT+GRAD_BAND_W*0), >(VRAM_GRADIENT+GRAD_BAND_W*0), 0
   444 3222 40 01 01		        dta a(GRAD_BAND_W), 1
   445 3225 3F 01 00		        dta a(GRAD_BAND_W - 1), 0      ; width - 1 (9 bits), one row
   446 3228 00 08 00 00 00	        dta $00, 8, $00, 0, $00        ; AND 0, XOR = palette index
   447 322D 08			        dta $08
   448 322E 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; band 1: source unused (AND = 0)
   449 3234 40 31 00		        dta <(VRAM_GRADIENT+GRAD_BAND_W*1), >(VRAM_GRADIENT+GRAD_BAND_W*1), 0
   450 3237 40 01 01		        dta a(GRAD_BAND_W), 1
   451 323A 3F 01 00		        dta a(GRAD_BAND_W - 1), 0      ; width - 1 (9 bits), one row
   452 323D 00 09 00 00 00	        dta $00, 9, $00, 0, $00        ; AND 0, XOR = palette index
   453 3242 08			        dta $08
   454 3243 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; band 2: source unused (AND = 0)
   455 3249 80 32 00		        dta <(VRAM_GRADIENT+GRAD_BAND_W*2), >(VRAM_GRADIENT+GRAD_BAND_W*2), 0
   456 324C 40 01 01		        dta a(GRAD_BAND_W), 1
   457 324F 3F 01 00		        dta a(GRAD_BAND_W - 1), 0      ; width - 1 (9 bits), one row
   458 3252 00 0A 00 00 00	        dta $00, 10, $00, 0, $00        ; AND 0, XOR = palette index
   459 3257 08			        dta $08
   460 3258 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; band 3: source unused (AND = 0)
   461 325E C0 33 00		        dta <(VRAM_GRADIENT+GRAD_BAND_W*3), >(VRAM_GRADIENT+GRAD_BAND_W*3), 0
   462 3261 40 01 01		        dta a(GRAD_BAND_W), 1
   463 3264 3F 01 00		        dta a(GRAD_BAND_W - 1), 0      ; width - 1 (9 bits), one row
   464 3267 00 0B 00 00 00	        dta $00, 11, $00, 0, $00        ; AND 0, XOR = palette index
   465 326C 00			        dta $00
   466 326D			hline_bcb                       ; vbxe_hline: chars, then attributes; dest,
   467 326D 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0           ; width and XOR written per line
   468 3273 00 00 00		        dta 0, 0, 0
   469 3276 A0 00 02		        dta a(SCR_STRIDE), 2
   470 3279 00 00 00		        dta a(0), 0                    ; width - 1, one row
   471 327C 00 00 00 00 00	        dta $00, $00, $00, 0, $00      ; AND 0, XOR = char: constant fill
   472 3281 08			        dta $08
   473 3282 00 00 00 00 00 00	        dta 0, 0, 0, a(0), 0
   474 3288 00 00 00		        dta 0, 0, 0
   475 328B A0 00 02		        dta a(SCR_STRIDE), 2
   476 328E 00 00 00		        dta a(0), 0
   477 3291 00 00 00 00 00	        dta $00, $00, $00, 0, $00      ; XOR = attribute
   478 3296 00			        dta $00
   479 = 007E			GRAD_DATA_LEN = * - grad_data
   480 				        ert GRAD_DATA_LEN > 128
   481 				        ert VRAM_GRAD_BCB+GRAD_DATA_LEN > VRAM_FONT
   482 				        ert VRAM_GRAD_BCB + hline_bcb - grad_data <> VRAM_HLINE_BCB
   483 				 .else
   484 				        ldx #GRAD_DATA_LEN-1
   485 				?lp     lda grad_data,x
   486 				        sta MEMB_BASE+VRAM_GRAD,x
   487 				        dex
   488 				        bpl ?lp
   489 				        rts
   490
   491 				grad_data
   492 				        dta 8, 9, 10, 11               ; palette indices, top (dark) to bottom
   493 				        dta <VRAM_GRAD, >VRAM_GRAD, 0
   494 				        dta a(1)                       ; source step Y: next colour per row
   495 				        dta 0                          ; source step X: repeat it
   496 				        dta <VRAM_GRADIENT, >VRAM_GRADIENT, 0
   497 				        dta a(GRAD_BAND_W)             ; dest step Y
   498 				        dta 1
   499 				        dta a(GRAD_BAND_W - 1)         ; width - 1 (9 bits)
   500 				        dta GRAD_BANDS - 1
   501 				        dta $FF, $00, $00, 0, $00, $00
   502 				GRAD_DATA_LEN = * - grad_data
   503 				        ert VRAM_GRAD+GRAD_DATA_LEN > VRAM_XDL
   504 				 .endif
   505 				.endp
