     8 				; ============================================================================
     9 				; process_tag - Handle parsed tag via jump table dispatch
    10 				; ============================================================================
    11 52C6			        .align $100            ; tag dispatch in one page
    12 5300			.proc process_tag
    13 5300-5715> 20 00 59	        jsr lookup_tag
    14 5303 8D C5 52		        sta current_tag_id
    15
    16 				        ; In skip mode (script/style), only process their
    17 				        ; closing tags - ignore everything else inside the block
    18 5306 A6 9C		        ldx zp_in_skip
    19 5308 F0 15		        beq ?not_skip
    20 530A AE 06 50		        ldx is_closing
    21 530D F0 08		        beq ?ret
    22 530F C9 0F		        cmp #TAG_SCRIPT
    23 5311 F0 05		        beq ?cls
    24 5313 C9 10		        cmp #TAG_STYLE
    25 5315 F0 01		        beq ?cls
    26 5317 60			?ret    rts
    27 5318 A9 00		?cls    lda #0
    28 531A 85 9C		        sta zp_in_skip
    29 531C 4C E2 4F		        jmp update_emit_skip
    30
    31 531F			?not_skip
    32 				        ; In <head> mode - only process head-related tags
    33 				        ; If a known content tag appears, auto-clear head mode
    34 				        ; (safety for pages without explicit <body>)
    35 531F AE 0A 50		        ldx zp_in_head
    36 5322 F0 23		        beq ?dispatch
    37 5324 C9 0E		        cmp #TAG_TITLE
    38 5326 F0 1F		        beq ?dispatch
    39 5328 C9 0F		        cmp #TAG_SCRIPT
    40 532A F0 1B		        beq ?dispatch
    41 532C C9 10		        cmp #TAG_STYLE
    42 532E F0 17		        beq ?dispatch
    43 5330 C9 21		        cmp #TAG_HEAD
    44 5332 F0 13		        beq ?dispatch
    45 5334 C9 22		        cmp #TAG_BODY
    46 5336 F0 0F		        beq ?dispatch
    47 5338 C9 00		        cmp #TAG_UNKNOWN
    48 533A F0 DB		        beq ?ret              ; meta/link etc. - ignore in head
    49 				        ; Known content tag (p, div, h1...) - page has no <body>
    50 533C A9 00		        lda #0
    51 533E 8D 0A 50		        sta zp_in_head
    52 5341 20 E2 4F		        jsr update_emit_skip
    53 5344 AD C5 52		        lda current_tag_id
    54
    55 5347			?dispatch                      ; A = tag id
    56 5347 AA			        tax
    57 5348 AD 06 50		        lda is_closing
    58 534B D0 0D		        bne ?close             ; (flags are 0/1)
    59 				        ; --- Open tag dispatch ---
    60 534D BD 98 53		        lda otbl_hi,x
    61 5350 85 88		        sta zp_tmp_ptr+1
    62 5352 BD 68 53		        lda otbl_lo,x
    63 5355 85 87		        sta zp_tmp_ptr
    64 5357 6C 87 00		        jmp (zp_tmp_ptr)
    65 535A			?close  ; --- Close tag dispatch ---
    66 535A BD F8 53		        lda ctbl_hi,x
    67 535D 85 88		        sta zp_tmp_ptr+1
    68 535F BD C8 53		        lda ctbl_lo,x
    69 5362 85 87		        sta zp_tmp_ptr
    70 5364 6C 87 00		        jmp (zp_tmp_ptr)
    71 				.endp
