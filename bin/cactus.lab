   554 				 .if 1                          ; 2026-09-23 (settings saved on disk: D1: sector 715)
   555 				; ----------------------------------------------------------------------------
   556 				; set_load / set_save - Settings sector: 'C','S', version, use_proxy, 0...
   557 				; A missing or foreign sector (no "CS") keeps the defaults.
   558 				; ----------------------------------------------------------------------------
   559 = 02CB			SET_SECT     = 715
   560 = 0A80			settings_buf = $0A80                ; 128 B after bookmarks_buf (ends $0A7F)
   561
   562 418F			.proc set_load
   563 418F 20 D7 41		        jsr set_io
   564 4192 A9 00		        lda #0                      ; read
   565 4194 20 D9 3D		        jsr bk_sio_sector
   566 4197 B0 16		        bcs ?done
   567 4199 AD 80 0A		        lda settings_buf
   568 419C C9 43		        cmp #'C'
   569 419E D0 0F		        bne ?done
   570 41A0 AD 81 0A		        lda settings_buf+1
   571 41A3 C9 53		        cmp #'S'
   572 41A5 D0 08		        bne ?done
   573 41A7 AD 83 0A		        lda settings_buf+3
   574 41AA 29 01		        and #1
   575 41AC 8D 7B 49		        sta use_proxy
   576 41AF 60			?done   rts
   577 				.endp
   578
   579 41B0			.proc set_save
   580 41B0 A2 7F		        ldx #127
   581 41B2 A9 00		        lda #0
   582 41B4 9D 80 0A		?clr    sta settings_buf,x
   583 41B7 CA			        dex
   584 41B8 10 FA		        bpl ?clr
   585 41BA A9 43		        lda #'C'
   586 41BC 8D 80 0A		        sta settings_buf
   587 41BF A9 53		        lda #'S'
   588 41C1 8D 81 0A		        sta settings_buf+1
   589 41C4 A9 01		        lda #1                      ; format version
   590 41C6 8D 82 0A		        sta settings_buf+2
   591 41C9 AD 7B 49		        lda use_proxy
   592 41CC 8D 83 0A		        sta settings_buf+3
   593 41CF 20 D7 41		        jsr set_io
   594 41D2 A9 01		        lda #1                      ; write
   595 41D4 4C D9 3D		        jmp bk_sio_sector
   596 				.endp
   597
   598 				; set_io - zp_tmp_ptr = settings_buf, sector = SET_SECT
   599 41D7			.proc set_io
   600 41D7 A9 80		        lda #<settings_buf
   601 41D9 85 87		        sta zp_tmp_ptr
   602 41DB A9 0A		        lda #>settings_buf
   603 41DD 85 88		        sta zp_tmp_ptr+1
   604 41DF A9 CB		        lda #<SET_SECT
   605 41E1 8D 22 3E		        sta bk_sect_lo
   606 41E4 A9 02		        lda #>SET_SECT
   607 41E6 8D 23 3E		        sta bk_sect_hi
   608 41E9 60			        rts
   609 				.endp
   610 				 .endif
