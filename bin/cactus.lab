   669 				; ============================================================================
   670 				; MEMAC B boundary guard: everything above (vbxe_text, find, vbxe_gfx)
   671 				; runs with the MEMAC B window ($4000-$7FFF) enabled and MUST stay below
   672 				; $4000. Build fails here if code growth pushes it over the boundary.
   673 				; ============================================================================
   674 				        ert *>$4000
    94 				        ; --- everything below this line is above $4000 (no MEMAC B code) ---
    95 3DBA			        icl 'bookmarks.asm'    ; no memb_on/off — VRAM via vbxe_* helpers
Source: bookmarks.asm
     1 				; ============================================================================
     2 				; Bookmarks Module
     3 				; Storage: D1: sectors 719-720 (raw SIO, no DOS dependency)
     4 				; 4 slots × 64 bytes, URL NUL-terminated.
     5 				; Buffer at $0500 (page 5) — does not consume data.asm buffer space.
     6 				;
     7 				; UI pattern follows mag/menu.asm: CH register polling, clear CH after read.
     8 				; ============================================================================
     9
    10 = 000A			BK_SLOTS       = 10
    11 = 0040			BK_SLOT_SZ     = 64
    12 = 02CC			BK_SECT_FIRST  = 716                ; 5 sectors (716..720), 2 slots per sector
    13 = 0005			BK_NUM_SECT    = 5
    14
    15 = 0278			STICK0         = $0278              ; port 1 joystick shadow (MAG-style nav)
    16
    17 = 0800			bookmarks_buf  = $0800              ; 640 bytes of free RAM (pages 8..10)
    18
    19 				; Per-slot address lookup (10 slots, 64 B each at bookmarks_buf)
    20 3DBA			bk_slot_lo
    21 3DBA 00 40 80 C0 00 40 +         :BK_SLOTS dta <(bookmarks_buf + # * BK_SLOT_SZ)
    22 3DC4			bk_slot_hi
    23 3DC4 08 08 08 08 09 09 +         :BK_SLOTS dta >(bookmarks_buf + # * BK_SLOT_SZ)
    24
    25 				; ----------------------------------------------------------------------------
    26 				; bk_slot_addr - Set zp_tmp_ptr to slot X address (X preserved)
    27 				; ----------------------------------------------------------------------------
    28 3DCE			.proc bk_slot_addr
    29 3DCE BD BA 3D		        lda bk_slot_lo,x
    30 3DD1 85 87		        sta zp_tmp_ptr
    31 3DD3 BD C4 3D		        lda bk_slot_hi,x
    32 3DD6 85 88		        sta zp_tmp_ptr+1
    33 3DD8 60			        rts
    34 				.endp
    35
    36 				; ----------------------------------------------------------------------------
    37 				; bk_sio_sector - Read or write one D1: sector
    38 				; Input: A=0 read, A!=0 write; bk_sect_lo/hi = sector; zp_tmp_ptr = buffer
    39 				; Output: C=0 ok, C=1 error
    40 				; ----------------------------------------------------------------------------
    41 3DD9			.proc bk_sio_sector
    42 3DD9 AA			        tax                         ; X = 0 read, else write
    43 3DDA A9 31		        lda #$31
    44 3DDC 8D 00 03		        sta DDEVIC
    45 3DDF A9 01		        lda #1
    46 3DE1 8D 01 03		        sta DUNIT
    47 3DE4 8A			        txa
    48 3DE5 F0 09		        beq ?rd
    49 3DE7 A9 50		        lda #'P'
    50 3DE9 8D 02 03		        sta DCOMND
    51 3DEC A9 80		        lda #$80
    52 3DEE D0 07		        bne ?dirset
    53 3DF0 A9 52		?rd     lda #'R'
    54 3DF2 8D 02 03		        sta DCOMND
    55 3DF5 A9 40		        lda #$40
    56 3DF7 8D 03 03		?dirset sta DSTATS
    57 3DFA A5 87		        lda zp_tmp_ptr
    58 3DFC 8D 04 03		        sta DBUFLO
    59 3DFF A5 88		        lda zp_tmp_ptr+1
    60 3E01 8D 05 03		        sta DBUFHI
    61 3E04 A9 0F		        lda #15
    62 3E06 8D 06 03		        sta DTIMLO
    63 3E09 A9 80		        lda #128
    64 3E0B 8D 08 03		        sta DBYTLO
    65 3E0E A9 00		        lda #0
    66 3E10 8D 09 03		        sta DBYTHI
    67 3E13 AD 22 3E		        lda bk_sect_lo
    68 3E16 8D 0A 03		        sta DAUX1
    69 3E19 AD 23 3E		        lda bk_sect_hi
    70 3E1C 8D 0B 03		        sta DAUX2
    71 3E1F 4C B8 42		        jmp sio_ok
    72 				.endp
    73
    74 3E22 00			bk_sect_lo  dta 0
    75 3E23 00			bk_sect_hi  dta 0
    76 3E24 00			bk_sel      dta 0
    77
    78 				; ----------------------------------------------------------------------------
    79 				; bk_load - Read both sectors into bookmarks_buf, sanitize invalid slots.
    80 				; Called once at startup from main.
    81 				; ----------------------------------------------------------------------------
    82 3E25			.proc bk_load
    83 3E25 A9 00		        lda #0                      ; A=0 = read
    84 3E27 20 43 3E		        jsr bk_rw_all
    85 3E2A 90 57		        bcc bk_sanitize
    86 3E2C A2 09		        ldx #BK_SLOTS-1
    87 3E2E A9 00		        lda #0
    88 3E30 BC BA 3D		?zl     ldy bk_slot_lo,x            ; slot byte 0 = 0 (empty)
    89 3E33 8C 3D 3E		        sty ?st+1
    90 3E36 BC C4 3D		        ldy bk_slot_hi,x
    91 3E39 8C 3E 3E		        sty ?st+2
    92 3E3C 8D FF FF		?st     sta $FFFF
    93 3E3F CA			        dex
    94 3E40 10 EE		        bpl ?zl
    95 3E42 60			        rts
    96 				.endp
    97
    98 				; bk_rw_all - Read (A=0) or write (A!=0) all BK_NUM_SECT sectors.
    99 				; Sector i = BK_SECT_FIRST + i, buffer at bookmarks_buf + i*128.
   100 3E43			.proc bk_rw_all
   101 3E43 8D 82 3E		        sta bk_rw_req
   102 3E46 A2 04		        ldx #BK_NUM_SECT-1     ; sector order does not matter: count down
   103 3E48 8E 77 3E		?lp     stx ?i
   104 				        ; Sector = BK_SECT_FIRST + X
   105 3E4B 8A			        txa
   106 3E4C 18			        clc
   107 3E4D 69 CC		        adc #<BK_SECT_FIRST
   108 3E4F 8D 22 3E		        sta bk_sect_lo
   109 3E52 A9 00		        lda #0
   110 3E54 69 02		        adc #>BK_SECT_FIRST
   111 3E56 8D 23 3E		        sta bk_sect_hi
   112 				        ; Buffer = bookmarks_buf + X*128 (table)
   113 3E59 BD 78 3E		        lda bk_sect_off_lo,x
   114 3E5C 18			        clc
   115 3E5D 69 00		        adc #<bookmarks_buf
   116 3E5F 85 87		        sta zp_tmp_ptr
   117 3E61 BD 7D 3E		        lda bk_sect_off_hi,x
   118 3E64 69 08		        adc #>bookmarks_buf
   119 3E66 85 88		        sta zp_tmp_ptr+1
   120 3E68 AD 82 3E		        lda bk_rw_req
   121 3E6B 20 D9 3D		        jsr bk_sio_sector
   122 3E6E B0 06		        bcs ?err               ; C = 1: error
   123 3E70 AE 77 3E		        ldx ?i
   124 3E73 CA			        dex
   125 3E74 10 D2		        bpl ?lp
   126 3E76 60			?err    rts                    ; C = 0 after the last good sector
   127 3E77 00			?i      dta 0
   128 				.endp
   129
   130 				; X*128 offsets for BK_NUM_SECT=5 sectors
   131 3E78 00 80 00 80 00	bk_sect_off_lo dta $00, $80, $00, $80, $00
   132 3E7D 00 00 01 01 02	bk_sect_off_hi dta $00, $00, $01, $01, $02
   133 3E82 00			bk_rw_req      dta 0
   134
   135 				; ----------------------------------------------------------------------------
   136 				; bk_sanitize - For each slot, verify byte 0 to first NUL are printable ASCII.
   137 				; If not (or no NUL within 63 bytes), zero byte 0 to mark empty.
   138 				; Protects against garbage in uninitialized ATR sectors.
   139 				; ----------------------------------------------------------------------------
   140 3E83			.proc bk_sanitize
   141 3E83 A2 09		        ldx #BK_SLOTS-1
   142 3E85 8E AA 3E		?slot   stx ?i
   143 3E88 20 CE 3D		        jsr bk_slot_addr
   144 3E8B A0 00		        ldy #0
   145 3E8D B1 87		?scan   lda (zp_tmp_ptr),y
   146 3E8F F0 12		        beq ?ok                     ; NUL terminator = slot is valid
   147 3E91 C9 20		        cmp #$20
   148 3E93 90 09		        bcc ?bad
   149 3E95 C9 7F		        cmp #$7F
   150 3E97 B0 05		        bcs ?bad
   151 3E99 C8			        iny
   152 3E9A C0 3F		        cpy #BK_SLOT_SZ-1
   153 3E9C D0 EF		        bne ?scan
   154 3E9E A9 00		?bad    lda #0
   155 3EA0 A8			        tay
   156 3EA1 91 87		        sta (zp_tmp_ptr),y
   157 3EA3 AE AA 3E		?ok     ldx ?i
   158 3EA6 CA			        dex
   159 3EA7 10 DC		        bpl ?slot
   160 3EA9 60			        rts
   161 3EAA 00			?i      dta 0
   162 				.endp
   163
   164 				; ----------------------------------------------------------------------------
   165 				; bk_save - Persist bookmarks_buf back to both sectors
   166 				; ----------------------------------------------------------------------------
   167 3EAB			.proc bk_save
   168 3EAB A9 01		        lda #1                      ; A!=0 = write
   169 3EAD 4C 43 3E		        jmp bk_rw_all
   170 				.endp
   171
   172 				; ============================================================================
   173 				; Bookmark window UI (MAG-style: CH register polling, not CIO)
   174 				; ============================================================================
   175
   176 3EB0			.proc bk_screen
   177 3EB0 20 92 6D		        jsr mouse_hide_cursor
   178 3EB3 20 79 60		        jsr ui_init
   179 3EB6 20 77 40		        jsr bk_draw_header
   180 3EB9 20 9D 40		        jsr bk_draw_hint
   181
   182 3EBC A9 00		        lda #0
   183 3EBE 8D 24 3E		        sta bk_sel
   184 3EC1 20 EE 40		        jsr bk_draw_list
   185
   186 3EC4 A5 14		?wait   lda RTCLOK+2                ; sync to VBI (MAG pattern)
   187 3EC6 C5 14		?wvs    cmp RTCLOK+2
   188 3EC8 F0 FC		        beq ?wvs
   189
   190 				        ; Joystick port 1 — MAG uses stick0 for up/down
   191 3ECA AD 78 02		        lda STICK0
   192 3ECD C9 0E		        cmp #14                     ; up
   193 3ECF F0 5C		        beq ?stk_up
   194 3ED1 C9 0D		        cmp #13                     ; down
   195 3ED3 F0 6C		        beq ?stk_dn
   196
   197 				        ; Keyboard via CH
   198 3ED5 AD FC 02		        lda CH
   199 3ED8 C9 FF		        cmp #$FF
   200 3EDA F0 E8		        beq ?wait
   201 3EDC A2 FF		        ldx #$FF               ; consume the key, A keeps it
   202 3EDE 8E FC 02		        stx CH
   203
   204 3EE1 C9 0C		        cmp #$0C                    ; RETURN = confirm (open filled / edit empty)
   205 3EE3 F0 75		        jeq ?confirm
   206 3EE5 C9 1C		        cmp #$1C                    ; ESC = close window
   207 3EE7 D0 03 4C 01 40	        jeq ?close
   208 3EEC C9 0E		        cmp #$0E                    ; '-' alt up
   209 3EEE F0 40		        beq ?ku
   210 3EF0 C9 8E		        cmp #$8E                    ; CTRL+'-' alt up
   211 3EF2 F0 3C		        beq ?ku
   212 3EF4 C9 0F		        cmp #$0F                    ; '=' alt down
   213 3EF6 F0 4C		        beq ?kdn
   214 3EF8 C9 8F		        cmp #$8F                    ; CTRL+'='
   215 3EFA F0 48		        beq ?kdn
   216 3EFC C9 3A		        cmp #$3A                    ; D = delete
   217 3EFE D0 03 4C 95 3F	        jeq ?del
   218 3F03 C9 2A		        cmp #$2A                    ; E = edit selected slot (even filled)
   219 3F05 D0 03 4C B3 3F	        jeq ?edit
   220 3F0A C9 3F		        cmp #$3F                    ; A = add current page URL to empty slot
   221 3F0C D0 03 4C C2 3F	        jeq ?add
   222 				        ; Digit keys 1-9,0 jump straight to slot 1-10 and confirm
   223 3F11 A2 09		        ldx #BK_SLOTS-1
   224 3F13 DD 08 40		?kdig   cmp bk_digit_codes,x
   225 3F16 F0 06		        beq ?dighit
   226 3F18 CA			        dex
   227 3F19 10 F8		        bpl ?kdig
   228 3F1B 4C C4 3E		        jmp ?wait                   ; unrecognised key
   229 3F1E AD 24 3E		?dighit lda bk_sel
   230 3F21 8D 12 40		        sta bk_old_sel
   231 3F24 8E 24 3E		        stx bk_sel
   232 3F27 20 FE 40		        jsr bk_draw_two
   233 3F2A 4C 5A 3F		        jmp ?confirm
   234
   235 3F2D 20 13 40		?stk_up jsr bk_stick_release
   236 3F30 AD 24 3E		?ku     lda bk_sel
   237 3F33 F0 8F		        jeq ?wait
   238 3F35 8D 12 40		        sta bk_old_sel              ; redraw only the two affected rows
   239 3F38 CE 24 3E		        dec bk_sel
   240 3F3B 20 FE 40		        jsr bk_draw_two
   241 3F3E 4C C4 3E		        jmp ?wait
   242
   243 3F41 20 13 40		?stk_dn jsr bk_stick_release
   244 3F44 AD 24 3E		?kdn    lda bk_sel
   245 3F47 C9 09		        cmp #BK_SLOTS-1
   246 3F49 90 03 4C C4 3E	        jcs ?wait
   247 3F4E 8D 12 40		        sta bk_old_sel
   248 3F51 EE 24 3E		        inc bk_sel
   249 3F54 20 FE 40		        jsr bk_draw_two
   250 3F57 4C C4 3E		        jmp ?wait
   251
   252 3F5A			?confirm
   253 3F5A AE 24 3E		        ldx bk_sel
   254 3F5D 20 CE 3D		        jsr bk_slot_addr
   255 3F60 A0 00		        ldy #0
   256 3F62 B1 87		        lda (zp_tmp_ptr),y
   257 3F64 F0 4D		        jeq ?edit                   ; empty -> edit mode
   258 3F66 B1 87		?opcp   lda (zp_tmp_ptr),y
   259 3F68 99 02 90		        sta url_buffer,y
   260 3F6B F0 0A		        beq ?opd
   261 3F6D C8			        iny
   262 3F6E C0 FF		        cpy #URL_BUF_SIZE-1
   263 3F70 D0 F4		        bne ?opcp
   264 3F72 A9 00		        lda #0
   265 3F74 99 02 90		        sta url_buffer,y
   266 3F77 8C 02 91		?opd    sty url_length
   267
   268 				        ; Detect if URL (has '.') or search query (no '.') — mirror ui_url_input
   269 3F7A A0 00		        ldy #0
   270 3F7C B9 02 90		?ckd    lda url_buffer,y
   271 3F7F F0 07		        beq ?nodot                  ; end of string, no dot = search phrase
   272 3F81 C9 2E		        cmp #'.'
   273 3F83 F0 06		        beq ?gonav                  ; dot found = treat as URL
   274 3F85 C8			        iny
   275 3F86 D0 F4		        bne ?ckd
   276 3F88 20 37 4A		?nodot  jsr url_build_search        ; rewrite url_buffer as search URL
   277 3F8B A9 FF		?gonav  lda #$FF
   278 3F8D 85 B6		        sta zp_mouse_prev_x
   279 3F8F 20 73 6B		        jsr history_push
   280 3F92 4C 69 45		        jmp http_navigate
   281
   282 3F95 AE 24 3E		?del    ldx bk_sel
   283 3F98 20 CE 3D		        jsr bk_slot_addr
   284 3F9B A0 00		        ldy #0
   285 3F9D B1 87		        lda (zp_tmp_ptr),y
   286 3F9F D0 03 4C C4 3E	        jeq ?wait
   287 3FA4 98			        tya                         ; A = 0
   288 3FA5 91 87		        sta (zp_tmp_ptr),y
   289 3FA7 20 AB 3E		        jsr bk_save
   290 3FAA AE 24 3E		        ldx bk_sel
   291 3FAD 20 0A 41		        jsr bk_draw_row
   292 3FB0 4C C4 3E		        jmp ?wait
   293
   294 3FB3			?edit   ; Edit selected slot (RETURN on empty slot, or E on any slot)
   295 3FB3 AE 24 3E		        ldx bk_sel
   296 3FB6 20 1B 40		        jsr bk_edit
   297 3FB9 20 EE 40		        jsr bk_draw_list
   298 3FBC 20 9D 40		        jsr bk_draw_hint
   299 3FBF 4C C4 3E		        jmp ?wait
   300
   301 3FC2			?add    ; Save current page URL into the first empty slot
   302 3FC2 AD 26 BE		        lda cur_page_url
   303 3FC5 D0 03 4C C4 3E	        jeq ?wait                   ; no page loaded yet
   304 3FCA A2 00		        ldx #0
   305 3FCC 20 CE 3D		?afind  jsr bk_slot_addr            ; preserves X
   306 3FCF A0 00		        ldy #0
   307 3FD1 B1 87		        lda (zp_tmp_ptr),y
   308 3FD3 F0 08		        beq ?aslot
   309 3FD5 E8			        inx
   310 3FD6 E0 0A		        cpx #BK_SLOTS
   311 3FD8 D0 F2		        bne ?afind
   312 3FDA 4C C4 3E		        jmp ?wait                   ; all slots full
   313 3FDD AD 24 3E		?aslot  lda bk_sel
   314 3FE0 8D 12 40		        sta bk_old_sel
