   762 				; ============================================================================
   763 				; store_img_as_link - Store IMG URL as link with "I:" prefix
   764 				; Shows [N]IMG with link color. URL stored as "I:" + img_src_buf in link_urls[]
   765 				; ============================================================================
   766 56D5			.proc store_img_as_link
   767 				        ; Check link_num < MAX_LINKS
   768 56D5 A5 98		        lda zp_link_num
   769 56D7 C9 40		        cmp #MAX_LINKS
   770 56D9 B0 36		        bcs ?full
   771 56DB 20 92 56		        jsr calc_link_addr     ; A = link_num still
   772
   773 				        ; Write "I:" prefix
   774 56DE A9 49		        lda #'I'
   775 56E0 A0 00		        ldy #0
   776 56E2 91 87		        sta (zp_tmp_ptr),y
   777 56E4 C8			        iny
   778 56E5 A9 3A		        lda #':'
   779 56E7 91 87		        sta (zp_tmp_ptr),y
   780 56E9 C8			        iny
   781
   782 				        ; Copy img_src_buf after prefix (max 125 chars to fit in 128B slot)
   783 56EA A2 00		        ldx #0
   784 56EC BD 16 57		?cp     lda img_src_buf,x
   785 56EF 91 87		        sta (zp_tmp_ptr),y
   786 56F1 F0 0A		        beq ?ok
   787 56F3 C8			        iny
   788 56F4 E8			        inx
   789 56F5 C0 7F		        cpy #LINK_URL_SIZE-1
   790 56F7 D0 F3		        bne ?cp
   791 56F9 A9 00		        lda #0
   792 56FB 91 87		        sta (zp_tmp_ptr),y
   793
   794 56FD			?ok     ; Show [N]IMG with link attr (attr = $20+link_num)
   795 56FD A5 98		        lda zp_link_num
   796 56FF 18			        clc
   797 5700 69 20		        adc #ATTR_LINK_BASE
   798 5702 85 84		        sta zp_cur_attr            ; = render_set_attr
   799 5704 A9 12		        lda #<m_imgtxt
   800 5706 A2 57		        ldx #>m_imgtxt
   801 5708 20 26 5F		        jsr render_string          ; shows "IMG"
   802 570B A9 01		        lda #ATTR_NORMAL
   803 570D 85 84		        sta zp_cur_attr
   804 570F E6 98		        inc zp_link_num
   805 5711 60			?full   rts
   806
   807 5712 49 4D 47 00		m_imgtxt dta c'IMG',0
   808 				.endp
