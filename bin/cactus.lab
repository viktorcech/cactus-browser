   268 5B35			.proc emit_entity_buf
   269 5B35 A2 00		        ldx #0
   270 5B37 E4 92		?lp     cpx zp_entity_idx
   271 5B39 F0 0D		        beq ?done
   272 5B3B BD BD 52		        lda entity_buf,x
