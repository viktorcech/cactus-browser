   195 				; Entity decoding
   196 				; ============================================================================
   197 5AB9			.proc decode_entity
   198 5AB9 AD BD 52		        lda entity_buf
   199 5ABC C9 61		        cmp #'a'
   200 5ABE F0 17		        beq ?amp
   201 5AC0 C9 6C		        cmp #'l'
   202 5AC2 F0 1D		        beq ?lt
   203 5AC4 C9 67		        cmp #'g'
   204 5AC6 F0 23		        beq ?gt
   205 5AC8 C9 6E		        cmp #'n'
   206 5ACA F0 29		        beq ?nbsp
   207 5ACC C9 71		        cmp #'q'
   208 5ACE F0 2F		        beq ?quot
   209 5AD0 C9 23		        cmp #'#'
   210 5AD2 F0 38		        beq ?num
   211 5AD4 A9 3F		        lda #'?'
   212 5AD6 60			        rts
   213
   214 5AD7 AD BE 52		?amp    lda entity_buf+1
   215 5ADA C9 6D		        cmp #'m'
   216 5ADC D0 2B		        bne ?unk
   217 5ADE A9 26		        lda #'&'
   218 5AE0 60			        rts
   219 5AE1 AD BE 52		?lt     lda entity_buf+1
   220 5AE4 C9 74		        cmp #'t'
   221 5AE6 D0 21		        bne ?unk
   222 5AE8 A9 3C		        lda #'<'
   223 5AEA 60			        rts
   224 5AEB AD BE 52		?gt     lda entity_buf+1
   225 5AEE C9 74		        cmp #'t'
   226 5AF0 D0 17		        bne ?unk
   227 5AF2 A9 3E		        lda #'>'
   228 5AF4 60			        rts
   229 5AF5 AD BE 52		?nbsp   lda entity_buf+1
   230 5AF8 C9 62		        cmp #'b'
   231 5AFA D0 0D		        bne ?unk
   232 5AFC A9 20		        lda #CH_SPACE
   233 5AFE 60			        rts
   234 5AFF AD BE 52		?quot   lda entity_buf+1
   235 5B02 C9 75		        cmp #'u'
   236 5B04 D0 03		        bne ?unk
   237 5B06 A9 22		        lda #'"'
   238 5B08 60			        rts
   239 5B09 A9 3F		?unk    lda #'?'
   240 5B0B 60			        rts
   241
   242 5B0C A9 00		?num    lda #0
   243 5B0E 85 8B		        sta zp_tmp1
   244 5B10 A2 01		        ldx #1
   245 5B12 BD BD 52		?nlp    lda entity_buf,x
   246 5B15 F0 1B		        beq ?nd
   247 5B17 38			        sec
   248 5B18 E9 30		        sbc #'0'
   249 5B1A C9 0A		        cmp #10                ; ('0'-1 and below wrap to >= 10)
   250 5B1C B0 EB		        bcs ?unk
   251 5B1E 85 8C		        sta zp_tmp2            ; digit
   252 5B20 A5 8B		        lda zp_tmp1            ; value = value * 10 + digit (mod 256)
   253 5B22 0A			        asl
   254 5B23 0A			        asl
   255 5B24 18			        clc
   256 5B25 65 8B		        adc zp_tmp1
   257 5B27 0A			        asl
   258 5B28 18			        clc
   259 5B29 65 8C		        adc zp_tmp2
   260 5B2B 85 8B		        sta zp_tmp1
   261 5B2D E8			        inx
   262 5B2E E0 04		        cpx #4
   263 5B30 D0 E0		        bne ?nlp
   264 5B32 A5 8B		?nd     lda zp_tmp1
   265 5B34 60			        rts
   266 				.endp
