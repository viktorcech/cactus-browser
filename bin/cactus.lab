    87 				; ----------------------------------------------------------------------------
    88 				; http_save_base - Save current url_buffer as base URL (up to last '/')
    89 				; Call BEFORE overwriting url_buffer with a new link URL
    90 				; ----------------------------------------------------------------------------
    91 46F2			.proc http_save_base
    92 				        ; Find last '/' in url_buffer, but ignore "://" slashes
    93 				        ; Strategy: find position after "://", then last '/' after that
    94 46F2 A0 00		        ldy #0
    95 46F4 84 8B		        sty zp_tmp1            ; zp_tmp1 = index after last path '/'
    96 46F6 84 8C		        sty zp_tmp2            ; zp_tmp2 = position after "://"
    97
    98 				        ; First find "://" to know where host starts
    99 46F8			?find_scheme
   100 46F8 B9 02 90		        lda url_buffer,y
   101 46FB F0 2B		        beq ?check
   102 46FD C9 3A		        cmp #':'
   103 46FF D0 15		        bne ?fs_next
   104 				        ; Check if followed by "//"
   105 4701 C8			        iny
   106 4702 B9 02 90		        lda url_buffer,y
   107 4705 C9 2F		        cmp #'/'
   108 4707 D0 0D		        bne ?fs_next
   109 4709 C8			        iny
   110 470A B9 02 90		        lda url_buffer,y
   111 470D C9 2F		        cmp #'/'
   112 470F D0 05		        bne ?fs_next
   113 4711 C8			        iny                    ; Y = position after "://"
   114 4712 84 8C		        sty zp_tmp2
   115 4714 D0 03		        bne ?scan_path         ; always (Y != 0 after iny)
   116 4716			?fs_next
   117 4716 C8			        iny
   118 4717 D0 DF		        bne ?find_scheme
   119
   120 4719			?scan_path
   121 				        ; Now scan for '/' in the path portion (after host)
   122 4719 B9 02 90		        lda url_buffer,y
   123 471C F0 0A		        beq ?check
   124 471E C8			        iny
   125 471F C9 2F		        cmp #'/'
   126 4721 D0 02		        bne ?sp_next
   127 4723 84 8B		        sty zp_tmp1            ; save position after this '/'
   128 4725			?sp_next
   129 4725 98			        tya
   130 4726 D0 F1		        bne ?scan_path
   131
   132 4728			?check  ; If no path '/' found (zp_tmp1 <= zp_tmp2), use whole URL + "/"
   133 4728 A5 8B		        lda zp_tmp1
   134 472A C5 8C		        cmp zp_tmp2
   135 472C F0 02		        beq ?use_all
   136 472E B0 19		        bcs ?copy              ; path '/' after the host: copy up to it
   137
   138 4730			?use_all
   139 				        ; No path slash - copy whole URL and append "/"
   140 4730 A0 00		        ldy #0
   141 4732 B9 02 90		?ua     lda url_buffer,y
   142 4735 F0 06		        beq ?ua_slash
   143 4737 99 24 B9		        sta base_url,y
   144 473A C8			        iny
   145 473B D0 F5		        bne ?ua
   146 473D			?ua_slash
   147 473D A9 2F		        lda #'/'
   148 473F 99 24 B9		        sta base_url,y
   149 4742 C8			        iny
   150 4743 A9 00		        lda #0
   151 4745 99 24 B9		        sta base_url,y
   152 4748 60			        rts
   153
   154 4749			?copy   ; Copy url_buffer[0..zp_tmp1-1] to base_url
   155 4749 A0 00		        ldy #0
   156 474B C4 8B		?cplp   cpy zp_tmp1
   157 474D F0 09		        beq ?term
   158 474F B9 02 90		        lda url_buffer,y
   159 4752 99 24 B9		        sta base_url,y
   160 4755 C8			        iny
   161 4756 D0 F3		        bne ?cplp
   162 4758 A9 00		?term   lda #0
   163 475A 99 24 B9		        sta base_url,y
   164 475D 60			        rts
   165 				.endp
