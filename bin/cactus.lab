Source: html_entities.asm
     1 				; ============================================================================
     2 				; HTML Entity Decoding & Tag Lookup Tables
     3 				; ============================================================================
     4
     5 				; ============================================================================
     6 				; lookup_tag - Find tag ID from tag_name_buf
     7 				; Tables are sorted alphabetically and indexed by first letter: only the
     8 				; matching letter's bucket is scanned (1-9 candidates) instead of all 47
     9 				; entries. Unknown tags (meta, link, ...) — the most common case on real
    10 				; pages — no longer pay a full-table scan, and non-letter names like
    11 				; "!doctype" bail out immediately.
    12 				; Output: A = tag ID
    13 				; ============================================================================
    14 = 002F			NUM_TAGS = 47
    15
    16 5817			        .align $100            ; bucket loop in one page
    17 5900			.proc lookup_tag
    18 5900-5EBC> AD 9D 51	        lda tag_name_buf
    19 5903 38			        sec
    20 5904 E9 61		        sbc #'a'
    21 5906 C9 1A		        cmp #26                ; (bytes below 'a' wrap to >= 26)
    22 5908 B0 2F		        bcs ?unk               ; first char not a-z -> unknown
    23 590A AA			        tax
    24 590B BD 12 5A		        lda letter_start+1,x   ; bucket end = next letter's start
    25 590E 8D 16 59		        sta ?end+1
    26 5911 BD 11 5A		        lda letter_start,x
    27 5914 AA			        tax
    28 5915			?next
    29 5915 E0 00		?end    cpx #0                 ; bucket exhausted? (operand patched)
    30 5917 F0 20		        beq ?unk
    31 5919 BD 2C 5A		        lda tag_tbl_lo,x
    32 591C 85 87		        sta zp_tmp_ptr
    33 591E BD 5B 5A		        lda tag_tbl_hi,x
    34 5921 85 88		        sta zp_tmp_ptr+1
    35
    36 5923 A0 01		        ldy #1                 ; first letter matched by the bucket
    37 5925 B1 87		?cmp    lda (zp_tmp_ptr),y
    38 5927 F0 08		        beq ?chk
    39 5929 D9 9D 51		        cmp tag_name_buf,y
    40 592C D0 08		        bne ?skip
    41 592E C8			        iny
    42 592F D0 F4		        bne ?cmp
    43 				        ert >?cmp <> >*         ; hot loop: keep it in one page
    44
    45 5931 B9 9D 51		?chk    lda tag_name_buf,y
    46 5934 F0 06		        beq ?found
    47 5936 E8			?skip   inx
    48 5937 D0 DC		        bne ?next              ; always taken (X < NUM_TAGS)
    49 5939 A9 00		?unk    lda #TAG_UNKNOWN
    50 593B 60			        rts
    51 593C BD 8A 5A		?found  lda tag_ids,x
    52 593F 60			        rts
    53 				.endp
    54
    55 				; Tag strings, alphabetical order (digits sort before letters: h1 < head)
    56 5940 61 00		ts_a      dta c'a',0
    57 5942 61 72 74 69 63 6C + ts_article dta c'article',0
    58 594A 61 73 69 64 65 00	ts_aside  dta c'aside',0
    59 5950 62 00		ts_b      dta c'b',0
    60 5952 62 6C 6F 63 6B 71 + ts_blockquote dta c'blockquote',0
    61 595D 62 6F 64 79 00	ts_body   dta c'body',0
    62 5962 62 72 00		ts_br     dta c'br',0
    63 5965 63 6F 64 65 00	ts_code   dta c'code',0
    64 596A 64 64 00		ts_dd     dta c'dd',0
    65 596D 64 69 76 00		ts_div    dta c'div',0
    66 5971 64 74 00		ts_dt     dta c'dt',0
    67 5974 65 6D 00		ts_em     dta c'em',0
    68 5977 66 6F 6F 74 65 72 + ts_footer dta c'footer',0
    69 597E 66 6F 72 6D 00	ts_form   dta c'form',0
    70 5983 68 31 00		ts_h1     dta c'h1',0
    71 5986 68 32 00		ts_h2     dta c'h2',0
    72 5989 68 33 00		ts_h3     dta c'h3',0
    73 598C 68 34 00		ts_h4     dta c'h4',0
    74 598F 68 35 00		ts_h5     dta c'h5',0
    75 5992 68 36 00		ts_h6     dta c'h6',0
    76 5995 68 65 61 64 00	ts_head   dta c'head',0
    77 599A 68 65 61 64 65 72 + ts_header_tag dta c'header',0
    78 59A1 68 72 00		ts_hr     dta c'hr',0
    79 59A4 69 00		ts_i      dta c'i',0
    80 59A6 69 6D 67 00		ts_img    dta c'img',0
    81 59AA 69 6E 70 75 74 00	ts_input  dta c'input',0
    82 59B0 6C 69 00		ts_li     dta c'li',0
