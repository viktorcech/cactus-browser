   222 				; Tables and buffers outside the MEMAC B window (data.asm, $8000+)
   223 				; char_class, print_buf -- readable while the window is open
   224
   225 				; ----------------------------------------------------------------------------
   226 				; Macros
   227 				; ----------------------------------------------------------------------------
   228
   229 				; MEMAC B macros with shadow variable for interrupt-safe restore.
   230 				; IMPORTANT: Code using these macros MUST be below $4000!
   231 				; When MEMAC B is active, $4000-$7FFF reads VRAM, not RAM.
   232 				; Interrupt handlers use stubs at page 6 to disable/restore MEMAC B.
   233 				;
   234 				; The register is written absolute (4 cycles, Y untouched) at the page the
   235 				; code is assembled for ($D6xx). Every such store records the address of
   236 				; its operand's high byte in the MADS .PUT array: element 0 counts them
   237 				; (labels set inside a macro stay local to it, the array is global),
   238 				; elements 2.. hold the addresses. data.asm emits the list (.SAV) and
   239 				; memac_patch moves them all to $D7xx when VBXE answers there.
   240 				 .if 1                          ; 2026-09-23 (6502-cycles-layout / vbxe: MEMAC B written absolute, patched
   241 				                                ; to the detected page at start; -4 cycles a switch, Y kept).
   242 				                                ; Pairs with memac_patch (vbxe_detect) and memac_sites (data)
   243 = D600			VBXE_REGS = $D600
   244  [0000] 00		        .put [0] = 0
   245
   246 				; memb_set: A = MEMAC B value (store the shadow first: NMI-safe ordering)
   247 				memb_set .macro
   248 				        sta VBXE_REGS+VBXE_MEMAC_B
   249 				        .put [2+.get[0]*2] = <(*-1)
   250 				        .put [3+.get[0]*2] = >(*-1)
   251 				        .put [0] = .get[0]+1
   252 				        .endm
   253
   254 				memb_on .macro
   255 				        lda #$80+:1
   256 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   257 				        memb_set
   258 				        .endm
   259
   260 				memb_off .macro
   261 				        lda #0
   262 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   263 				        memb_set
   264 				        .endm
   265 				 .else
   266 				VBXE_REGS = $D600
   267 				        .put [0] = 0
   268
   269 				memb_set .macro
   270 				        ldy #VBXE_MEMAC_B
   271 				        sta (zp_vbxe_base),y
   272 				        .endm
   273
   274 				memb_on .macro
   275 				        lda #$80+:1
   276 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   277 				        ldy #VBXE_MEMAC_B
   278 				        sta (zp_vbxe_base),y
   279 				        .endm
   280
   281 				memb_off .macro
   282 				        lda #0
   283 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   284 				        ldy #VBXE_MEMAC_B
   285 				        sta (zp_vbxe_base),y
   286 				        .endm
   287 				 .endif
   288
   289 				; Show message on status bar: :1=color, :2=message address
   290 				; Expands to subroutine call (9 bytes) instead of inline (31 bytes)
   291 				status_msg .macro
   292 				        ldy #:1
   293 				        lda #<:2
   294 				        ldx #>:2
   295 				        jsr status_msg_sub
   296 				        .endm
   297
   298 				; Wait N frames (RTCLOK-based delay): :1=frame count
   299 				; Expands to subroutine call (5 bytes) instead of inline (13 bytes)
   300 				wait_frames .macro
   301 				        ldx #:1
   302 				        jsr wait_frames_sub
   303 				        .endm
   304
   305 				; page_fit off, len: pad (placed after an unconditional exit) so that the
   306 				; loop starting `off` bytes after the pad and the instruction after its
   307 				; back branch (`len` bytes on) share one page: the branch stays 3 cycles.
   308 				; off/len are label differences inside the next proc, so they do not move.
   309 				page_fit .macro
   310 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: hot loops kept in one page)
   311 				?pf_s   = * + :1
   312 				        .if >?pf_s <> >(?pf_s + :2)
   313 				        :($100 - <?pf_s) dta 0
   314 				        .endif
   315 				 .else
   316 				        ; (no pad)
   317 				 .endif
   318 				        .endm
   319
   320 				; Original blitter macros and fill pattern, kept for the .else paths
   321 				blit_start .macro
   322 				        ldy #VBXE_BL_ADR0
   323 				        lda #<:1
   324 				        sta (zp_vbxe_base),y
   325 				        iny
   326 				        lda #>:1
   327 				        sta (zp_vbxe_base),y
   328 				        iny
   329 				        lda #0
   330 				        sta (zp_vbxe_base),y
   331 				        iny
   332 				        lda #1
   333 				        sta (zp_vbxe_base),y
   334 				        .endm
   335
   336 				blit_wait .macro
   337 				        ldy #VBXE_BLITTER
   338 				?bw     lda (zp_vbxe_base),y
   339 				        bne ?bw
   340 				        .endm
   341
   342 				; Run the BCB list at VRAM :1 (bank 0) and wait for it (blit_run)
   343 				blit .macro
   344 				        lda #<(:1)
   345 				        ldx #>(:1)
   346 				        jsr blit_run
   347 				        .endm
