   209 				; ----------------------------------------------------------------------------
   210 				; render_do_nl - Internal: advance to next line
   211 				; When content area is full, pause for user input (pagination)
   212 				; ----------------------------------------------------------------------------
   213 5C66			.proc render_do_nl
   214 5C66 A5 BD		        lda skip_hf
   215 5C68 D0 20		        bne ?ok
   216 5C6A 85 93		        sta zp_render_col      ; A = 0
   217 5C6C 85 BF		        sta last_was_sp
   218
   219 5C6E E6 94		        inc zp_render_row
   220 5C70 A5 94		        lda zp_render_row
   221 5C72 C9 1B		        cmp #CONTENT_BOT+1
   222 5C74 90 14		        bcc ?ok
   223
   224 				        ; Page full - wait for user
   225 5C76 20 97 5C		        jsr render_page_pause
   226 5C79 B0 10		        bcs ?abort
   227
   228 				        ; User wants next page - clear content and reset
   229 5C7B 20 B7 34		        jsr ui_clear_content
   230 5C7E A9 02		        lda #CONTENT_TOP
   231 5C80 85 94		        sta zp_render_row
   232 5C82 A9 00		        lda #0
   233 5C84 85 98		        sta zp_link_num        ; reset links for new screen
   234 5C86 A9 FF		        lda #$FF
   235 5C88 85 BC		        sta zp_tab_link        ; clear TAB selection on scroll
   236 5C8A 60			?ok     rts
   237
   238 5C8B			?abort  ; User pressed Q - set abort flag; the parser loop ends at once
   239 				        ; because the chunk now "ends" at the current byte
   240 5C8B A9 01		        lda #1
   241 5C8D 8D 5C 5F		        sta page_abort
   242 5C90 C6 94		        dec zp_render_row
   243 5C92 A5 99		        lda chunk_idx
   244 5C94 85 A3		        sta zp_rx_len
   245 5C96 60			        rts
   246 				.endp
