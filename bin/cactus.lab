   859 				; sb_num - Append A (0-255) in decimal, no leading zeros
   860 3632			.proc sb_num
   861 3632 A2 2F		        ldx #'0'-1             ; X = digit char
   862 3634 C9 64		        cmp #100
   863 3636 90 0F		        bcc ?tens
   864 3638 E8			?h      inx
   865 3639 E9 64		        sbc #100
   866 363B B0 FB		        bcs ?h
   867 363D 69 64		        adc #100               ; C = 0: undo the last subtraction
   868 363F 20 5A 36		        jsr ?digit
   869 3642 A2 2F		        ldx #'0'-1
   870 3644 38			        sec
   871 3645 B0 04		        bcs ?t                 ; always: with hundreds, tens always print
   872 3647 C9 0A		?tens   cmp #10
   873 3649 90 0A		        bcc ?one
   874 364B E8			?t      inx
   875 364C E9 0A		        sbc #10
   876 364E B0 FB		        bcs ?t
   877 3650 69 0A		        adc #10                ; C = 0
   878 3652 20 5A 36		        jsr ?digit
   879 3655 09 30		?one    ora #'0'
   880 3657 4C 23 36		        jmp sb_char
   881 365A 48			?digit  pha                    ; print X, keep A
   882 365B 8A			        txa
   883 365C 20 23 36		        jsr sb_char
   884 365F 68			        pla
   885 3660 60			        rts
