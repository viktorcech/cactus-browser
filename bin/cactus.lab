    17
    18 				; ============================================================================
    19 				; Entry point
    20 				; ============================================================================
    21 				.proc main
    22 FFFF> 3000-4BFB> D8	        cld                    ; decimal mode is not reset by the OS
    23 3001 A9 00		        lda #0
    24 3003 8D 2F 02		        sta SDMCTL
    25 3006 78			        sei
    26
    27 				        ; PAL/NTSC detection (PAL=$01, NTSC=$0F)
    28 3007 AD 14 D0		        lda PAL
    29 300A C9 01		        cmp #$01
    30 300C F0 02		        beq ?pal
    31 300E A9 00		        lda #0               ; NTSC
    32 3010 8D 6B 30		?pal    sta is_pal
    33
    34 3013 20 8A 30		        jsr vbxe_detect
    35 3016 90 27		        bcc no_vbxe
    36 3018 20 6C 30		        jsr memac_patch        ; MEMAC B stores -> the detected register page
    37
    38 301B 20 A5 30		        jsr vbxe_init
    39 301E 58			        cli
    40
    41 301F 20 AF 5F		        jsr kbd_init
    42 3022 20 22 6C		        jsr mouse_init
    43 3025 20 6E 6B		        jsr history_init
    44 				 .if 1                          ; 2026-09-23 (settings saved on disk)
    45 3028 20 25 3E		        jsr bk_load
    46 302B 20 8F 41		        jsr set_load           ; proxy on/off from D1: sector 715
    47 				 .else
    48 				        jsr bk_load
    49 				 .endif
    50 302E A9 00		        lda #0
    51 3030 8D 26 BE		        sta cur_page_url       ; no page loaded yet (buffer is uninitialized)
    52 3033 20 CC 4B		        jsr html_reset
    53 3036 20 49 5B		        jsr render_reset
    54 3039 20 E9 6D		        jsr show_welcome
    55 303C 20 A3 60		        jsr ui_main_loop
    56 				        ; ui_main_loop never returns (Q goes to welcome screen)
    57 				        ; To exit browser, user presses Reset on Atari
    58
    59 303F 58			no_vbxe cli
    60 3040 A9 22		        lda #$22
    61 3042 8D 2F 02		        sta SDMCTL
    62 				        ; Show error message via E: device (CIO IOCB #0)
    63 3045 A2 00		        ldx #0               ; IOCB #0 = E: (editor)
    64 3047 A9 09		        lda #$09             ; PUT RECORD command
    65 3049 8D 42 03		        sta ICCOM
    66 304C A9 96		        lda #<msg_no_vbxe
    67 304E 8D 44 03		        sta ICBAL
    68 3051 A9 78		        lda #>msg_no_vbxe
    69 3053 8D 45 03		        sta ICBAH
    70 3056 A9 12		        lda #18              ; string length
    71 3058 8D 48 03		        sta ICBLL
    72 305B 8E 49 03		        stx ICBLH            ; X = 0
    73 305E 20 56 E4		        jsr CIOV
    74 				        ; Wait for keypress then cold start
    75 3061 AD FC 02		?wk     lda CH
    76 3064 C9 FF		        cmp #KEY_NONE
    77 3066 F0 F9		        beq ?wk
    78 3068 6C 77 E4		        jmp (COLDSV)
    79 				.endp
    80
    81 306B 01			is_pal  dta b(1)             ; 1=PAL, 0=NTSC (default PAL)
    82
    83
    84 				; show_welcome is in title.asm
    85
    86 				; ============================================================================
    87 				; Include all modules
    88 				; ============================================================================
    89 306C			        icl 'vbxe_detect.asm'
Source: vbxe_detect.asm
     1 				; ============================================================================
     2 				; VBXE Detection Module
     3 				; Base address must be $D600/$D700 (NOT $D640/$D740!)
     4 				; Registers are at offsets $40-$5F from base
     5 				; ============================================================================
     6
     7 				; ----------------------------------------------------------------------------
     8 				; memac_patch - VBXE at $D7xx: move every absolute MEMAC B store (assembled
     9 				; for $D6xx) to the detected register page
    10 				; ----------------------------------------------------------------------------
    11 306C			.proc memac_patch
    12 306C A5 81		        lda zp_vbxe_base+1
    13 306E C9 D6		        cmp #>VBXE_REGS
    14 3070 F0 17		        beq ?done
    15 				 .if 1                          ; 2026-09-23 (6502-loops-tables-smc: index counting up to zero)
    16 3072 A2 A4		        ldx #256-MEMAC_COUNT*2
    17 3074 BD 05 78		?lp     lda memac_sites+MEMAC_COUNT*2-256,x
    18 3077 8D 83 30		        sta ?st+1
    19 307A BD 06 78		        lda memac_sites+MEMAC_COUNT*2-256+1,x
    20 307D 8D 84 30		        sta ?st+2
    21 3080 A5 81		        lda zp_vbxe_base+1
    22 3082 8D FF FF		?st     sta $FFFF              ; (patched: operand high byte of one store)
    23 3085 E8			        inx
    24 3086 E8			        inx
    25 3087 D0 EB		        bne ?lp
    26 				 .else
    27 				        ldx #0
    28 				?lp     lda memac_sites,x
    29 				        sta ?st+1
    30 				        lda memac_sites+1,x
    31 				        sta ?st+2
    32 				        lda zp_vbxe_base+1
    33 				?st     sta $FFFF              ; (patched: operand high byte of one store)
    34 				        inx
    35 				        inx
    36 				        cpx #MEMAC_COUNT*2
    37 				        bne ?lp
    38 				 .endif
    39 3089 60			?done   rts
    40 				.endp
    41
    42 308A			.proc vbxe_detect
    43 				        ; Try $D600, then $D700 (registers at base+$40..$5F)
    44 308A A9 00		        lda #0
    45 308C 85 80		        sta zp_vbxe_base       ; both bases are page-aligned
    46 308E A2 D6		        ldx #>$D600
    47 3090 A0 40		        ldy #VBXE_CORE_VER     ; Y=$40 -> base+$40 = CORE_VERSION
    48 3092 86 81		?try    stx zp_vbxe_base+1
    49 3094 A9 00		        lda #0
    50 3096 91 80		        sta (zp_vbxe_base),y
    51 3098 B1 80		        lda (zp_vbxe_base),y   ; (a write-then-read of the register)
    52 309A C9 10		        cmp #FX_CORE_VER       ; $10 = FX core
    53 309C F0 06		        beq ?found             ; C = 1: found
    54 309E E8			        inx
    55 309F E0 D8		        cpx #>$D700+1
    56 30A1 D0 EF		        bne ?try
    57 30A3 18			        clc                    ; not found
    58 30A4 60			?found  rts
    59 				.endp
    90 30A5			        icl 'vbxe_init.asm'
