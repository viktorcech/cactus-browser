    74 				; ============================================================================
    75 				; Large buffers at $8800
    76 				; Memory map: code $2000-$2B00, MEMAC B window $4000-$7FFF (VRAM access),
    77 				; buffers $8800+, OS ROM $C000+. Buffers here are safe from MEMAC B corruption.
    78 				; ============================================================================
    79 8500			        org $8800
    80
    81 				; Large image transfer buffer for fast SIO reads (2KB)
    82 				; fn_read_img reads up to 2048 bytes per SIO call into this buffer,
    83 				; then vbxe_img_write_big copies it to VRAM. This reduces SIO overhead
    84 				; ~8x vs the standard 255-byte rx_buffer path.
    85 				; Page-aligned (the copy loops read it with abs,y); above $7FFF so it's accessible even when MEMAC B is active.
    86 = 0800			IMG_BIG_SIZE   = $0800         ; 2048 bytes
    87 = 8800			img_big_buf    .ds IMG_BIG_SIZE
    88 9000-9001> 00		img_chunk_lo   dta 0           ; 16-bit byte count (lo)
    89 9001 00			img_chunk_hi   dta 0           ; 16-bit byte count (hi)
    90
    91 = 9002			url_buffer     .ds URL_BUF_SIZE         ; 256 bytes
    92 9102-9103> 00 00		url_length     dta a(0)
    93
    94 				; History data area (16 * 130 = 2080 bytes)
    95 = 0820			HIST_DATA_SZ   = HIST_MAX * HIST_ENTRY_SZ
    96 = 9104			history_data   .ds HIST_DATA_SZ
    97
    98 				; Link URL storage (32 * 128 = 4096 bytes)
    99 = 2000			LINK_URLS_SZ   = MAX_LINKS * LINK_URL_SIZE
   100 = 9924			link_urls      .ds LINK_URLS_SZ
   101
   102 				; Base URL for relative link resolution (up to last '/')
   103 = B924			base_url       .ds URL_BUF_SIZE
   104
   105 				; URL backup for image fetch (url_buffer gets overwritten by converter URL)
   106 = BA24			url_save_buf   .ds URL_BUF_SIZE
   107 BB24-BB25> 00 00		url_save_len   dta a(0)
   108
   109 				; Image palette buffer (768 bytes = 256 colors * 3 bytes RGB)
   110 = BB26			img_pal_buf    .ds 768
   111
   112
   113 				; Current page URL (clean, pre-proxy, no N: prefix) — snapshot taken in
   114 				; http_navigate; used by bookmarks 'A' (add current page). Sized to fit
   115 				; a bookmark slot. [0]=0 means no page loaded (init in main).
   116 = BE26			cur_page_url   .ds BK_SLOT_SZ
   117 				        ert *>$C000
