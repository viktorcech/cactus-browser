   598 				; Title Screen Graphics - GMON gradient banner
   599 				; ============================================================================
   600
   601 = 3000			VRAM_GRADIENT  = VRAM_IMG_BASE   ; Reuses image VRAM space ($3000)
   602 = 0140			GRAD_BAND_W    = 320             ; Pixels per scanline (NORMAL mode)
   603 = 0004			GRAD_BANDS     = 4
   604 = 0008			GRAD_BAND_H    = 8              ; Scanlines per band
   605 = 001A			TITLE_TEXT_ROWS = (240 - GRAD_BANDS * GRAD_BAND_H) / 8  ; = 26
