    50 				; img_read_header - Read 3-byte image header from converter
    51 				; Format: [width_lo] [width_hi] [height]
    52 				; Validates: width 8-320, height 8-192 (rejects corrupt/empty streams)
    53 				; Error codes: 1=abort, 2=SIO, 3=EOF, 4=fatal, 5=disconnect, 6=timeout,
    54 				;              7=SIO read, 8=sanity check
