Source: mouse.asm
     1 				; ============================================================================
     2 				; Mouse Module - Atari ST mouse driver via joystick port
     3 				; Timer 2 IRQ for fast quadrature sampling (GOS-style lookup table)
     4 				; VBI for applying accumulated movement to text cursor
     5 				; Based on flashjazzcat's GOS mouse driver + PAD game + xlpaint
     6 				;
     7 				; MEMAC B safety: This module is above $4000 (in MEMAC B window).
     8 				; - The timer IRQ runs entirely from page 6 with its tables at $8300+
     9 				;   (outside the window), so it never touches MEMAC B
    10 				; - The VBI uses entry/exit stubs at page 6 to disable/restore MEMAC B
    11 				; - VRAM access uses vbxe_cell_get/vbxe_cell_put (below $4000)
    12 				; - NO memb_on/memb_off in this file!
    13 				; ============================================================================
    14
    15 = 0001			MOUSE_PORT2 = 1               ; 0=port 1, 1=port 2
    16
    17 = D010			STRIG0     = $D010             ; used when MOUSE_PORT2=0
    18 = D011			STRIG1     = $D011
    19 = E45C			SETVBV     = $E45C
    20 = E462			XITVBV     = $E462
    21
    22 = 0010			POKMSK     = $10               ; IRQ enable shadow
    23 = D20E			IRQEN      = $D20E
    24 = D202			AUDF2      = $D202
    25 = D203			AUDC2      = $D203
    26 = D208			AUDCTL     = $D208
    27 = D209			STIMER     = $D209
    28 = 0212			VTIMR2     = $0212             ; Timer 2 IRQ vector
    29
    30 				; Zero-page variables ($B0-$B7)
    31 = 00B0			zp_mouse_x    = $B0            ; text column 0-79
    32 = 00B1			zp_mouse_y    = $B1            ; text row 0-23
    33 = 00B2			zp_mouse_btn  = $B2            ; 0=none, 1=clicked
    34 = 00B3			zp_mouse_old  = $B3            ; last port nibble (timer IRQ)
    35 = 00B4			zp_mouse_dx   = $B4            ; accumulated X delta (signed, reset each VBI)
    36 = 00B5			zp_mouse_dy   = $B5            ; accumulated Y delta (signed, reset each VBI)
    37 = 00B6			zp_mouse_prev_x = $B6          ; previous cursor col
    38 = 00B7			zp_mouse_prev_y = $B7          ; previous cursor row
    39
    40 				; ----------------------------------------------------------------------------
    41 				; Page 6 stubs ($0600), copied from mouse_stubs by mouse_install_stubs:
    42 				;   Timer IRQ: the whole handler (OS saved A; it saves Y itself)
    43 				;   VBI entry: save shadow, disable MEMAC B, jmp mouse_vbi (OS saved A,X,Y)
    44 				;   VBI exit:  restore shadow + MEMAC B, jmp XITVBV
    45 				; Shadow save/restore keeps a VBI nested inside MEMAC B code safe.
    46 				; ----------------------------------------------------------------------------
    47 = 0600			STUB_BASE       = $0600
    48 = 062E			STUB_VBI_ENTRY  = STUB_BASE + mst_vbi_entry - mouse_stubs
    49 = 063E			STUB_VBI_EXIT   = STUB_BASE + mst_vbi_exit - mouse_stubs
    50
    51 				; ----------------------------------------------------------------------------
    52 				; mouse_init
    53 				; ----------------------------------------------------------------------------
    54 6C22			.proc mouse_init
    55 6C22 A9 28		        lda #40
    56 6C24 85 B0		        sta zp_mouse_x
    57 6C26 A9 0C		        lda #12
    58 6C28 85 B1		        sta zp_mouse_y
    59 6C2A A9 FF		        lda #$FF
    60 6C2C 85 B6		        sta zp_mouse_prev_x    ; $FF = invalid, skip first restore
    61 6C2E 85 B7		        sta zp_mouse_prev_y
    62 6C30 A9 00		        lda #0
    63 6C32 85 B2		        sta zp_mouse_btn
    64 6C34 85 B4		        sta zp_mouse_dx
    65 6C36 85 B5		        sta zp_mouse_dy
    66 6C38 85 AD		        sta zp_memb_shadow
    67 6C3A 85 AF		        sta zp_vbi_saved
    68
    69 				        ; Initial port nibble
    70 6C3C AD 00 D3		        lda PORTA
    71 				    .if MOUSE_PORT2
    72 6C3F 4A			        lsr
    73 6C40 4A			        lsr
    74 6C41 4A			        lsr
    75 6C42 4A			        lsr
    76 				    .else
    77 				        and #$0F
    78 				    .endif
    79 6C43 85 B3		        sta zp_mouse_old
    80
    81 				        ; Install all stubs at page 6
    82 6C45 20 76 6C		        jsr mouse_install_stubs
    83
    84 				        ; Install Timer 2 IRQ (the page 6 handler)
    85 6C48 78			        sei
    86 6C49 A9 00		        lda #<STUB_BASE
    87 6C4B 8D 12 02		        sta VTIMR2
    88 6C4E A9 06		        lda #>STUB_BASE
    89 6C50 8D 13 02		        sta VTIMR2+1
    90
    91 				        ; Enable Timer 2 IRQ (bit 1)
    92 6C53 A5 10		        lda POKMSK
    93 6C55 09 02		        ora #$02
    94 6C57 85 10		        sta POKMSK
    95 6C59 8D 0E D2		        sta IRQEN
    96
    97 				        ; Set timer frequency (64kHz / 65 ≈ 985 Hz)
    98 6C5C A9 00		        lda #0
    99 6C5E 8D 08 D2		        sta AUDCTL
   100 6C61 8D 03 D2		        sta AUDC2              ; no sound output
   101 6C64 A9 40		        lda #$40
   102 6C66 8D 02 D2		        sta AUDF2
   103 6C69 8D 09 D2		        sta STIMER
   104 6C6C 58			        cli
   105
   106 				        ; Install deferred VBI via entry stub
   107 6C6D A0 2E		        ldy #<STUB_VBI_ENTRY
   108 6C6F A2 06		        ldx #>STUB_VBI_ENTRY
   109 6C71 A9 07		        lda #7
   110 6C73 4C 5C E4		        jmp SETVBV
   111 				.endp
   112
   113 				; ----------------------------------------------------------------------------
   114 				; mouse_install_stubs - Copy the stubs to page 6 and patch the VBI jump
   115 				; ----------------------------------------------------------------------------
   116 6C76			.proc mouse_install_stubs
   117 6C76 A0 4A		        ldy #mst_end-mouse_stubs-1
   118 6C78 B9 8C 6C		?lp     lda mouse_stubs,y
   119 6C7B 99 00 06		        sta STUB_BASE,y
   120 6C7E 88			        dey
   121 6C7F 10 F7		        bpl ?lp
   122 6C81 A9 D7		        lda #<mouse_vbi
   123 6C83 8D 3C 06		        sta STUB_BASE+mst_vbi_jmp-mouse_stubs+1
   124 6C86 A9 6C		        lda #>mouse_vbi
   125 6C88 8D 3D 06		        sta STUB_BASE+mst_vbi_jmp-mouse_stubs+2
   126 6C8B 60			        rts
   127 				.endp
   128
   129 				; === Stub templates: position independent (relative branches only) ===
   130 				; Timer 2 IRQ, sampled at ~985 Hz: decode both quadrature axes with one
   131 				; table read. Reads only zero page, PORTA and the $8300+ tables, so it runs
   132 				; safely with the MEMAC B window open.
   133 6C8C			mouse_stubs
   134 6C8C 98			        tya
   135 6C8D 48			        pha
   136 6C8E AD 00 D3		        lda PORTA
   137 				    .if MOUSE_PORT2
   138 6C91 29 F0		        and #$F0               ; new nibble << 4
   139 				    .else
   140 				        asl
   141 				        asl
   142 				        asl
   143 				        asl
   144 				    .endif
   145 6C93 05 B3		        ora zp_mouse_old
   146 6C95 A8			        tay                    ; new<<4 | old
   147 6C96 B9 00 83		        lda mouse_tab,y
   148 6C99 D0 09		        bne mst_move
   149 6C9B B9 00 84		mst_back   lda mouse_nib,y        ; old = new
   150 6C9E 85 B3		        sta zp_mouse_old
   151 6CA0 68			        pla
   152 6CA1 A8			        tay
   153 6CA2 68			        pla                    ; A saved by the OS IRQ handler
   154 6CA3 40			        rti
   155 6CA4 4A			mst_move   lsr                    ; bit0: X+1
   156 6CA5 90 02		        bcc mst_m1
   157 6CA7 E6 B4		        inc zp_mouse_dx
   158 6CA9 4A			mst_m1     lsr                    ; bit1: X-1
   159 6CAA 90 02		        bcc mst_m2
   160 6CAC C6 B4		        dec zp_mouse_dx
   161 6CAE 4A			mst_m2     lsr                    ; bit2: Y+1
   162 6CAF 90 02		        bcc mst_m3
   163 6CB1 E6 B5		        inc zp_mouse_dy
   164 6CB3 4A			mst_m3     lsr                    ; bit3: Y-1
   165 6CB4 90 E5		        bcc mst_back
   166 6CB6 C6 B5		        dec zp_mouse_dy
   167 6CB8 B0 E1		        bcs mst_back              ; always (C = 1)
   168
   169 				        ; VBI entry: OS saved A,X,Y
   170 6CBA			mst_vbi_entry
   171 6CBA D8			        cld
   172 6CBB A5 AD		        lda zp_memb_shadow
   173 6CBD 85 AF		        sta zp_vbi_saved
   174 6CBF A9 00		        lda #0
   175 6CC1 85 AD		        sta zp_memb_shadow
   176 6CC3 A0 5D		        ldy #VBXE_MEMAC_B
   177 6CC5 91 80		        sta (zp_vbxe_base),y
   178 6CC7			mst_vbi_jmp
   179 6CC7 4C 00 00		        jmp $0000              ; patched: mouse_vbi
   180
   181 				        ; VBI exit: restore shadow + MEMAC B, JMP XITVBV (restores A,X,Y)
   182 6CCA			mst_vbi_exit
   183 6CCA A5 AF		        lda zp_vbi_saved
   184 6CCC 85 AD		        sta zp_memb_shadow
   185 6CCE F0 04		        beq mst_x                 ; was off: register already 0
   186 6CD0 A0 5D		        ldy #VBXE_MEMAC_B
   187 6CD2 91 80		        sta (zp_vbxe_base),y
   188 6CD4 4C 62 E4		mst_x      jmp XITVBV
   189 6CD7			mst_end
   190 				        ert mst_end-mouse_stubs>256
