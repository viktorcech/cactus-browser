   345 				; img_resolve_and_build_url - Resolve relative image URL and build converter URL
   346 				; Steps: 1) Copy img_src_buf → url_buffer, resolve via http_resolve_url
   347 				;        2) Strip N: prefix back to img_src_buf
   348 				;        3) Build: m_prefix + img_src_buf + m_suffix → url_buffer
   349 				; WARNING: Overwrites url_buffer! Caller must save/restore if needed
   350 				; ----------------------------------------------------------------------------
   351 6731			.proc img_resolve_and_build_url
   352 				        ; Copy img_src_buf to url_buffer for resolve
   353 6731 A0 00		        ldy #0
   354 6733 B9 16 57		?ri     lda img_src_buf,y
   355 6736 99 02 90		        sta url_buffer,y
   356 6739 F0 03		        beq ?rid
   357 673B C8			        iny
   358 673C D0 F5		        bne ?ri
   359 673E 8C 02 91		?rid    sty url_length
   360 6741 20 5E 47		        jsr http_resolve_url
   361 				        ; Strip N: prefix back to img_src_buf
   362 6744 A0 00		        ldy #0
   363 6746 AD 02 90		        lda url_buffer
   364 6749 C9 4E		        cmp #'N'
   365 674B D0 09		        bne ?nb
   366 674D AD 03 90		        lda url_buffer+1
   367 6750 C9 3A		        cmp #':'
   368 6752 D0 02		        bne ?nb
   369 6754 A0 02		        ldy #2
   370 6756 A2 00		?nb     ldx #0
   371 6758 B9 02 90		?rc     lda url_buffer,y
   372 675B 9D 16 57		        sta img_src_buf,x
   373 675E F0 0B		        beq ?rcd
   374 6760 C8			        iny
   375 6761 E8			        inx
   376 6762 E0 FF		        cpx #IMG_SRC_SIZE-1
   377 6764 D0 F2		        bne ?rc
   378 6766 A9 00		        lda #0
   379 6768 9D 16 57		        sta img_src_buf,x
   380 676B			?rcd
   381 				        ; Build: prefix + img_src_buf + suffix
   382 676B A0 00		        ldy #0
   383 676D B9 29 6B		?pfx    lda m_prefix,y
   384 6770 F0 06		        beq ?pfxd
   385 6772 99 02 90		        sta url_buffer,y
   386 6775 C8			        iny
   387 6776 D0 F5		        bne ?pfx
   388 6778 A2 00		?pfxd   ldx #0
   389 677A BD 16 57		?src    lda img_src_buf,x
   390 677D F0 09		        beq ?srcd
   391 677F 99 02 90		        sta url_buffer,y
   392 6782 C8			        iny
   393 6783 E8			        inx
   394 6784 C0 EC		        cpy #URL_BUF_SIZE-20
   395 6786 90 F2		        bcc ?src
   396 6788 A2 00		?srcd   ldx #0
   397 678A BD 56 6B		?sfx    lda m_suffix,x
   398 678D 99 02 90		        sta url_buffer,y
   399 6790 F0 04		        beq ?sfxd
   400 6792 C8			        iny
   401 6793 E8			        inx
   402 6794 D0 F4		        bne ?sfx
   403 6796 8C 02 91		?sfxd   sty url_length
   404 6799 60			        rts
   405 				.endp
