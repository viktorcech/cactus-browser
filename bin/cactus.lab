   562 				; img_save_url / img_restore_url - Save/restore url_buffer around image fetch
   563 				; (img_resolve_and_build_url overwrites url_buffer with converter URL)
   564 				; ----------------------------------------------------------------------------
   565 69C2			.proc img_save_url
   566 69C2 A0 00		        ldy #0
   567 69C4 B9 02 90		?lp     lda url_buffer,y
   568 69C7 99 24 BA		        sta url_save_buf,y
   569 69CA C8			        iny
   570 69CB D0 F7		        bne ?lp
   571 69CD AD 02 91		        lda url_length
   572 69D0 8D 24 BB		        sta url_save_len
   573 69D3 60			        rts
   574 				.endp
   575
   576 69D4			.proc img_restore_url
   577 69D4 A0 00		        ldy #0
   578 69D6 B9 24 BA		?lp     lda url_save_buf,y
   579 69D9 99 02 90		        sta url_buffer,y
   580 69DC C8			        iny
   581 69DD D0 F7		        bne ?lp
   582 69DF AD 24 BB		        lda url_save_len
   583 69E2 8D 02 91		        sta url_length
   584 69E5 60			        rts
   585 				.endp
