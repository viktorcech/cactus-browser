     1 				; ============================================================================
     2 				; Renderer Module - Word-wrap, attributes, link numbering
     3 				; ============================================================================
     4
     5 				; render_setpos - vbxe_setpos(zp_render_row, zp_render_col) inline: cursor
     6 				; and screen pointer set, X = row, A = pointer high byte (as calc_scr_ptr)
     7 				render_setpos .macro
     8 				        ldx zp_render_row      ; = vbxe_setpos + calc_scr_ptr: X = row,
     9 				        stx zp_cursor_row      ; A = pointer high byte as they leave them
    10 				        lda zp_render_col
    11 				        sta zp_cursor_col
    12 				        asl                    ; col <= 79: C = 0
    13 				        adc row_addr_lo,x
    14 				        sta zp_scr_ptr
    15 				        lda row_addr_hi,x
    16 				        adc #0
    17 				        sta zp_scr_ptr+1
    18 				        .endm
    19
