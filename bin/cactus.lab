   239 3B42 8D 38 3B		        sta pb_wr_bank
   240 3B45 A9 00		        lda #<MEMB_BASE
   241 3B47 85 B8		        sta zp_pb_wr_ptr
   242 3B49 A9 40		        lda #>MEMB_BASE
   243 3B4B 85 B9		        sta zp_pb_wr_ptr+1
   244 3B4D A9 00		        lda #0
   245 3B4F 8D 3A 3B		        sta pb_total
   246 3B52 8D 3B 3B		        sta pb_total+1
   247 3B55 8D 3C 3B		        sta pb_total+2
   248 3B58 60			        rts
   249 				.endp
