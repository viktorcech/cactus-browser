   699 				; Link URL storage
   700 				; ============================================================================
   701 = 0040			MAX_LINKS      = 64
   702 = 0080			LINK_URL_SIZE  = 128
   703
   704 				; ============================================================================
   705 				; calc_link_addr - Calculate address of link_urls[A]
   706 				; Input: A = link index (0-63)
   707 				; Output: zp_tmp_ptr = address of link_urls[A] (128-byte slot)
   708 				; ============================================================================
   709 5692			.proc calc_link_addr
   710 5692 4A			        lsr
   711 5693 AA			        tax
   712 5694 A9 00		        lda #0
   713 5696 6A			        ror                    ; A = (index & 1) << 7, C = 0
   714 5697 69 24		        adc #<link_urls
   715 5699 85 87		        sta zp_tmp_ptr
   716 569B 8A			        txa
   717 569C 69 99		        adc #>link_urls
   718 569E 85 88		        sta zp_tmp_ptr+1
   719 56A0 60			        rts
   720 				.endp
   721
   722 56A1			.proc store_link_url
   723 56A1 A5 98		        lda zp_link_num
   724 56A3 C9 40		        cmp #MAX_LINKS
   725 56A5 B0 15		        bcs ?full
   726 56A7 20 92 56		        jsr calc_link_addr     ; A = link_num still
   727
   728 56AA A0 00		        ldy #0
   729 56AC B9 BD 51		?cp     lda attr_val_buf,y
   730 56AF 91 87		        sta (zp_tmp_ptr),y
   731 56B1 F0 09		        beq ?ok
   732 56B3 C8			        iny
   733 56B4 C0 7F		        cpy #LINK_URL_SIZE-1
   734 56B6 D0 F4		        bne ?cp
   735 56B8 A9 00		        lda #0
   736 56BA 91 87		        sta (zp_tmp_ptr),y
   737 56BC			?ok     ; Do NOT increment zp_link_num here - open_link does it
   738 56BC 60			?full   rts
   739 				.endp
