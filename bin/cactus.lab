    71 5FE2 00			kgl_inv dta 0                  ; $80: kbd_get_line echoes inverse
    72
    73 5FE3			.proc kbd_get_line
    74 				 .if 1                          ; 2026-09-23 (one status bar for everything): echo through ?put (kgl_inv)
    75 5FE3 8E 5E 60		        stx kgl_max
    76 5FE6 A0 00		        ldy #0
    77 5FE8 8C 5F 60		        sty kgl_len
    78
    79 5FEB			?loop   ; Show cursor (putchar advances; cursor_back undoes the advance)
    80 5FEB A9 5F		        lda #'_'
    81 5FED 20 58 60		        jsr ?put
    82 5FF0 20 60 60		        jsr cursor_back
    83
    84 5FF3 20 D0 5F		        jsr kbd_get
    85
    86 				        ; Enter = confirm
    87 5FF6 C9 9B		        cmp #ATASCII_EOL
    88 5FF8 F0 41		        beq ?confirm
    89
    90 				        ; Escape = cancel
    91 5FFA C9 1B		        cmp #ATASCII_ESC
