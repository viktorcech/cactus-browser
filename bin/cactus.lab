   192 				; ----------------------------------------------------------------------------
   193 				; mouse_vbi - Deferred VBI: apply accumulated deltas to cursor position
   194 				; Exit via stub at page 6 (restores MEMAC B, JMP XITVBV)
   195 				;
   196 				; Speed handling (per axis, per frame):
   197 				; - Slow movement (|delta| < MOUSE_ACCEL): half speed, but the leftover
   198 				;   count is carried over to the next frame instead of being truncated.
   199 				;   The old code dropped it — a delta of 1 became 0, so slow precise
   200 				;   movements didn't move the cursor at all until you sped up.
   201 				; - Fast movement (|delta| >= MOUSE_ACCEL): full delta, no division —
   202 				;   2x faster sweeps (simple acceleration).
   203 				; ----------------------------------------------------------------------------
   204 = 0006			MOUSE_ACCEL = 6                ; counts/frame where acceleration kicks in
   205
   206 6CD7			.proc mouse_vbi
   207 				        ; --- Apply X delta (signed) ---
   208 6CD7 A5 B4		        lda zp_mouse_dx
   209 6CD9 F0 3D		        beq ?do_y
   210 6CDB 10 21		        bpl ?x_pos
   211
   212 				        ; Negative X = move left
   213 6CDD 49 FF		        eor #$FF
   214 6CDF 18			        clc
   215 6CE0 69 01		        adc #1                 ; A = abs(dx)
   216 6CE2 A2 00		        ldx #0
   217 6CE4 86 B4		        stx zp_mouse_dx        ; consume (leftover may be put back below)
   218 6CE6 C9 06		        cmp #MOUSE_ACCEL
   219 6CE8 B0 07		        bcs ?xn_go             ; fast: use full delta
   220 6CEA 4A			        lsr                    ; slow: half, C = leftover count
   221 6CEB 90 04		        bcc ?xn_go
   222 6CED A2 FF		        ldx #$FF
   223 6CEF 86 B4		        stx zp_mouse_dx        ; carry leftover (-1) to next frame
   224 6CF1 49 FF		?xn_go  eor #$FF                ; x - n = x + ~n + 1, clamped at the left edge
   225 6CF3 38			        sec
   226 6CF4 65 B0		        adc zp_mouse_x
   227 6CF6 B0 02		        bcs ?xl
   228 6CF8 A9 00		        lda #0
   229 6CFA 85 B0		?xl     sta zp_mouse_x
   230 6CFC 10 1A		        bpl ?do_y              ; always (x <= 79)
   231
   232 6CFE A2 00		?x_pos  ldx #0
   233 6D00 86 B4		        stx zp_mouse_dx        ; consume (leftover may be put back below)
   234 6D02 C9 06		        cmp #MOUSE_ACCEL
   235 6D04 B0 07		        bcs ?xp_go             ; fast: use full delta
   236 6D06 4A			        lsr                    ; slow: half, C = leftover count
   237 6D07 90 04		        bcc ?xp_go
   238 6D09 A2 01		        ldx #1
   239 6D0B 86 B4		        stx zp_mouse_dx        ; carry leftover (+1) to next frame
   240 6D0D 18			?xp_go  clc                    ; x + n, clamped at the right edge
   241 6D0E 65 B0		        adc zp_mouse_x         ; (<= 79 + 5 / 2: no overflow)
   242 6D10 C9 50		        cmp #SCR_COLS
   243 6D12 90 02		        bcc ?xr
   244 6D14 A9 4F		        lda #SCR_COLS-1
   245 6D16 85 B0		?xr     sta zp_mouse_x
   246
   247 				        ; --- Apply Y delta (signed) ---
   248 6D18 A5 B5		?do_y   lda zp_mouse_dy
   249 6D1A F0 3D		        beq ?btn
   250 6D1C 10 21		        bpl ?y_pos
   251
   252 6D1E 49 FF		        eor #$FF
   253 6D20 18			        clc
   254 6D21 69 01		        adc #1                 ; A = abs(dy)
   255 6D23 A2 00		        ldx #0
   256 6D25 86 B5		        stx zp_mouse_dy
   257 6D27 C9 06		        cmp #MOUSE_ACCEL
   258 6D29 B0 07		        bcs ?yn_go
   259 6D2B 4A			        lsr
   260 6D2C 90 04		        bcc ?yn_go
   261 6D2E A2 FF		        ldx #$FF
   262 6D30 86 B5		        stx zp_mouse_dy        ; carry leftover (-1)
   263 6D32 49 FF		?yn_go  eor #$FF                ; y - n, clamped at the top edge
   264 6D34 38			        sec
   265 6D35 65 B1		        adc zp_mouse_y
   266 6D37 B0 02		        bcs ?yu
   267 6D39 A9 00		        lda #0
   268 6D3B 85 B1		?yu     sta zp_mouse_y
   269 6D3D 10 1A		        bpl ?btn               ; always (y <= 28)
   270
   271 6D3F A2 00		?y_pos  ldx #0
   272 6D41 86 B5		        stx zp_mouse_dy
   273 6D43 C9 06		        cmp #MOUSE_ACCEL
   274 6D45 B0 07		        bcs ?yp_go
   275 6D47 4A			        lsr
   276 6D48 90 04		        bcc ?yp_go
   277 6D4A A2 01		        ldx #1
   278 6D4C 86 B5		        stx zp_mouse_dy        ; carry leftover (+1)
   279 6D4E 18			?yp_go  clc                    ; y + n, clamped at the bottom edge
   280 6D4F 65 B1		        adc zp_mouse_y
   281 6D51 C9 1D		        cmp #SCR_ROWS
   282 6D53 90 02		        bcc ?yd
   283 6D55 A9 1C		        lda #SCR_ROWS-1
   284 6D57 85 B1		?yd     sta zp_mouse_y
   285
   286 				        ; --- Button ---
   287 6D59			?btn
   288 				    .if MOUSE_PORT2
   289 6D59 AD 11 D0		        lda STRIG1
   290 				    .else
   291 				        lda STRIG0
   292 				    .endif
   293 6D5C D0 04		        bne ?no_btn
   294 6D5E A9 01		        lda #1
   295 6D60 85 B2		        sta zp_mouse_btn
   296 6D62			?no_btn
   297 				        ; Exit via stub at page 6 (restores MEMAC B, JMP XITVBV)
   298 6D62 4C 3E 06		        jmp STUB_VBI_EXIT
   299 				.endp
