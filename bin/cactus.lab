    49 				; VBXE VRAM Layout
    50 				; ----------------------------------------------------------------------------
    51 = 0000			VRAM_SCREEN    = $0000  ; Screen: SCR_ROWS*160 bytes (4800 for 30 rows)
    52 = 1300			VRAM_BCB       = $1300  ; BCB blocks (after screen)
    53 = 1380			VRAM_PATTERN   = $1380  ; (original) fill pattern, 2 bytes
    54 = 13C0			VRAM_GRAD      = $13C0  ; title gradient colours + BCB
    55 = 1400			VRAM_XDL       = $1400  ; XDL (up to 128 bytes)
    56 = 1480			VRAM_IMG_BCB   = $1480  ; image centring BCBs (img_fetch)
    57 				 .if 1                          ; 2026-09-23 (vbxe-blitter: 4 constant-fill BCBs, 84 bytes)
    58 = 14C0			VRAM_GRAD_BCB  = $14C0  ; title gradient BCBs (after the image BCBs)
    59 = 1514			VRAM_HLINE_BCB = VRAM_GRAD_BCB+4*21 ; vbxe_hline BCB pair (copied with the gradient)
    60 = 5514			MEMB_HLINE_BCB = MEMB_BASE+VRAM_HLINE_BCB
    61 				 .endif
    62 = 2000			VRAM_FONT      = $2000  ; Font: 256*8 = 2048 bytes
    63 = 0005			PAGE_BUF_BANK  = 5      ; VRAM $14000 >> 14 = 5
