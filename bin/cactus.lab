   410 				; ----------------------------------------------------------------------------
   411 				; blit_run - Run the BCB list at VRAM A/X (bank 0) and wait for it
   412 				; blit_go  - Start it and return at once ("fire early, wait late"): only
   413 				;            when the CPU does not touch the blit's destination next.
   414 				; A START while the blitter runs is ignored, so a blit started by blit_go
   415 				; is waited for (blit_pending) before the next START.
   416 				; BUSY can read 0 for an instant between chained BCBs: two reads.
   417 				; ----------------------------------------------------------------------------
   418 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: keep the BUSY poll loop in one page)
   419 344C			        page_fit blit_idle.wt-blit_run, blit_idle.wt_end-blit_idle.wt
Macro: PAGE_FIT [Source: vbxe_const.asm]
     2 = 346A			?pf_s   = * + BLIT_IDLE.WT-BLIT_RUN
Source: vbxe_text.asm
   420 				 .endif
   421 344C			.proc blit_run
   422 344C AC A0 34		        ldy blit_pending
   423 344F F0 05		        beq ?go
   424 3451 48			        pha                    ; a blit_go blit may still run
   425 3452 20 68 34		        jsr blit_idle
   426 3455 68			        pla
   427 3456 A0 50		?go     ldy #VBXE_BL_ADR0
   428 3458 91 80		        sta (zp_vbxe_base),y
   429 345A C8			        iny
   430 345B 8A			        txa
   431 345C 91 80		        sta (zp_vbxe_base),y
   432 345E C8			        iny
   433 345F A9 00		        lda #0
   434 3461 91 80		        sta (zp_vbxe_base),y
   435 3463 C8			        iny
   436 3464 A9 01		        lda #1
   437 3466 91 80		        sta (zp_vbxe_base),y   ; Y = VBXE_BLITTER: start
   438 				.endp
   439 				        ; fall through: wait for it
   440 3468			.proc blit_idle
   441 3468 A0 53		        ldy #VBXE_BLITTER
   442 346A			wt
   443 346A B1 80		?w      lda (zp_vbxe_base),y
   444 346C D0 FC		        bne ?w
   445 346E B1 80		        lda (zp_vbxe_base),y
   446 3470 D0 F8		        bne ?w
   447 3472			wt_end
   448 				        ert >wt <> >(wt_end-1)
   449 3472 8D A0 34		        sta blit_pending       ; A = 0: nothing running any more
   450 3475 60			        rts
   451 				.endp
   452
   453 3476			.proc blit_go
   454 3476 AC A0 34		        ldy blit_pending
   455 3479 F0 05		        beq ?go
   456 347B 48			        pha
   457 347C 20 68 34		        jsr blit_idle
   458 347F 68			        pla
   459 3480 20 8D 34		?go     jsr blit_kick
   460 3483 EE A0 34		        inc blit_pending       ; 0 -> 1: running, not waited for
   461 3486 60			        rts
   462 				.endp
   463
   464 				 .if 1                          ; 2026-09-23 (vbxe-blitter: fire early, wait late)
   465 				; blit_sync - Wait for a started blit, if any (before the CPU touches its cells)
   466 3487			.proc blit_sync
   467 3487 AC A0 34		        ldy blit_pending
   468 348A D0 DC		        bne blit_idle
   469 348C 60			        rts
   470 				.endp
   471 				 .endif
