    82 				; ----------------------------------------------------------------------------
    83 				; calc_hist_addr - Set zp_tmp_ptr to history_data + zp_hist_ptr * 130
    84 				; Table lookup instead of the old repeated-add loop (x130 per entry)
    85 				; ----------------------------------------------------------------------------
    86 6BC8			.proc calc_hist_addr
    87 6BC8 A6 A9		        ldx zp_hist_ptr
    88 6BCA BD D5 6B		        lda hist_addr_lo,x
    89 6BCD 85 87		        sta zp_tmp_ptr
    90 6BCF BD E5 6B		        lda hist_addr_hi,x
    91 6BD2 85 88		        sta zp_tmp_ptr+1
    92 6BD4 60			        rts
    93 				.endp
    94
    95 6BD5			hist_addr_lo
    96 6BD5 04 86 08 8A 0C 8E +         :HIST_MAX dta <(history_data + # * HIST_ENTRY_SZ)
    97 6BE5			hist_addr_hi
    98 6BE5 91 91 92 92 93 93 +         :HIST_MAX dta >(history_data + # * HIST_ENTRY_SZ)
    99
   100 				; ----------------------------------------------------------------------------
   101 				; history_shift - Shift entries down (discard oldest)
   102 				; ----------------------------------------------------------------------------
   103 6BF5			.proc history_shift
   104 6BF5 A2 01		        ldx #1
   105 6BF7 BD D5 6B		?lp     lda hist_addr_lo,x     ; source = entry X
   106 6BFA 85 89		        sta zp_tmp_ptr2
   107 6BFC BD E5 6B		        lda hist_addr_hi,x
   108 6BFF 85 8A		        sta zp_tmp_ptr2+1
   109 6C01 BD D4 6B		        lda hist_addr_lo-1,x   ; dest = entry X-1
   110 6C04 85 87		        sta zp_tmp_ptr
   111 6C06 BD E4 6B		        lda hist_addr_hi-1,x
   112 6C09 85 88		        sta zp_tmp_ptr+1
   113 				 .if 1                          ; 2026-09-23 (6502-idioms: count DOWN, dex/bne): Y = SZ-1..1 in the
   114 				                                ; loop, byte 0 after it; entries do not overlap, so order is free
   115 6C0B A0 81		        ldy #HIST_ENTRY_SZ-1
   116 6C0D B1 89		?cp     lda (zp_tmp_ptr2),y    ; 130 bytes (> 128: no dey/bpl)
   117 6C0F 91 87		        sta (zp_tmp_ptr),y
   118 6C11 88			        dey
   119 6C12 D0 F9		        bne ?cp
   120 6C14 B1 89		        lda (zp_tmp_ptr2),y    ; Y = 0
   121 6C16 91 87		        sta (zp_tmp_ptr),y
   122 				 .else
   123 				        ldy #0
   124 				?cp     lda (zp_tmp_ptr2),y    ; 130 bytes (> 128: no dey/bpl)
   125 				        sta (zp_tmp_ptr),y
   126 				        iny
   127 				        cpy #HIST_ENTRY_SZ
   128 				        bne ?cp
   129 				 .endif
   130 6C18 E8			        inx
   131 6C19 E0 10		        cpx #HIST_MAX
   132 6C1B D0 DA		        bne ?lp
   133 6C1D A2 0E		        ldx #HIST_MAX-2        ; zp_hist_ptr as the old per-entry loop left
   134 6C1F 86 A9		        stx zp_hist_ptr        ; it (history_push decrements it next)
   135 6C21 60			        rts
