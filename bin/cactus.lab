   226 				; ----------------------------------------------------------------------------
   227 				; cursor_back - Move cursor back one position (handles line wrap)
   228 				; When col=0, wraps to col=SCR_COLS-1 on previous row
   229 				; ----------------------------------------------------------------------------
   230 6060			.proc cursor_back
   231 6060 C6 83		        dec zp_cursor_col
   232 6062 10 09		        bpl ?dec               ; col was 1..79
   233 6064 A9 4F		        lda #SCR_COLS-1        ; col was 0: last column of the previous row
   234 6066 85 83		        sta zp_cursor_col
   235 6068 C6 82		        dec zp_cursor_row
   236 606A 4C D1 32		        jmp calc_scr_ptr       ; row changed, full recalc
   237 606D			?dec    ; Update cached screen pointer (back 2 bytes = 1 char+attr)
   238 606D A5 85		        lda zp_scr_ptr
   239 606F 38			        sec
   240 6070 E9 02		        sbc #2
   241 6072 85 85		        sta zp_scr_ptr
   242 6074 B0 02		        bcs ?ok
   243 6076 C6 86		        dec zp_scr_ptr+1
   244 6078 60			?ok     rts
   245 				.endp
