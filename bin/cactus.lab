    48 				; ----------------------------------------------------------------------------
    49 				; render_char - Process char for word-wrapped output
    50 				; Input: A = character
    51 				; last_was_sp is only read while zp_word_len = 0: a non-space char always
    52 				; leaves the word non-empty, so it no longer needs clearing here.
    53 				; ----------------------------------------------------------------------------
    54 5B79			.proc render_char
    55 5B79 AE 07 50		        ldx in_title
    56 5B7C D0 10		        bne ?title
    57 5B7E C9 20		        cmp #CH_SPACE
    58 5B80 F0 1A		        beq render_space
    59 5B82 A6 95		        ldx zp_word_len        ; non-space: add to word buffer
    60 5B84 E0 4F		        cpx #WORD_BUF_SZ-1
    61 5B86 B0 05		        bcs ?skip
    62 5B88 9D 80 82		        sta word_buf,x
    63 5B8B E6 95		        inc zp_word_len
    64 5B8D 60			?skip   rts
    65
    66 5B8E AE 5B 5F		?title  ldx title_len
    67 5B91 E0 4E		        cpx #78
    68 5B93 B0 F8		        bcs ?skip
    69 5B95 9D 5F 5F		        sta title_buf,x
    70 5B98 EE 5B 5F		        inc title_len
    71 5B9B 60			        rts
    72 				.endp
    73
    74 				; ----------------------------------------------------------------------------
    75 				; render_space - A space in word-wrapped text: flush the pending word and
    76 				; output one space (duplicate spaces collapse). The word and its space go
    77 				; out in one vbxe_put_word call.
    78 				; ----------------------------------------------------------------------------
    79 5B9C			.proc render_space
    80 5B9C A5 95		        lda zp_word_len
    81 5B9E D0 0B		        bne ?word
    82 5BA0 A5 BF		        lda last_was_sp        ; no word: a lone space, unless one just went
    83 5BA2 D0 51		        bne ?done
    84 5BA4 E6 BF		        inc last_was_sp        ; 0 -> 1
    85 5BA6 A9 20		        lda #CH_SPACE
    86 5BA8 4C 33 5C		        jmp render_out_char
    87
    88 5BAB 18			?word   clc                    ; does the word fit?
    89 5BAC 65 93		        adc zp_render_col
    90 5BAE C9 50		        cmp #SCR_COLS
    91 5BB0 90 06		        bcc ?fits
    92 5BB2 20 66 5C		        jsr render_do_nl
    93 5BB5 20 CC 5E		        jsr render_indent_out
    94 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: inline vbxe_setpos + calc_scr_ptr per
    95 				                                ; word: no jsr/jmp/rts, no reloads, -21 cycles a word)
    96 5BB8 A5 BD		?fits   lda skip_hf
    97 5BBA D0 31		        bne ?skip
    98 5BBC			        render_setpos
