Source: keyboard.asm
     1 				; ============================================================================
     2 				; Keyboard Input Module
     3 				; Uses Atari CIO K: device for proper ATASCII translation
     4 				; ============================================================================
     5
     6 				; CIO constants
     7 = E456			CIOV    = $E456
     8 = 0342			ICCOM   = $0342         ; Command byte (base for IOCB#0)
     9 = 0344			ICBAL   = $0344         ; Buffer address low
    10 = 0345			ICBAH   = $0345         ; Buffer address high
    11 = 0348			ICBLL   = $0348         ; Buffer length low
    12 = 0349			ICBLH   = $0349         ; Buffer length high
    13 = 034A			ICAX1   = $034A         ; Aux 1
    14 = 034B			ICAX2   = $034B         ; Aux 2
    15
    16 = 0003			CIO_OPEN   = $03
    17 = 0007			CIO_GET    = $07
    18
    19 				; IOCB #1 offset (for K: device)
    20 = 0010			KIOCB   = $10
    21
    22 				; ATASCII codes
    23 = 009B			ATASCII_EOL = $9B       ; Return/Enter
    24 = 001B			ATASCII_ESC = $1B       ; Escape
    25 = 007E			ATASCII_BS  = $7E       ; Backspace/Delete
    26 = 0020			ATASCII_SP  = $20       ; Space
