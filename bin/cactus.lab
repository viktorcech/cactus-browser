   754 				; ----------------------------------------------------------------------------
   755 				; status_msg_sub - Show message on status bar (subroutine for status_msg macro)
   756 				; Input: Y=color, A=msg_lo, X=msg_hi
   757 				; ----------------------------------------------------------------------------
   758 				 .if 1                          ; 2026-09-23 (one status bar for everything: an inverse bar in the
   759 				                                ; message's colour, drawn by the blitter; keys right-aligned)
   760 				; ----------------------------------------------------------------------------
   761 				; status_msg_sub - THE status bar. Every status line goes through here.
   762 				; Row STATUS_ROW becomes an inverse bar in colour Y; message A/X is
   763 				; "left text [, 1, keys], 0" -- the keys are shown right-aligned. The
   764 				; cursor stays after the left text: sb_text / sb_char / sb_num append
   765 				; to it in the bar's colour.
   766 				; ----------------------------------------------------------------------------
   767 357F			.proc status_msg_sub
   768 357F 8D A1 35		        sta ?f+1
   769 3582 8D BC 35		        sta ?m+1
   770 3585 8E A2 35		        stx ?f+2
   771 3588 8E BD 35		        stx ?m+2
   772 358B 8C 61 36		        sty sb_attr
   773 358E 84 84		        sty zp_cur_attr
   774 3590 A9 1B		        lda #STATUS_ROW
   775 3592 A2 00		        ldx #0
   776 3594 20 E3 32		        jsr vbxe_setpos
   777 3597 A9 A0		        lda #$A0               ; inverse space: the bar (blitter fill)
   778 3599 A2 50		        ldx #SCR_COLS
   779 359B 20 F4 34		        jsr vbxe_hline
   780 359E A0 00		        ldy #0                 ; find the end of the left text
   781 35A0 B9 FF FF		?f      lda $FFFF,y
   782 35A3 C9 02		        cmp #2                 ; 0 = no keys, 1 = keys follow
   783 35A5 90 03		        bcc ?sep
   784 35A7 C8			        iny
   785 35A8 D0 F6		        bne ?f                 ; always (< 80)
   786 35AA 8C EC 35		?sep    sty ?n                 ; fire early, wait late: the text goes over
   787 35AD AA			        tax                    ; the bar's cells (blit_sync uses Y)
   788 35AE 20 87 34		        jsr blit_sync
   789 35B1 8A			        txa
   790 35B2 AC EC 35		        ldy ?n
   791 35B5 4A			        lsr                    ; A = 1: C = 1
   792 35B6 90 24		        bcc ?left
   793 35B8 A2 00		        ldx #0                 ; keys -> print_buf, inverted
   794 35BA C8			?rl     iny
   795 35BB B9 FF FF		?m      lda $FFFF,y
   796 35BE F0 08		        beq ?rd
   797 35C0 09 80		        ora #$80
   798 35C2 9D 00 82		        sta print_buf,x
   799 35C5 E8			        inx
   800 35C6 D0 F2		        bne ?rl                ; always (< 80)
   801 35C8 8E EC 35		?rd     stx ?n
   802 35CB A9 4F		        lda #SCR_COLS-1        ; right-aligned, one bar cell before the edge;
   803 35CD ED EC 35		        sbc ?n                 ; C = 1: lsr of A = 1 above, nothing since changed it
   804 35D0 AA			        tax
   805 35D1 A9 1B		        lda #STATUS_ROW
   806 35D3 20 E3 32		        jsr vbxe_setpos
   807 35D6 AE EC 35		        ldx ?n
   808 35D9 20 08 36		        jsr sb_emit
   809 35DC A9 1B		?left   lda #STATUS_ROW
   810 35DE A2 00		        ldx #0
   811 35E0 20 E3 32		        jsr vbxe_setpos
   812 35E3 AD A1 35		        lda ?f+1
   813 35E6 AE A2 35		        ldx ?f+2
   814 35E9 4C ED 35		        jmp sb_text            ; the left text (sb_text stops at 0 or 1)
   815 35EC 00			?n      dta 0
   816 				.endp
   817
   818 				; sb_text - Append string A/X (ends at 0 or 1) to the status bar: one
   819 				; inverting copy straight into print_buf, then vbxe_emit
   820 35ED			.proc sb_text
   821 35ED 8D F6 35		        sta ?s+1
   822 35F0 8E F7 35		        stx ?s+2
   823 35F3 A2 00		        ldx #0
