   290 				; ui_box - Frame at row/col, w x h (w, h >= 3), attr in zp_cur_attr
   291 7103			.proc ui_box
   292 7103 AD 7F 71		        lda row
   293 7106 8D 83 71		        sta ?r
   294 7109 AE 80 71		        ldx col
   295 710C 20 E3 32		        jsr vbxe_setpos
   296 710F AE 81 71		        ldx w
   297 7112 CA			        dex
   298 7113 CA			        dex
   299 7114 8E 85 71		        stx ?in
   300 7117 A9 11		        lda #$11               ; top left
   301 7119 20 EA 32		        jsr vbxe_putchar
   302 711C A9 12		        lda #$12
   303 711E AE 85 71		        ldx ?in
   304 7121 20 F4 34		        jsr vbxe_hline
   305 7124 A9 05		        lda #$05               ; top right
   306 7126 20 EA 32		        jsr vbxe_putchar
   307 7129 AD 80 71		        lda col                ; right column = col + w - 1:
   308 712C 18			        clc                    ; col + w <= 80 leaves C = 0, and that
   309 712D 6D 81 71		        adc w                  ; clear carry is the -1 of the sbc
   310 7130 E9 00		        sbc #0
   311 7132 8D 84 71		        sta ?rc
   312 7135 AE 82 71		        ldx h
   313 7138 CA			        dex
   314 7139 CA			        dex
   315 713A 8E 86 71		        stx ?cnt
   316 713D EE 83 71		?side   inc ?r
   317 7140 AD 83 71		        lda ?r
   318 7143 AE 80 71		        ldx col
   319 7146 20 E3 32		        jsr vbxe_setpos
   320 7149 A9 7C		        lda #$7C
   321 714B 20 EA 32		        jsr vbxe_putchar
   322 714E AD 83 71		        lda ?r
   323 7151 AE 84 71		        ldx ?rc
   324 7154 20 E3 32		        jsr vbxe_setpos
   325 7157 A9 7C		        lda #$7C
   326 7159 20 EA 32		        jsr vbxe_putchar
   327 715C CE 86 71		        dec ?cnt
   328 715F D0 DC		        bne ?side
   329 7161 EE 83 71		        inc ?r
   330 7164 AD 83 71		        lda ?r
   331 7167 AE 80 71		        ldx col
   332 716A 20 E3 32		        jsr vbxe_setpos
   333 716D A9 1A		        lda #$1A               ; bottom left
   334 716F 20 EA 32		        jsr vbxe_putchar
   335 7172 A9 12		        lda #$12
   336 7174 AE 85 71		        ldx ?in
   337 7177 20 F4 34		        jsr vbxe_hline
   338 717A A9 03		        lda #$03               ; bottom right
   339 717C 4C EA 32		        jmp vbxe_putchar
   340 717F 00			row     dta 0
   341 7180 00			col     dta 0
   342 7181 00			w       dta 0
   343 7182 00			h       dta 0
   344 7183 00			?r      dta 0
   345 7184 00			?rc     dta 0
   346 7185 00			?in     dta 0
   347 7186 00			?cnt    dta 0
   348 				.endp
