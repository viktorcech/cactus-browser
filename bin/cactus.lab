   338 				; ----------------------------------------------------------------------------
   339 				; ext_in_table - Is ext_buf in the NUL-separated list at A/X (ends with 0)?
   340 				; Output: C=1 found, C=0 not
   341 				; ----------------------------------------------------------------------------
   342 				 .if 1                          ; 2026-09-23 (6502-cycles-layout: the compare/skip loops in one page)
   343 484A			        page_fit ext_in_table.et_s-ext_in_table, ext_in_table.et_e-ext_in_table.et_s
Macro: PAGE_FIT [Source: vbxe_const.asm]
     2 = 485E			?pf_s   = * + EXT_IN_TABLE.ET_S-EXT_IN_TABLE
Source: url.asm
   344 				 .endif
   345 484A			.proc ext_in_table
   346 484A 8D 61 48		        sta ?t+1
   347 484D 8E 62 48		        stx ?t+2
   348 4850 8D 78 48		        sta ?t2+1
   349 4853 8E 79 48		        stx ?t2+2
   350 4856 8D 7E 48		        sta ?t3+1
   351 4859 8E 7F 48		        stx ?t3+2
   352 485C A2 00		        ldx #0
   353 485E			et_s
   354 485E A0 00		?entry  ldy #0
   355 4860			?cmp
   356 4860 BD FF FF		?t      lda $FFFF,x            ; (table patched)
   357 4863 F0 09		        beq ?endt              ; entry ended
   358 4865 D9 50 05		        cmp ext_buf,y
   359 4868 D0 0C		        bne ?skip
   360 486A E8			        inx
   361 486B C8			        iny
   362 486C D0 F2		        bne ?cmp               ; always
   363 486E B9 50 05		?endt   lda ext_buf,y          ; entry ended: match if the extension did too
   364 4871 F0 11		        beq ?yes
   365 4873 E8			        inx                    ; past the entry's NUL
   366 4874 D0 07		        bne ?more              ; always
   367 4876 E8			?skip   inx                    ; skip the rest of this entry
   368 4877 BD FF FF		?t2     lda $FFFF,x            ; (table patched)
   369 487A D0 FA		        bne ?skip
   370 487C E8			        inx
   371 487D			?more
   372 487D BD FF FF		?t3     lda $FFFF,x            ; next entry, or 0 = end of list (patched)
   373 4880 D0 DC		        bne ?entry
   374 4882			et_e
   375 4882 18			        clc
   376 4883 60			        rts
   377 4884 38			?yes    sec
   378 4885 60			        rts
   379 				.endp
