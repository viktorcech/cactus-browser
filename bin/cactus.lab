   246 				; ----------------------------------------------------------------------------
   247 				; http_render - Render HTML from VRAM page buffer (Phase 2)
   248 				; Two-phase architecture:
   249 				;   Phase 1 (http_download): network → rx_buffer → VRAM page buffer
   250 				;   Phase 2 (http_render):   VRAM page buffer → rx_buffer → html parser
   251 				; N1: is closed during Phase 2 — free for image fetches via img_fetch_single
   252 				; Input: pb_total set by http_download (24-bit byte count in VRAM)
   253 				; Reads 255-byte chunks from VRAM, feeds to html_process_chunk
   254 				; Saves VRAM read position before each chunk for rewind after img_fetch
   255 				; ----------------------------------------------------------------------------
   256 450A			.proc http_render
   257 450A 20 59 3B		        jsr vbxe_pb_init_read
   258
   259 450D			?loop   ; remaining = pb_total - pb_read (24-bit): 0 = done,
   260 				        ; chunk size = min(255, remaining)
   261 450D AD 3A 3B		        lda pb_total
   262 4510 38			        sec
   263 4511 ED 3D 3B		        sbc pb_read
   264 4514 A8			        tay                    ; Y = low byte of remaining
   265 4515 AD 3B 3B		        lda pb_total+1
   266 4518 ED 3E 3B		        sbc pb_read+1
   267 451B AA			        tax                    ; X = middle byte
   268 451C AD 3C 3B		        lda pb_total+2
   269 451F ED 3F 3B		        sbc pb_read+2
   270 4522 D0 08		        bne ?full              ; remaining > 255 -> cap at 255
   271 4524 8A			        txa
   272 4525 D0 05		        bne ?full
   273 4527 98			        tya                    ; exact remaining count
   274 4528 F0 38		        beq ?done              ; all read
   275 452A D0 02		        bne ?read              ; always
   276 452C A9 FF		?full   lda #255               ; cap at 255
   277
   278 452E			?read   ; Save VRAM read state before chunk (for rewind after img_fetch)
   279 452E 8D 65 45		        sta pb_chunk_size
   280 4531 AA			        tax
   281 4532 AD 39 3B		        lda pb_rd_bank
   282 4535 8D 66 45		        sta pb_rd_save_bank
   283 4538 A5 BA		        lda zp_pb_rd_ptr
   284 453A 8D 67 45		        sta pb_rd_save_lo
   285 453D A5 BB		        lda zp_pb_rd_ptr+1
   286 453F 8D 68 45		        sta pb_rd_save_hi
   287
   288 4542 8A			        txa                    ; = pb_chunk_size
   289 4543 20 12 3C		        jsr vbxe_pb_read_chunk ; A→rx_buffer, sets zp_rx_len
   290 4546 20 00 4C		        jsr html_process_chunk
   291
   292 				        ; Update 24-bit read counter (use saved chunk size, not zp_rx_len
   293 				        ; which may have been reset to 0 by img_fetch during render)
   294 4549 18			        clc
   295 454A AD 3D 3B		        lda pb_read
   296 454D 6D 65 45		        adc pb_chunk_size
   297 4550 8D 3D 3B		        sta pb_read
   298 4553 90 08		        bcc ?nc1
   299 4555 EE 3E 3B		        inc pb_read+1
   300 4558 D0 03		        bne ?nc1
   301 455A EE 3F 3B		        inc pb_read+2
   302 455D			?nc1
   303 455D AD 5C 5F		        lda page_abort
   304 4560 F0 AB		        jeq ?loop
   305
   306 4562 4C F6 5B		?done   jmp html_flush
   307
   308 4565 00			pb_chunk_size    dta b(0)       ; bytes in current chunk (for 24-bit read counter)
   309 4566 00			pb_rd_save_bank  dta b(0)       ; VRAM read state saved before each chunk
   310 4567 00			pb_rd_save_lo    dta b(0)       ; (allows rewind after img_fetch destroys rx_buffer)
   311 4568 00			pb_rd_save_hi    dta b(0)
