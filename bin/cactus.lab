   222 				; ============================================================================
   223 				; Page Buffer - VRAM storage for downloaded HTML pages
   224 				; Download entire page to VRAM, then render from VRAM (N1: free for images)
   225 				; ALL page buffer code MUST be below $4000 (uses MEMAC B)
   226 				; ============================================================================
   227
   228 				; Page buffer state variables
   229 3B38 00			pb_wr_bank     dta b(0)        ; MEMAC B bank for writing
   230 3B39 00			pb_rd_bank     dta b(0)        ; MEMAC B bank for reading
   231 3B3A 00 00 00		pb_total       dta b(0),b(0),b(0)   ; 24-bit total bytes buffered
   232 3B3D 00 00 00		pb_read        dta b(0),b(0),b(0)   ; 24-bit bytes read so far
   233
   234 				; ----------------------------------------------------------------------------
   235 				; vbxe_pb_init_write - Initialize page buffer write pointer
