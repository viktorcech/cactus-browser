   394 4894 70 6E 67 00		        dta c'png',0
   395 4898 6A 70 67 00		        dta c'jpg',0
   396 489C 6A 70 65 67 00	        dta c'jpeg',0
   397 48A1 67 69 66 00		        dta c'gif',0
   398 48A5 00			        dta b(0)
   399 				.endp
