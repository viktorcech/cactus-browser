   482 				; ----------------------------------------------------------------------------
   483 				; bk_draw_row - Draw one slot row. Input: X = slot index (0..BK_SLOTS-1)
   484 				; ----------------------------------------------------------------------------
   485 410A			.proc bk_draw_row
   486 410A 8E 85 41		        stx ?i
   487 410D 8A			        txa
   488 410E 18			        clc
   489 410F 69 03		        adc #CONTENT_TOP+1
   490 4111 8D 86 41		        sta ?row
   491 4114 20 BF 34		        jsr vbxe_clear_row
   492 4117 AD 86 41		        lda ?row
   493 411A A2 04		        ldx #4
   494 411C 20 E3 32		        jsr vbxe_setpos
   495
   496 				        ; Selected row: yellow + ">" cursor, else normal + " "
   497 411F AD 24 3E		        lda bk_sel
   498 4122 CD 85 41		        cmp ?i
   499 4125 D0 08		        bne ?nor
   500 4127 A9 07		        lda #COL_YELLOW
   501 4129 85 84		        sta zp_cur_attr
   502 412B A9 3E		        lda #'>'
   503 412D D0 06		        bne ?cwr                    ; always
   504 412F A9 01		?nor    lda #ATTR_NORMAL
   505 4131 85 84		        sta zp_cur_attr
   506 4133 A9 20		        lda #' '
   507 4135 20 EA 32		?cwr    jsr vbxe_putchar
   508 4138 A9 20		        lda #' '
   509 413A 20 EA 32		        jsr vbxe_putchar
   510
   511 				        ; Slot number label: " 1.".." 9." for slots 0-8, "10." for slot 9
   512 413D AE 85 41		        ldx ?i
   513 4140 E8			        inx                         ; 1..10
   514 4141 8A			        txa
   515 4142 C9 0A		        cmp #10
   516 4144 D0 0A		        bne ?sng
   517 				        ; "10"
   518 4146 A9 31		        lda #'1'
   519 4148 20 EA 32		        jsr vbxe_putchar
   520 414B A9 30		        lda #'0'
   521 414D 4C 5A 41		        jmp ?lbl_dot
   522 4150			?sng    ; " N"
   523 4150 48			        pha
   524 4151 A9 20		        lda #' '
   525 4153 20 EA 32		        jsr vbxe_putchar
   526 4156 68			        pla
   527 4157 18			        clc
   528 4158 69 30		        adc #'0'
   529 415A 20 EA 32		?lbl_dot jsr vbxe_putchar
   530 415D A9 2E		        lda #'.'
   531 415F 20 EA 32		        jsr vbxe_putchar
   532 4162 A9 20		        lda #' '
   533 4164 20 EA 32		        jsr vbxe_putchar
   534
   535 4167 AE 85 41		        ldx ?i
   536 416A 20 CE 3D		        jsr bk_slot_addr
   537 416D A0 00		        ldy #0
   538 416F B1 87		        lda (zp_tmp_ptr),y
   539 4171 D0 06		        bne ?url
   540 4173 A9 87		        lda #<m_emp
   541 4175 A2 41		        ldx #>m_emp
   542 4177 D0 04		        bne ?prt                    ; always (hi byte != 0)
   543 4179 A5 87		?url    lda zp_tmp_ptr
   544 417B A6 88		        ldx zp_tmp_ptr+1
   545 417D 20 0E 34		?prt    jsr vbxe_print
   546 4180 A9 01		        lda #ATTR_NORMAL
   547 4182 85 84		        sta zp_cur_attr
   548 4184 60			        rts
   549 4185 00			?i      dta 0
   550 4186 00			?row    dta 0
   551 4187 28 65 6D 70 74 79 + m_emp   dta c'(empty)',0
   552 				.endp
